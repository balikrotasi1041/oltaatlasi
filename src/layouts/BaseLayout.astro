---
import "../styles/global.css";
import "../styles/world.css";

const {
  title = "Olta Atlası",
  description = "Mera, balık, yem, yöntem ve saha hazırlığı rehberi.",
  image = "/images/site/og-default.svg",
  canonical,
  type = "website",
  publishedAt,
  modifiedAt,
  noindex = false,
} = Astro.props;

const pageUrl = canonical || new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
const fullTitle = title === "Olta Atlası" ? title : `${title} | Olta Atlası`;
const currentPath = Astro.url.pathname;
const homeUrl = new URL("/", Astro.site).href;

const navigation = [
  { href: "/meralar/", label: "Meralar", match: "/meralar/" },
  { href: "/baliklar/", label: "Balıklar", match: "/baliklar/" },
  { href: "/rehberler/", label: "Rehberler", match: "/rehberler/" },
  { href: "/dunyada-balikcilik/", label: "Dünya", match: "/dunyada-balikcilik/" },
  { href: "/hakkinda/", label: "Hakkımızda", match: "/hakkinda/" },
];
const isActive = (match: string) => currentPath.startsWith(match);

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${homeUrl}#organization`,
  name: "Olta Atlası",
  url: homeUrl,
  logo: new URL("/logo-mark.svg", Astro.site).href,
  email: "mailto:balikrotasi1041@gmail.com",
  description: "Türkiye'deki kıyı ve iç su rotalarını balık türleri, ulaşım, saha güvenliği ve doğrulama notlarıyla açıklayan bağımsız bilgi rehberi.",
};
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${homeUrl}#website`,
  url: homeUrl,
  name: "Olta Atlası",
  publisher: { "@id": `${homeUrl}#organization` },
  inLanguage: "tr-TR",
};
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a3340" />
    <meta name="application-name" content="Olta Atlası" />
    <meta name="description" content={description} />
    <meta name="author" content="Olta Atlası Editörlüğü" />
    <meta name="robots" content={noindex ? "noindex,nofollow" : "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"} />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/svg+xml" href="/logo-mark.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://unpkg.com" crossorigin="anonymous" />
    <link rel="preconnect" href="https://tile.openstreetmap.org" crossorigin="anonymous" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:type" content={type === "article" ? "article" : "website"} />
    <meta property="og:site_name" content="Olta Atlası" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={`${title} için Olta Atlası görseli`} />
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}
    {modifiedAt && <meta property="article:modified_time" content={modifiedAt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <title>{fullTitle}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  </head>
  <body>
    <a class="skip-link" href="#icerik">İçeriğe geç</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="Olta Atlası ana sayfa">
          <img class="brand-mark" src="/logo-mark.svg" alt="" width="48" height="48" />
          <span><strong>Olta Atlası</strong><small>Mera, tür ve saha rehberi</small></span>
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-navigation" aria-label="Ana menüyü aç">
          <span>Menü</span><span class="menu-toggle-icon" aria-hidden="true">☰</span>
        </button>
        <nav class="main-nav" id="main-navigation" aria-label="Ana menü" data-open="false">
          {navigation.map((item) => (
            <a href={item.href} class:list={{ "is-active": isActive(item.match) }} aria-current={isActive(item.match) ? "page" : undefined}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main id="icerik"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div><strong>Olta Atlası</strong><p>Mera, tür, yöntem, navigasyon ve saha güvenliğini aynı rotada buluşturan bağımsız balıkçılık rehberi.</p></div>
        <div><strong>Editörlük ilkesi</strong><p>Bilgiler kaynak, son kontrol tarihi ve güven seviyesiyle sunulur. Raporlanan türler av garantisi değildir.</p></div>
        <div><strong>Bağlantılar</strong><p><a href="/iller/">İl rehberleri</a><br /><a href="/yazilar/">Tüm yazılar</a><br /><a href="/gizlilik/">Gizlilik ve çerezler</a><br /><a href="/gorsel-kaynaklari/">Görsel kaynakları</a><br /><a href="/iletisim/">Hata bildir / İletişim</a></p></div>
      </div>
      <div class="container footer-bottom">© {new Date().getFullYear()} Olta Atlası · Doğayı bulduğundan temiz bırak.</div>
    </footer>
    <aside class="consent-banner" id="consent-banner" hidden aria-label="Analitik tercihleri" aria-live="polite"><div><strong>Analitik tercihi</strong><p>Siteyi geliştirmek için Google Analytics kullanıyoruz. İzin vermeden analitik etiketi yüklenmez. Harita açıldığında OpenStreetMap karo sunucularına bağlantı kurulur.</p><a href="/gizlilik/">Ayrıntıları oku</a></div><div class="consent-actions"><button class="button button-small" id="consent-accept" type="button">Analitiğe izin ver</button><button class="button button-small button-ghost consent-reject" id="consent-reject" type="button">Yalnızca gerekli</button></div></aside>
    <script is:inline>
      const toggle = document.querySelector(".menu-toggle");
      const navigation = document.querySelector("#main-navigation");
      const closeMenu = () => { if (!toggle || !navigation) return; toggle.setAttribute("aria-expanded", "false"); toggle.setAttribute("aria-label", "Ana menüyü aç"); navigation.dataset.open = "false"; };
      toggle?.addEventListener("click", () => { const willOpen = toggle.getAttribute("aria-expanded") !== "true"; toggle.setAttribute("aria-expanded", String(willOpen)); toggle.setAttribute("aria-label", willOpen ? "Ana menüyü kapat" : "Ana menüyü aç"); navigation.dataset.open = String(willOpen); });
      navigation?.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));
      document.addEventListener("keydown", (event) => { if (event.key === "Escape") closeMenu(); });
      document.addEventListener("click", (event) => { if (!toggle || !navigation || navigation.dataset.open !== "true") return; const target = event.target; if (target instanceof Node && !navigation.contains(target) && !toggle.contains(target)) closeMenu(); });

      const consentKey="oltaatlasi-analytics-consent";
      const consentBanner=document.querySelector("#consent-banner");
      let analyticsLoaded=false;
      const loadAnalytics=()=>{if(analyticsLoaded)return;analyticsLoaded=true;const script=document.createElement("script");script.async=true;script.src="https://www.googletagmanager.com/gtag/js?id=G-K3ZLC335GP";document.head.appendChild(script);window.dataLayer=window.dataLayer||[];window.gtag=function(){window.dataLayer.push(arguments);};window.gtag("js",new Date());window.gtag("config","G-K3ZLC335GP",{anonymize_ip:true});};
      const savedConsent=localStorage.getItem(consentKey);
      if(savedConsent==="granted")loadAnalytics();else if(!savedConsent)consentBanner.hidden=false;
      document.querySelector("#consent-accept")?.addEventListener("click",()=>{localStorage.setItem(consentKey,"granted");consentBanner.hidden=true;loadAnalytics();});
      document.querySelector("#consent-reject")?.addEventListener("click",()=>{localStorage.setItem(consentKey,"denied");consentBanner.hidden=true;});
    </script>
  </body>
</html>
