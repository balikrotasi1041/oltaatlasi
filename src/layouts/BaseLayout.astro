---
import "../styles/global.css";
import "../styles/world.css";
import SeoOpportunityPanel from "../components/SeoOpportunityPanel.astro";

const {
  title = "Olta Atlası",
  description = "Mera, balık, yem, yöntem ve saha hazırlığı rehberi.",
  image = "/images/site/og-default.svg",
  canonical,
  type = "website",
  publishedAt,
  modifiedAt,
  noindex = false,
} = Astro.props;

const currentPath = Astro.url.pathname;
const normalizedPath = currentPath.endsWith("/") ? currentPath : `${currentPath}/`;
const seoOverrides:Record<string,{title:string;description:string}>={
  "/meralar/galata-koprusu/":{
    title:"Galata Köprüsü'nde Balık Tutma Rehberi",
    description:"Galata Köprüsü'nde balık tutma planı: raporlanan türler, çapari ve şamandıra yöntemleri, ulaşım, kalabalık, deniz trafiği ve güvenlik notları."
  },
  "/meralar/izmit-korfezi-sahil-bandi/":{
    title:"İzmit Körfezi'nde Balık Tutma: Sahil Bandı Rehberi",
    description:"İzmit Körfezi sahil bandında balık tutma planı: Marina–1 Mart Vapur İskelesi çevresi, raporlanan türler, yöntemler, ulaşım ve güvenlik notları."
  },
  "/meralar/sarimsakli-baraji-genel-amator-kiyi/":{
    title:"Sarımsaklı Barajı Yol Tarifi ve Balık Avı",
    description:"Sarımsaklı Barajı yol tarifi ve balık avı planı: kamusal genel kıyı yaklaşımı, pullu sazan, tatlısu levreği ve gümüşi havuz balığı kayıtları, erişim ve güncel uyarılar."
  },
  "/meralar/tutunciftlik-sahil-parki/":{
    title:"Tütünçiftlik Sahili Balık Tutma ve Yol Tarifi",
    description:"Körfez Tütünçiftlik Sahili'nde balık tutma planı: yol tarifi, kıyı erişimi, raporlanan türler, kalabalık, deniz trafiği ve güncel güvenlik notları."
  },
  "/meralar/seyhli-goleti-genel-amator-kiyi/":{
    title:"Şeyhli Göleti Yol Tarifi ve Balık Avı",
    description:"Şeyhli Göleti yol tarifi ve balık avı rehberi: genel kamusal yaklaşım, raporlanan balık türleri, kıyı-zemin yapısı, erişim ve güncel içsu kuralları."
  },
  "/meralar/yamula-baraji-resmi-amator-balikcilik-alani/":{
    title:"Yamula Barajı Balık Tutma Yerleri ve Yol Tarifi",
    description:"Yamula Barajı balık tutma yerleri için resmî amatör alan bağlamı, yol tarifi, raporlanan türler, kıyı erişimi, riskler ve güncel mevzuat notları."
  },
  "/meralar/cubuklu-sahili/":{
    title:"Çubuklu Sahili Balık Tutma ve Yol Tarifi",
    description:"Çubuklu Sahili'nde balık tutma planı: Boğaz kıyısı yol tarifi, ulaşım, raporlanan türler, akıntı, kalabalık ve güvenli olta kullanımı notları."
  },
  "/meralar/cengelkoy-sahili/":{
    title:"Çengelköy Sahili Yol Tarifi ve Balık Tutma",
    description:"Çengelköy Sahili yol tarifi ve balık tutma rehberi: Boğaz kıyısı erişimi, raporlanan türler, akıntı, yaya yoğunluğu ve güncel saha uyarıları."
  },
  "/meralar/gumusoren-baraji-genel-amator-kiyi/":{
    title:"Gümüşören Barajı Balık Avı ve Yol Tarifi",
    description:"Gümüşören Barajı balık avı ve yol tarifi: genel kamusal yaklaşım, raporlanan türler, araç erişimi, zemin koşulları ve güncel içsu mevzuatı notları."
  },
  "/meralar/beykoz-merkez-sahili/":{
    title:"Beykoz Merkez Sahili Balık Tutma Rehberi",
    description:"Beykoz Merkez Sahili'nde balık tutma planı: Boğaz kıyısı erişimi, yol tarifi, raporlanan türler, akıntı, vapur-yaya trafiği ve güvenlik notları."
  },
  "/meralar/hirfanli-baraji-kale-mevki-bala/":{
    title:"Hirfanlı Barajı Kale Mevkii Balık Avı",
    description:"Hirfanlı Barajı Kale Mevkii balık avı rehberi: resmî amatör alan bağlamı, yol tarifi, raporlanan türler, kıyı yaklaşımı ve güncel içsu kuralları."
  },
  "/rehberler/sazan-icin-misir-hazirlama/":{
    title:"Sazan İçin Mısır Hazırlama: Haşlama ve İğneye Takma",
    description:"Sazan için konserve ve kuru mısır hazırlama; tane kıvamı, kontrollü haşlama, iğne açıklığı, saçlı takım ve güvenli saklama adımları."
  }
};
const seoOverride=seoOverrides[normalizedPath];
const effectiveTitle=seoOverride?.title||title;
const effectiveDescription=seoOverride?.description||description;
const pageUrl = canonical || new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
const fullTitle = effectiveTitle === "Olta Atlası" ? effectiveTitle : `${effectiveTitle} | Olta Atlası`;
const homeUrl = new URL("/", Astro.site).href;
const isMeraDetail = /^\/meralar\/[^/]+\/?$/.test(currentPath);
const isAdmin = currentPath.startsWith("/admin/");

const navigation = [
  { href: "/meralar/", label: "Meralar", match: "/meralar/" },
  { href: "/baliklar/", label: "Balıklar", match: "/baliklar/" },
  { href: "/rehberler/", label: "Rehberler", match: "/rehberler/" },
  { href: "/dunyada-balikcilik/", label: "Dünya", match: "/dunyada-balikcilik/" },
  { href: "/balikci-gazetesi/", label: "Balıkçı Gazetesi", match: "/balikci-gazetesi/" },
  { href: "/hakkinda/", label: "Hakkımızda", match: "/hakkinda/" },
];
const adminNavigation = [
  { href: "/admin/dashboard/", label: "Dashboard", match: "/admin/dashboard/" },
  { href: "/admin/growth-control/", label: "Büyüme Kontrolü", match: "/admin/growth-control/" },
  { href: "/admin/seo-radar/", label: "SEO Fırsat Radarı", match: "/admin/seo-radar/" },
  { href: "/admin/traffic-diagnostics/", label: "Trafik Teşhisi", match: "/admin/traffic-diagnostics/" },
];
const isActive = (match: string) => currentPath.startsWith(match);

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${homeUrl}#organization`,
  name: "Olta Atlası",
  url: homeUrl,
  logo: new URL("/logo-mark.svg", Astro.site).href,
  email: "mailto:balikrotasi1041@gmail.com",
  description: "Türkiye'deki kıyı ve iç su rotalarını balık türleri, ulaşım, saha güvenliği ve doğrulama notlarıyla açıklayan bağımsız bilgi rehberi.",
};
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${homeUrl}#website`,
  url: homeUrl,
  name: "Olta Atlası",
  publisher: { "@id": `${homeUrl}#organization` },
  inLanguage: "tr-TR",
};
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a3340" />
    <meta name="application-name" content="Olta Atlası" />
    <meta name="description" content={effectiveDescription} />
    <meta name="author" content="Olta Atlası Editörlüğü" />
    <meta name="robots" content={noindex ? "noindex,nofollow" : "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"} />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/svg+xml" href="/logo-mark.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://unpkg.com" crossorigin="anonymous" />
    <link rel="preconnect" href="https://tile.openstreetmap.org" crossorigin="anonymous" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:type" content={type === "article" ? "article" : "website"} />
    <meta property="og:site_name" content="Olta Atlası" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={effectiveDescription} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={`${effectiveTitle} için Olta Atlası görseli`} />
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}
    {modifiedAt && <meta property="article:modified_time" content={modifiedAt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={effectiveDescription} />
    <meta name="twitter:image" content={imageUrl} />
    <title>{fullTitle}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  </head>
  <body>
    <a class="skip-link" href="#icerik">İçeriğe geç</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="Olta Atlası ana sayfa">
          <img class="brand-mark" src="/logo-mark.svg" alt="" width="48" height="48" />
          <span><strong>Olta Atlası</strong><small>Mera, tür ve saha rehberi</small></span>
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-navigation" aria-label="Ana menüyü aç">
          <span>Menü</span><span class="menu-toggle-icon" aria-hidden="true">☰</span>
        </button>
        <nav class="main-nav" id="main-navigation" aria-label="Ana menü" data-open="false">
          {navigation.map((item) => (
            <a href={item.href} class:list={{ "is-active": isActive(item.match) }} aria-current={isActive(item.match) ? "page" : undefined}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>
    {isAdmin && (
      <nav aria-label="Yönetim araçları" style="background:#eef6f7;border-bottom:1px solid #cfe0e2;">
        <div class="container" style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;padding-block:12px;">
          <strong style="color:#0a3340;margin-right:4px;">Yönetim</strong>
          {adminNavigation.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.match) ? "page" : undefined}
              style={`display:inline-flex;align-items:center;min-height:38px;padding:8px 13px;border-radius:10px;border:1px solid #b9d2d6;text-decoration:none;font-weight:800;${isActive(item.match) ? "background:#0b5967;color:#fff;border-color:#0b5967;" : "background:#fff;color:#0b5967;"}`}
            >
              {item.label}
            </a>
          ))}
        </div>
      </nav>
    )}
    {isMeraDetail && (
      <aside aria-label="Bilgilendirme ve sorumluluk" style="background:#fff5ed;border-bottom:1px solid #f0cfb8;">
        <div class="container" style="padding-block:18px;">
          <strong>Bilgilendirme ve sorumluluk:</strong>
          <span> Bu rota bilgileri kamuya açık kaynaklardan derlenmiş, tavsiye niteliğinde bilgilerdir. Fiziki koşullar, coğrafi kısıtlar, özel mülkiyet, koruma alanları, geçici kapatmalar ve hukuki yasaklar değişebilir. Yola çıkmadan önce güncel resmî kaynakları ve saha koşullarını ayrıca kontrol edin. Belirtilen konuma gitme, alana giriş ve avlanma kararı kullanıcının kendi değerlendirmesi ve sorumluluğundadır. Olta Atlası erişim veya av yapılabilirliği garanti etmez. </span>
          <a href="/sorumluluk-ve-kullanim/" style="font-weight:800;">Ayrıntılı açıklama</a>
        </div>
      </aside>
    )}
    <main id="icerik"><slot /></main>
    <SeoOpportunityPanel path={currentPath}/>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div><strong>Olta Atlası</strong><p>Mera, tür, yöntem, navigasyon ve saha güvenliğini aynı rotada buluşturan bağımsız balıkçılık rehberi.</p></div>
        <div><strong>Editörlük ilkesi</strong><p>Bilgiler açık kaynaklardan derlenerek kaynak, son kontrol tarihi ve güven seviyesiyle tavsiye niteliğinde sunulur. Fiziki ve hukuki koşullar ayrıca doğrulanmalıdır; raporlanan türler av garantisi değildir.</p></div>
        <div><strong>Bağlantılar</strong><p><a href="/iller/">İl rehberleri</a><br /><a href="/yazilar/">Tüm yazılar</a><br /><a href="/sorumluluk-ve-kullanim/">Sorumluluk ve kullanım</a><br /><a href="/gizlilik/">Gizlilik ve çerezler</a><br /><a href="/gorsel-kaynaklari/">Görsel kaynakları</a><br /><a href="/iletisim/">Hata bildir / İletişim</a></p></div>
      </div>
      <div class="container footer-bottom">© {new Date().getFullYear()} Olta Atlası · Rota seçimi, alana giriş ve avlanma kullanıcının kendi sorumluluğundadır · Doğayı bulduğundan temiz bırak.</div>
    </footer>
    <aside class="consent-banner" id="consent-banner" hidden aria-label="Analitik tercihleri" aria-live="polite"><div><strong>Analitik tercihi</strong><p>Siteyi geliştirmek için Google Analytics ve Yandex.Metrica kullanıyoruz. İzin vermeden analitik etiketleri yüklenmez. Harita açıldığında OpenStreetMap karo sunucularına bağlantı kurulur.</p><a href="/gizlilik/">Ayrıntıları oku</a></div><div class="consent-actions"><button class="button button-small" id="consent-accept" type="button">Analitiğe izin ver</button><button class="button button-small button-ghost consent-reject" id="consent-reject" type="button">Yalnızca gerekli</button></div></aside>
    <script is:inline>
      const toggle = document.querySelector(".menu-toggle");
      const navigation = document.querySelector("#main-navigation");
      const closeMenu = () => { if (!toggle || !navigation) return; toggle.setAttribute("aria-expanded", "false"); toggle.setAttribute("aria-label", "Ana menüyü aç"); navigation.dataset.open = "false"; };
      toggle?.addEventListener("click", () => { const willOpen = toggle.getAttribute("aria-expanded") !== "true"; toggle.setAttribute("aria-expanded", String(willOpen)); toggle.setAttribute("aria-label", willOpen ? "Ana menüyü kapat" : "Ana menüyü aç"); navigation.dataset.open = String(willOpen); });
      navigation?.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));
      document.addEventListener("keydown", (event) => { if (event.key === "Escape") closeMenu(); });
      document.addEventListener("click", (event) => { if (!toggle || !navigation || navigation.dataset.open !== "true") return; const target = event.target; if (target instanceof Node && !navigation.contains(target) && !toggle.contains(target)) closeMenu(); });

      const consentKey="oltaatlasi-analytics-consent";
      const consentBanner=document.querySelector("#consent-banner");
      let analyticsLoaded=false;
      const loadAnalytics=()=>{
        if(analyticsLoaded)return;
        analyticsLoaded=true;

        const googleScript=document.createElement("script");
        googleScript.async=true;
        googleScript.src="https://www.googletagmanager.com/gtag/js?id=G-VRTYGZD66T";
        document.head.appendChild(googleScript);
        window.dataLayer=window.dataLayer||[];
        window.gtag=function(){window.dataLayer.push(arguments);};
        window.gtag("js",new Date());
        window.gtag("config","G-VRTYGZD66T",{anonymize_ip:true});

        window.ym=window.ym||function(){(window.ym.a=window.ym.a||[]).push(arguments);};
        window.ym.l=1*new Date();
        const metrikaSrc="https://mc.yandex.ru/metrika/tag.js?id=111979244";
        const metrikaExists=Array.from(document.scripts).some((existingScript)=>existingScript.src===metrikaSrc);
        if(!metrikaExists){
          const metrikaScript=document.createElement("script");
          metrikaScript.async=true;
          metrikaScript.src=metrikaSrc;
          document.head.appendChild(metrikaScript);
        }
        window.ym(111979244,"init",{ssr:true,webvisor:true,clickmap:true,ecommerce:"dataLayer",referrer:document.referrer,url:location.href,accurateTrackBounce:true,trackLinks:true});
      };
      const savedConsent=localStorage.getItem(consentKey);
      if(savedConsent==="granted")loadAnalytics();else if(!savedConsent)consentBanner.hidden=false;
      document.querySelector("#consent-accept")?.addEventListener("click",()=>{localStorage.setItem(consentKey,"granted");consentBanner.hidden=true;loadAnalytics();});
      document.querySelector("#consent-reject")?.addEventListener("click",()=>{localStorage.setItem(consentKey,"denied");consentBanner.hidden=true;});
    </script>
  </body>
</html>