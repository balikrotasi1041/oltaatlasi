---
import { meralar } from "../data/meralar";
const mapData = meralar.map(({slug,name,province,district,zone,lat,lng,waterType,fish,confidence})=>({slug,name,province,district,zone,lat,lng,waterType,fish,confidence}));
---
<section class="map-shell" aria-labelledby="map-title"><div class="section-heading compact"><div><span class="kicker">Marmara rota haritası</span><h2 id="map-title">İstanbul, Kocaeli ve yakın çevredeki avlaklar</h2></div><p>İşaretler hassas veya yoğun alanlarda tam av noktası değil, genel kamusal erişim bölgesidir. Yakın işaretler performans için kümelenir.</p></div><div id="map" class="map" aria-label="Olta Atlası avlak haritası"></div><div class="map-footer"><span>{mapData.length} avlak işareti</span><a href="/meralar/">Arama ve ayrıntılı filtreleri aç →</a></div></section>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css" crossorigin="" />
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css" crossorigin="" />
<script is:inline define:vars={{mapData}}>
const loadScript=src=>new Promise((resolve,reject)=>{const existing=[...document.scripts].find(script=>script.src===src);if(existing){if(existing.dataset.loaded==="true")resolve();else existing.addEventListener("load",resolve,{once:true});return;}const script=document.createElement("script");script.src=src;script.crossOrigin="";script.onload=()=>{script.dataset.loaded="true";resolve();};script.onerror=reject;document.head.appendChild(script);});
const startMap=()=>{if(!window.L||document.querySelector("#map")?.dataset.ready==="true")return;const mapNode=document.querySelector("#map");mapNode.dataset.ready="true";const map=L.map("map",{scrollWheelZoom:false,zoomControl:true}).setView([40.95,29.45],8);L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png",{maxZoom:18,attribution:'&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'}).addTo(map);const layer=typeof L.markerClusterGroup==="function"?L.markerClusterGroup({showCoverageOnHover:false,maxClusterRadius:52,disableClusteringAtZoom:13}):L.layerGroup();const markers={};const bounds=[];mapData.forEach(item=>{const marker=L.marker([item.lat,item.lng]);marker.bindPopup(`<strong>${item.name}</strong><br>${item.province} · ${item.district} · ${item.zone}<br><small>${item.fish.slice(0,3).join(", ")} · Güven ${item.confidence}</small><br><a href="/meralar/${item.slug}/">Avlak dosyasını aç</a>`);layer.addLayer(marker);markers[item.slug]=marker;bounds.push([item.lat,item.lng]);});layer.addTo(map);if(bounds.length>1)map.fitBounds(bounds,{padding:[34,34],maxZoom:10});document.addEventListener("oltaatlasi:focus-map",event=>{const marker=markers[event.detail];if(!marker)return;if(typeof layer.zoomToShowLayer==="function")layer.zoomToShowLayer(marker,()=>marker.openPopup());else{map.setView(marker.getLatLng(),13);marker.openPopup();}document.getElementById("map")?.scrollIntoView({behavior:"smooth",block:"center"});});};
const boot=async()=>{try{if(!window.L)await loadScript("https://unpkg.com/leaflet@1.9.4/dist/leaflet.js");if(typeof L.markerClusterGroup!=="function")await loadScript("https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js");startMap();}catch(error){const node=document.querySelector("#map");if(node)node.innerHTML='<p class="map-error">Harita şu anda yüklenemedi. Avlak arşivini kullanarak rotalara erişebilirsin.</p>';}};boot();
</script>
