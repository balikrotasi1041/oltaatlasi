---
import { meralar, nationalCoordinateStats } from "../data/meralar-tumu";
import { routeLocationOverrides20260815 } from "../data/route-location-overrides-2026-08-15";
const mapData = meralar
  .map(({slug,name,province,district,zone,lat,lng,waterType,fish,confidence,locationPrecision})=>{
    const override=routeLocationOverrides20260815[slug];
    return {
      slug,name,province,district,zone,
      lat:override?.lat??lat,
      lng:override?.lng??lng,
      waterType,
      fish:[...new Set((fish||[]).map((item)=>String(item).trim()).filter(Boolean))],
      confidence,
      locationPrecision:override?.precision??locationPrecision,
      locationLabel:override?.label||"",
      preliminary:confidence==="D"
    };
  })
  .filter((mera)=>Number.isFinite(mera.lat)&&Number.isFinite(mera.lng));
const provinces=[...new Set(mapData.map((item)=>item.province))].sort((a,b)=>a.localeCompare(b,"tr"));
const waterTypes=[...new Set(mapData.map((item)=>item.waterType))].sort((a,b)=>a.localeCompare(b,"tr"));
const fishTypes=[...new Set(mapData.flatMap((item)=>item.fish))].sort((a,b)=>a.localeCompare(b,"tr"));
---
<section class="map-shell" aria-labelledby="map-title">
  <div class="section-heading compact">
    <div><span class="kicker">Türkiye avlak haritası</span><h2 id="map-title">Doğrulanmış ve genel konum pinleri</h2></div>
    <p>Güven D işaretleri rota veya su varlığının genel konumunu gösterir; kıyıya giriş, araç rotası ya da avlanma izni anlamına gelmez.</p>
  </div>
  <div class="map-filter-bar" aria-label="Harita filtreleri">
    <label><span>İl</span><select id="map-province"><option value="">Tüm iller</option>{provinces.map((province)=><option value={province}>{province}</option>)}</select></label>
    <label><span>Su türü</span><select id="map-water"><option value="">Tüm su türleri</option>{waterTypes.map((water)=><option value={water}>{water}</option>)}</select></label>
    <label><span>Balık türü</span><select id="map-fish"><option value="">Tüm balık türleri</option>{fishTypes.map((fish)=><option value={fish}>{fish}</option>)}</select></label>
    <button class="button button-ghost button-small" id="map-reset" type="button">Haritayı sıfırla</button>
  </div>
  <div id="map" class="map" aria-label="Olta Atlası Türkiye avlak haritası"></div>
  <div class="map-legend" aria-label="Harita işaret açıklaması"><span><i class="legend-dot legend-verified"></i> Güçlü rota pini</span><span><i class="legend-dot legend-preliminary"></i> Genel konum / Güven D</span></div>
  <div class="map-footer"><span id="map-result-count">{mapData.length} koordinatlı kayıt</span><span>{fishTypes.length} balık türüyle filtrelenebilir</span><span>{nationalCoordinateStats.unresolved} ulusal rota su-özel koordinat eşleşmesini geliştiriyor</span><a href="/meralar/">81 ildeki tüm rota dosyalarını aç →</a></div>
</section>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css" crossorigin="" />
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css" crossorigin="" />
<script is:inline define:vars={{mapData}}>
const loadScript=src=>new Promise((resolve,reject)=>{const existing=[...document.scripts].find(script=>script.src===src);if(existing){if(existing.dataset.loaded==="true")resolve();else existing.addEventListener("load",resolve,{once:true});return;}const script=document.createElement("script");script.src=src;script.crossOrigin="";script.onload=()=>{script.dataset.loaded="true";resolve();};script.onerror=reject;document.head.appendChild(script);});
const escapeHtml=value=>String(value??"").replace(/[&<>'"]/g,char=>({"&":"&amp;","<":"&lt;",">":"&gt;","'":"&#39;",'"':"&quot;"}[char]));
const startMap=()=>{
  if(!window.L||document.querySelector("#map")?.dataset.ready==="true")return;
  const mapNode=document.querySelector("#map");mapNode.dataset.ready="true";
  const province=document.querySelector("#map-province"),water=document.querySelector("#map-water"),fish=document.querySelector("#map-fish"),count=document.querySelector("#map-result-count");
  const map=L.map("map",{scrollWheelZoom:false,zoomControl:true}).setView([39.1,35.2],6);
  L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png",{maxZoom:18,attribution:'&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'}).addTo(map);
  const layer=typeof L.markerClusterGroup==="function"?L.markerClusterGroup({showCoverageOnHover:false,maxClusterRadius:48,disableClusteringAtZoom:12}):L.layerGroup();
  const markers={};
  const createMarker=item=>{
    const marker=item.preliminary
      ? L.circleMarker([item.lat,item.lng],{radius:7,weight:2,fillOpacity:.72})
      : L.marker([item.lat,item.lng]);
    const fishText=item.fish.length?item.fish.slice(0,4).map(escapeHtml).join(", "):"Tür bilgisi kaynak doğrulaması bekliyor";
    const locationText=item.locationLabel?escapeHtml(item.locationLabel):(item.preliminary?"Genel su konumu; erişim pini değildir":escapeHtml(item.locationPrecision));
    marker.bindPopup(`<strong>${escapeHtml(item.name)}</strong><br>${escapeHtml(item.province)} · ${escapeHtml(item.district)} · ${escapeHtml(item.zone)}<br><small>${fishText} · Güven ${escapeHtml(item.confidence)}</small><br><small>${locationText}</small><br><a href="/meralar/${encodeURIComponent(item.slug)}/">Konum ve rota rehberini aç</a>`);
    markers[item.slug]=marker;
    return marker;
  };
  mapData.forEach(createMarker);
  layer.addTo(map);
  const render=()=>{
    layer.clearLayers();
    const matches=mapData.filter(item=>(!province.value||item.province===province.value)&&(!water.value||item.waterType===water.value)&&(!fish.value||item.fish.includes(fish.value)));
    const bounds=[];
    matches.forEach(item=>{const marker=markers[item.slug];layer.addLayer(marker);bounds.push([item.lat,item.lng]);});
    const filterText=[province.value,water.value,fish.value].filter(Boolean).join(" · ");
    count.textContent=`${matches.length} koordinatlı kayıt${filterText?` (${filterText})`:""} gösteriliyor`;
    if(bounds.length===1)map.setView(bounds[0],11);else if(bounds.length>1)map.fitBounds(bounds,{padding:[34,34],maxZoom:10});else map.setView([39.1,35.2],6);
  };
  province.addEventListener("change",render);water.addEventListener("change",render);fish.addEventListener("change",render);
  document.querySelector("#map-reset")?.addEventListener("click",()=>{province.value="";water.value="";fish.value="";render();});
  document.addEventListener("oltaatlasi:focus-map",event=>{const item=mapData.find(candidate=>candidate.slug===event.detail);const marker=markers[event.detail];if(!item||!marker)return;province.value=item.province;water.value="";fish.value="";render();if(typeof layer.zoomToShowLayer==="function")layer.zoomToShowLayer(marker,()=>marker.openPopup());else{map.setView(marker.getLatLng(),13);marker.openPopup();}mapNode.scrollIntoView({behavior:"smooth",block:"center"});});
  render();
};
const boot=async()=>{try{if(!window.L)await loadScript("https://unpkg.com/leaflet@1.9.4/dist/leaflet.js");if(typeof L.markerClusterGroup!=="function")await loadScript("https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js");startMap();}catch(error){const node=document.querySelector("#map");if(node)node.innerHTML='<p class="map-error">Harita şu anda yüklenemedi. Avlak arşivini kullanarak rotalara erişebilirsin.</p>';}};boot();
</script>
<style>
.map-filter-bar{display:flex;flex-wrap:wrap;gap:12px;align-items:end;margin-bottom:14px}.map-filter-bar label{display:grid;gap:5px;min-width:190px;flex:1 1 190px}.map-filter-bar label span{font-size:.82rem;font-weight:800}.map-filter-bar select{min-height:42px;border:1px solid var(--border);border-radius:10px;background:var(--surface);padding:0 12px}.map-legend{display:flex;flex-wrap:wrap;gap:18px;margin-top:12px;font-size:.86rem}.map-legend span{display:inline-flex;align-items:center;gap:7px}.legend-dot{width:12px;height:12px;border-radius:50%;display:inline-block;border:2px solid currentColor}.legend-verified{background:currentColor}.legend-preliminary{background:transparent}
</style>
