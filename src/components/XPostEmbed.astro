---
const {
  sourceUrl,
  sourceAuthor,
  sourceLabel = "X gönderisi",
} = Astro.props as {
  sourceUrl: string;
  sourceAuthor: string;
  sourceLabel?: string;
};
---
<section class="x-consent-card" data-x-embed data-source-url={sourceUrl}>
  <div class="x-consent-copy">
    <span class="kicker">X içeriği</span>
    <h2>{sourceLabel}</h2>
    <p><strong>{sourceAuthor}</strong> tarafından yayımlanan gönderi, yalnızca sen açmayı seçtiğinde X’in resmî oynatıcısıyla yüklenir.</p>
    <p class="microcopy">Gönderiyi açmak tarayıcının X sunucularına bağlanmasına neden olabilir. Olta Atlası fotoğrafı, videoyu veya gönderi metnini kendi sunucusuna kopyalamaz.</p>
  </div>
  <div class="x-consent-actions">
    <button class="button" type="button" data-x-load>Gönderiyi burada göster</button>
    <a class="button button-ghost" href={sourceUrl} target="_blank" rel="noreferrer noopener">X'te aç</a>
  </div>
  <div class="x-embed-target" data-x-target hidden aria-live="polite"></div>
</section>
<script is:inline>
  if (!window.__oltaAtlasiXEmbedBound) {
    window.__oltaAtlasiXEmbedBound = true;
    const ensureXWidgets = () => new Promise((resolve, reject) => {
      if (window.twttr?.widgets) { resolve(window.twttr); return; }
      const existing = document.querySelector('script[data-olta-x-widgets]');
      if (existing) {
        existing.addEventListener('load', () => resolve(window.twttr), { once: true });
        existing.addEventListener('error', reject, { once: true });
        return;
      }
      const script = document.createElement('script');
      script.src = 'https://platform.twitter.com/widgets.js';
      script.async = true;
      script.dataset.oltaXWidgets = 'true';
      script.addEventListener('load', () => resolve(window.twttr), { once: true });
      script.addEventListener('error', reject, { once: true });
      document.head.appendChild(script);
    });

    document.addEventListener('click', async (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const button = target.closest('[data-x-load]');
      if (!(button instanceof HTMLButtonElement)) return;
      const card = button.closest('[data-x-embed]');
      if (!(card instanceof HTMLElement)) return;
      const sourceUrl = card.dataset.sourceUrl;
      const mount = card.querySelector('[data-x-target]');
      if (!sourceUrl || !(mount instanceof HTMLElement)) return;

      button.disabled = true;
      button.textContent = 'Gönderi yükleniyor…';
      mount.hidden = false;
      mount.innerHTML = '<p class="microcopy">X bağlantısı kuruluyor…</p>';

      const blockquote = document.createElement('blockquote');
      blockquote.className = 'twitter-tweet';
      blockquote.dataset.dnt = 'true';
      blockquote.dataset.theme = 'light';
      const link = document.createElement('a');
      link.href = sourceUrl;
      blockquote.appendChild(link);
      mount.replaceChildren(blockquote);

      try {
        const twttr = await ensureXWidgets();
        await twttr?.widgets?.load(mount);
        button.remove();
      } catch (error) {
        mount.innerHTML = '<p class="x-embed-error">Gönderi burada yüklenemedi. X bağlantısını ayrı sekmede açabilirsin.</p>';
        button.disabled = false;
        button.textContent = 'Yeniden dene';
      }
    });
  }
</script>
