---
import { meralar, provinces, districtRouteCounts } from "../data/meralar-tumu";
import { baliklar } from "../data/baliklar";
import { rehberler } from "../data/rehber-katalogu";
import { slugifyTr } from "../utils/slug";
import { routeDemandPriority } from "../data/seo-demand-targets";

type LinkItem={href:string;label:string;note:string};
type IntentPanel={eyebrow:string;title:string;body:string;points:string[];links:LinkItem[]};
const {path}=Astro.props as {path:string};
const normalizedPath=path.endsWith("/")?path:`${path}/`;
const clean=(value:string)=>String(value||"").replace(/\s+/g," ").trim();
const truncate=(value:string,max=180)=>{const text=clean(value);return text.length<=max?text:`${text.slice(0,max-1).replace(/\s+\S*$/,"")}…`;};
const locative=(name:string)=>{
  const lower=name.toLocaleLowerCase("tr-TR");
  const vowels=[...lower].filter((letter)=>"aeıioöuü".includes(letter));
  const lastVowel=vowels.at(-1)||"e";
  const back="aıou".includes(lastVowel);
  const lastLetter=lower.at(-1)||"";
  const hard="fstkçşhp".includes(lastLetter);
  return `${name}'${hard?(back?"ta":"te"):(back?"da":"de")}`;
};
const uniqueLinks=(items:LinkItem[],limit=6)=>{
  const seen=new Set<string>();
  return items.filter((item)=>item.href&&item.href!==normalizedPath&&!seen.has(item.href)&&seen.add(item.href)).slice(0,limit);
};
const confidenceScore:Record<string,number>={A:4,B:3,C:2,D:0};
const strongRoutes=[...meralar].filter((route)=>route.confidence!=="D").sort((a,b)=>routeDemandPriority(b.slug)-routeDemandPriority(a.slug)||(confidenceScore[b.confidence]||0)-(confidenceScore[a.confidence]||0)||(b.updatedAt||b.publishedAt).localeCompare(a.updatedAt||a.publishedAt));

let panel:IntentPanel|null=null;
const meraMatch=normalizedPath.match(/^\/meralar\/([^/]+)\/$/);
const fishMatch=normalizedPath.match(/^\/baliklar\/([^/]+)\/$/);
const guideMatch=normalizedPath.match(/^\/rehberler\/([^/]+)\/$/);
const provinceDistrictMatch=normalizedPath.match(/^\/iller\/([^/]+)\/([^/]+)\/$/);
const provinceMatch=normalizedPath.match(/^\/iller\/([^/]+)\/$/);

if(meraMatch){
  const mera=meralar.find((item)=>item.slug===meraMatch[1]);
  if(mera){
    const sameDistrict=strongRoutes.filter((item)=>item.slug!==mera.slug&&item.province===mera.province&&item.district===mera.district);
    const sameProvince=strongRoutes.filter((item)=>item.slug!==mera.slug&&item.province===mera.province&&item.district!==mera.district);
    const fishLinks=baliklar.filter((fish)=>mera.fish.includes(fish.name)).map((fish)=>({href:`/baliklar/${fish.slug}/`,label:`${fish.name} balıkçılık dosyası`,note:"Yöntem, yem, habitat ve ilişkili rota bağlantılarını incele."}));
    const routeLinks=[...sameDistrict,...sameProvince].slice(0,3).map((route)=>({href:`/meralar/${route.slug}/`,label:route.name,note:`${route.district} · ${route.waterType} · Güven ${route.confidence}`}));
    const districtCount=districtRouteCounts[`${mera.province}|${mera.district}`]||0;
    const districtHref=districtCount>=2?`/iller/${slugifyTr(mera.province)}/${slugifyTr(mera.district)}/`:`/iller/${slugifyTr(mera.province)}/#${slugifyTr(mera.district)}`;
    panel={
      eyebrow:"Arama niyeti · hızlı cevap",
      title:`${mera.name}: yol tarifi, balık türleri ve yakın rotalar`,
      body:`${mera.name} için kullanıcıların en sık aradığı üç konu konum/yol tarifi, hangi balıkların raporlandığı ve aynı bölgede hangi alternatif rotaların bulunduğudur. Aşağıdaki özet yalnız mevcut rota verisini kullanır.`,
      points:[
        `Yol tarifi ve erişim: ${truncate(mera.transport||mera.navigationNote||"Son yaklaşım ve kamusal erişim hareket günü ayrıca kontrol edilmelidir.",210)}`,
        `Hangi balıklar var? ${mera.fish.length?mera.fish.join(", "):"Rota özelinde kaynakla desteklenmiş tür listesi henüz yok."}`,
        `Doğrulama: Güven ${mera.confidence} · ${mera.locationPrecision} · araç erişimi ${mera.vehicleAccess}. Harita pini av izni veya kesin kıyı girişi değildir.`
      ],
      links:uniqueLinks([
        {href:districtHref,label:`${locative(mera.district)} balık tutulacak yerler`,note:"Aynı ilçe veya alan grubundaki rota dosyalarını karşılaştır."},
        {href:`/iller/${slugifyTr(mera.province)}/`,label:`${locative(mera.province)} balık tutulacak yerler`,note:"İldeki doğrulanmış kıyı ve içsu rotalarına geç."},
        ...fishLinks,
        ...routeLinks
      ])
    };
  }
}else if(fishMatch){
  const fish=baliklar.find((item)=>item.slug===fishMatch[1]);
  if(fish){
    const routes=strongRoutes.filter((route)=>route.fish.includes(fish.name));
    const provinceCounts=[...new Set(routes.map((route)=>route.province))].map((province)=>({province,count:routes.filter((route)=>route.province===province).length})).sort((a,b)=>b.count-a.count).slice(0,2);
    const guides=rehberler.filter((guide)=>guide.targetSpecies.includes(fish.name)).slice(0,2);
    panel={
      eyebrow:"Tür niyeti · nerede ve nasıl",
      title:`${fish.name} nerede ve nasıl tutulur?`,
      body:`${fish.name} için tür sayfasını yalnız ekipman listesi olarak değil, yöntem, yem ve Olta Atlası'ndaki doğrulanabilir rota ağına açılan merkez olarak kullan.`,
      points:[
        `Öne çıkan yöntemler: ${fish.methods.join(", ")}.`,
        `Başlangıç yemleri: ${fish.baits.join(", ")}.`,
        `Olta Atlası'nda Güven A-C düzeyinde ${routes.length} rota dosyası bu türle eşleşiyor; kayıt günlük av garantisi değildir.`
      ],
      links:uniqueLinks([
        ...routes.slice(0,4).map((route)=>({href:`/meralar/${route.slug}/`,label:route.name,note:`${route.province} · ${route.district} · Güven ${route.confidence}`})),
        ...provinceCounts.map((item)=>({href:`/iller/${slugifyTr(item.province)}/`,label:`${item.province} avlakları`,note:`${fish.name} ile eşleşen ${item.count} doğrulanabilir rota.`})),
        ...guides.map((guide)=>({href:`/rehberler/${guide.slug}/`,label:guide.title,note:`${guide.category} · ${guide.readingTime} dk`}))
      ])
    };
  }
}else if(guideMatch){
  const guide=rehberler.find((item)=>item.slug===guideMatch[1]);
  if(guide){
    const generic=new Set(["Genel kullanım","Genel kıyı türleri","Genel kıyı balıkçılığı"]);
    const targets=guide.targetSpecies.filter((name)=>!generic.has(name));
    const routes=targets.length?strongRoutes.filter((route)=>route.fish.some((name)=>targets.includes(name))):strongRoutes.slice(0,6);
    const fishLinks=baliklar.filter((fish)=>targets.includes(fish.name)).slice(0,3);
    panel={
      eyebrow:"Rehber niyeti · uygulamaya geç",
      title:`${guide.title}: ilgili türler ve saha rotaları`,
      body:"Rehber bilgisini tek başına bırakmak yerine, ilgili tür ve rota dosyalarına bağlayarak hazırlık → tür → saha zincirini tamamla.",
      points:[
        `Kategori: ${guide.category} · zorluk: ${guide.difficulty} · yaklaşık ${guide.readingTime} dk okuma.`,
        `Hedef: ${guide.targetSpecies.join(", ")}.`,
        "Rota bağlantıları av garantisi değildir; erişim, hava, mevzuat ve saha güvenliği ayrıca kontrol edilmelidir."
      ],
      links:uniqueLinks([
        ...fishLinks.map((fish)=>({href:`/baliklar/${fish.slug}/`,label:fish.name,note:"Tür, yem, yöntem ve ilişkili avlaklar."})),
        ...routes.slice(0,5).map((route)=>({href:`/meralar/${route.slug}/`,label:route.name,note:`${route.province} · ${route.waterType} · Güven ${route.confidence}`}))
      ])
    };
  }
}else if(provinceDistrictMatch){
  const province=provinces.find((name)=>slugifyTr(name)===provinceDistrictMatch[1]);
  const items=province?meralar.filter((route)=>route.province===province):[];
  const district=province?[...new Set(items.map((route)=>route.district))].find((name)=>slugifyTr(name)===provinceDistrictMatch[2]):undefined;
  if(province&&district){
    const routes=items.filter((route)=>route.district===district);
    const verified=routes.filter((route)=>route.confidence!=="D");
    const fish=[...new Set(routes.flatMap((route)=>route.fish))];
    panel={
      eyebrow:"İlçe niyeti · karşılaştır",
      title:`${locative(district)} balık tutulacak yerler: hızlı seçim`,
      body:`${district}, ${province} için rota dosyalarını güven seviyesi, su türü ve raporlanan balıklar üzerinden karşılaştır.`,
      points:[
        `${routes.length} rota dosyası; bunların ${verified.length} tanesi Güven A-C düzeyinde.`,
        `Raporlanan türler: ${fish.length?fish.slice(0,10).join(", "):"rota özelinde yeterli tür kanıtı henüz yok"}.`,
        "Önce doğrulanmış rotaları incele; Güven D kayıtlarında son kıyı girişi ve saha uygunluğunu ayrıca teyit et."
      ],
      links:uniqueLinks([
        ...verified.slice(0,5).map((route)=>({href:`/meralar/${route.slug}/`,label:route.name,note:`${route.waterType} · Güven ${route.confidence} · ${route.vehicleAccess}`})),
        {href:`/iller/${slugifyTr(province)}/`,label:`${province} avlaklarının tamamı`,note:"Diğer ilçeleri ve rota gruplarını karşılaştır."}
      ])
    };
  }
}else if(provinceMatch){
  const province=provinces.find((name)=>slugifyTr(name)===provinceMatch[1]);
  if(province){
    const routes=meralar.filter((route)=>route.province===province);
    const verified=routes.filter((route)=>route.confidence!=="D");
    const districts=[...new Set(routes.map((route)=>route.district))];
    const fish=[...new Set(routes.flatMap((route)=>route.fish))];
    const districtLinks=districts.map((district)=>({district,count:routes.filter((route)=>route.district===district).length})).filter((item)=>item.count>=2).sort((a,b)=>b.count-a.count).slice(0,3);
    panel={
      eyebrow:"İl niyeti · en güçlü rotalar",
      title:`${locative(province)} balık tutulacak yerler: nereden başlanmalı?`,
      body:`${province} sayfasını ilçe, tür ve güven düzeyi üzerinden daha hızlı daralt. Arama motorları için de en güçlü rota dosyalarına kısa bir iç bağlantı yolu oluşturulur.`,
      points:[
        `${routes.length} toplam rota; ${verified.length} Güven A-C düzeyinde doğrulanabilir dosya.`,
        `${districts.length} ilçe/alan grubu ve ${fish.length} raporlanan tür etiketi bulunuyor.`,
        "Önce Güven A-C rotalarını aç; rota sayfasındaki yol tarifi, tür kanıtı ve saha uyarılarını birlikte değerlendir."
      ],
      links:uniqueLinks([
        ...verified.slice(0,5).map((route)=>({href:`/meralar/${route.slug}/`,label:route.name,note:`${route.district} · ${route.waterType} · Güven ${route.confidence}`})),
        ...districtLinks.map((item)=>({href:`/iller/${slugifyTr(province)}/${slugifyTr(item.district)}/`,label:`${item.district} avlakları`,note:`${item.count} rota dosyasını karşılaştır.`}))
      ])
    };
  }
}else if(!normalizedPath.startsWith("/admin/")&&normalizedPath!=="/404/"){
  panel={
    eyebrow:"Olta Atlası içerik ağı",
    title:"Rotadan türe, türden rehbere geç",
    body:"İçeriği tek bir sayfada bırakma. İl ve ilçe merkezleri, doğrulanabilir avlak dosyaları, balık türleri ve uygulamalı rehberler birbirine bağlı bir araştırma ağı oluşturur.",
    points:[
      "Konum arıyorsan il ve avlak merkezlerinden başla.",
      "Hedef balık belliyse tür sayfasından ilişkili Güven A-C rotalara geç.",
      "Takım, yem veya saha hazırlığı için rehberleri rota dosyalarıyla birlikte kullan."
    ],
    links:[
      {href:"/meralar/",label:"Tüm avlak ve rota dosyaları",note:"Konum, su türü, güven düzeyi ve balık filtresiyle keşfet."},
      {href:"/iller/",label:"İllere göre balık tutulacak yerler",note:"İl ve ilçe merkezlerinden güçlü rotalara geç."},
      {href:"/baliklar/",label:"Balık türleri",note:"Yöntem, yem ve ilişkili avlak ağını incele."},
      {href:"/rehberler/",label:"Balıkçılık rehberleri",note:"Takım, yem, güvenlik, hava ve saha hazırlığı."}
    ]
  };
}
---
{panel&&<section class="seo-intent-bridge" aria-labelledby="seo-intent-bridge-title"><div class="container"><div class="seo-intent-copy"><span>{panel.eyebrow}</span><h2 id="seo-intent-bridge-title">{panel.title}</h2><p>{panel.body}</p><ul>{panel.points.map((point)=><li>{point}</li>)}</ul></div><nav class="seo-intent-links" aria-label="İlgili Olta Atlası içerikleri">{panel.links.map((link)=><a href={link.href}><strong>{link.label}</strong><small>{link.note}</small></a>)}</nav></div></section>}
<style>
.seo-intent-bridge{background:#f7fbfb;border-top:1px solid #d7e7e8;border-bottom:1px solid #d7e7e8;padding:30px 0}.seo-intent-bridge>.container{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(300px,.85fr);gap:24px;align-items:start}.seo-intent-copy>span{display:block;color:#237381;font-size:.76rem;font-weight:900;letter-spacing:.12em;text-transform:uppercase}.seo-intent-bridge h2{color:#123e47;margin:.35rem 0 .7rem;font-size:clamp(1.45rem,3vw,2.05rem)}.seo-intent-bridge p{color:#49656a;line-height:1.68}.seo-intent-bridge ul{margin:16px 0 0;padding-left:20px}.seo-intent-bridge li{margin:8px 0;color:#294f56;line-height:1.52}.seo-intent-links{display:grid;gap:9px}.seo-intent-links a{display:block;background:#fff;border:1px solid #cfe0e2;border-radius:14px;padding:13px 15px;text-decoration:none;box-shadow:0 8px 18px #1439410a}.seo-intent-links strong,.seo-intent-links small{display:block}.seo-intent-links strong{color:#0b6574}.seo-intent-links small{color:#647d81;margin-top:4px;line-height:1.4}.seo-intent-links a:hover{border-color:#76abb3;transform:translateY(-1px)}@media(max-width:800px){.seo-intent-bridge>.container{grid-template-columns:1fr}.seo-intent-bridge{padding:24px 0}}
</style>
