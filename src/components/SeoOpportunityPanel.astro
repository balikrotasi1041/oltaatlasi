---
import ShareToolbar from "./ShareToolbar.astro";
type LinkItem={href:string;label:string;note:string};
type Opportunity={eyebrow:string;title:string;body:string;points:string[];links:LinkItem[]};
const {path}=Astro.props as {path:string};
const normalizedPath=path.endsWith("/")?path:`${path}/`;
const isMeraDetail=/^\/meralar\/[^/]+\/?$/.test(path);
const shareUrl=isMeraDetail?new URL(normalizedPath,Astro.site).href:"";
const opportunities:Record<string,Opportunity>={
  "/iller/istanbul/beykoz/":{
    eyebrow:"Beykoz rota karşılaştırması",
    title:"Beykoz’da balık tutulacak yeri nasıl seçmeli?",
    body:"Beykoz kıyısında aynı Boğaz hattındaki rotalar bile akıntı, vapur-iskele kullanımı, yaya yoğunluğu ve kıyıya yaklaşım biçimi bakımından ayrılır. Tek bir kıyıyı ezbere seçmek yerine kamusal erişim, operasyon sahası ve atış güvenliğini birlikte karşılaştır.",
    points:[
      "Vapur iskelesi, küçük tekne limanı ve aktif operasyon bölümünü kamusal sahil yürüyüş bandıyla karıştırma.",
      "Akıntı ve yaya yoğunluğu yüksekse ağır takım yerine güvenli atış koridorunu öncele; koridor yoksa avı ertele.",
      "Rota kartlarındaki güven seviyesi, ulaşım ve güncel uyarıları birlikte okuyarak alternatif kıyıyı önceden belirle."
    ],
    links:[
      {href:"/meralar/cubuklu-sahili/",label:"Çubuklu Sahili",note:"Vapur ve arabalı vapur operasyonlarından ayrılmış kamusal kıyı bağlamını incele."},
      {href:"/meralar/kanlica-sahili/",label:"Kanlıca Sahili",note:"İskele, küçük tekne kullanımı ve Boğaz akıntısı notlarını karşılaştır."},
      {href:"/meralar/pasabahce-sahili/",label:"Paşabahçe Sahili",note:"Rekreasyon kullanımı ve açık kıyı ceplerinin saha notlarını gör."},
      {href:"/meralar/kucuksu-sahili/",label:"Küçüksu Sahili",note:"Boğaz kıyısında erişim ve güvenlik notlarını alternatif rota olarak değerlendir."}
    ]
  },
  "/meralar/galata-koprusu/":{
    eyebrow:"İstanbul yerel av planı",
    title:"Galata Köprüsü rotasını hangi içeriklerle birlikte okumalı?",
    body:"Galata Köprüsü yoğun yaya kullanımı, diğer oltacılar ve deniz trafiği nedeniyle yalnızca hedef balığa göre değil, güvenli atış koridoruna göre planlanmalıdır. Köprüdeki koşullar uygun değilse aynı ilçe ve şehir içindeki alternatif rota dosyalarını karşılaştır.",
    points:[
      "İlk keşfi gündüz yap; atış öncesinde arka ve yan koridorun tamamen boş olduğundan emin ol.",
      "Çapariyi köprü üstünde savurmadan önce kurşun ağırlığını, takım uzunluğunu ve çevredeki misina hatlarını birlikte değerlendir.",
      "İskele, tekne manevrası, bakım veya güvenlik şeridi görülen bölümü av alanı kabul etme."
    ],
    links:[
      {href:"/iller/istanbul/fatih/",label:"Fatih'te balık tutulacak yerler",note:"Galata Köprüsü dışındaki ilçe rotalarını karşılaştır."},
      {href:"/iller/istanbul/",label:"İstanbul'da balık tutulacak yerler",note:"Boğaz, Haliç, Marmara ve Karadeniz rotalarını incele."},
      {href:"/rehberler/kiyidan-capari-baslangic/",label:"Kıyıdan çapariye başlangıç",note:"Takım, atış ve toplama düzenini gözden geçir."},
      {href:"/baliklar/istavrit/",label:"İstavrit dosyası",note:"Yöntem, yem ve ilişkili avlak bağlantılarını gör."}
    ]
  },
  "/meralar/izmit-korfezi-sahil-bandi/":{
    eyebrow:"Kocaeli yerel av planı",
    title:"İzmit Körfezi sahil bandında rota nasıl daraltılır?",
    body:"Bu dosya tek bir iskeleyi değil, İzmit Marina ile 1 Mart Vapur İskelesi çevresindeki genel kent sahilini anlatır. Güvenli bölüm; vapur operasyonu, yaya-bisiklet yoğunluğu, rüzgâr ve kıyı düzenlemesine göre ziyaret günü yeniden seçilmelidir.",
    points:[
      "Marina, vapur iskelesi, Balıkhan ve kapalı güvenlik bölümlerini av rotasının dışında tut.",
      "İş çıkışı ve gün batımı yoğunluğunda çapari veya ağır kurşun kullanmadan önce arka atış alanını yeniden kontrol et.",
      "Lodos ve vapur geçişlerinin oluşturabileceği kısa dalga hareketini kıyıya yaklaşmadan önce gözle."
    ],
    links:[
      {href:"/iller/kocaeli/izmit/",label:"İzmit'te balık tutulacak yerler",note:"Aynı ilçedeki diğer kıyı ve iç su dosyalarını karşılaştır."},
      {href:"/iller/kocaeli/",label:"Kocaeli'de balık tutulacak yerler",note:"Körfez, Karadeniz ve iç su seçeneklerini birlikte incele."},
      {href:"/rehberler/kiyidan-capari-baslangic/",label:"Kıyıdan çapariye başlangıç",note:"Kalabalık kent kıyısında takım ve atış disiplinini gözden geçir."},
      {href:"/baliklar/istavrit/",label:"İstavrit dosyası",note:"Çapari, yem ve mevsim bağlamını incele."}
    ]
  },
  "/meralar/sarimsakli-baraji-genel-amator-kiyi/":{
    eyebrow:"Arama niyeti · yol tarifi",
    title:"Sarımsaklı Barajı yol tarifini kullanırken hangi sınırlar önemli?",
    body:"Sarımsaklı Barajı kaydı Melikgazi yönünden genel kamusal kıyı yaklaşımını anlatır; yayımlanan pin tek bir araç girişi veya kesin av cebi değildir. Resmî amatör olta kullanım bilgisi güçlü olsa da baraj gövdesi, işletme ve ticari çalışma alanları rota dışındadır.",
    points:[
      "Haritadaki genel konumu son araç girişi sayma; kamusal yol, tabela ve fiilî erişimi gündüz yeniden kontrol et.",
      "Baraj gövdesi, işletme yapıları ile ağ ve tekne faaliyeti görülen kesime yönelme.",
      "Kıyıda geceleme veya tesis garantisi varsayma; günübirlik hazırlığı Kayseri kent merkezinden tamamla."
    ],
    links:[
      {href:"/iller/kayseri/",label:"Kayseri'de balık tutulacak yerler",note:"Kayseri içsularındaki diğer doğrulanmış rota dosyalarını karşılaştır."},
      {href:"/meralar/gumusoren-baraji-genel-amator-kiyi/",label:"Gümüşören Barajı",note:"Aynı ildeki başka bir genel amatör kıyı rotasının erişim ve mevzuat notlarını gör."},
      {href:"/meralar/bahcelik-baraji-resmi-amator-balikcilik-alani/",label:"Bahçelik Barajı",note:"Resmî amatör alan koordinatları bulunan alternatif Kayseri rotasını incele."},
      {href:"/rehberler/dip-oltasi-baslangic/",label:"Dip oltasına başlangıç",note:"İçsu kıyısında temel takım ve kurulum disiplinini gözden geçir."}
    ]
  },
  "/meralar/yamula-baraji-resmi-amator-balikcilik-alani/":{
    eyebrow:"Arama niyeti · balık tutma yeri",
    title:"Yamula Barajı’nda “balık tutma yeri” seçerken resmî alanı esas al",
    body:"Yamula için yalnızca genel baraj adı değil, Kayseri İl Tarım tarafından yayımlanmış amatör balıkçılık harita ve koordinatları bulunur. Bu yüzden rota planı rastgele kıyı yoluna değil, güncel resmî amatör alan sınırına dayanmalıdır.",
    points:[
      "Hareket günü resmî Yamula amatör alan haritası ve koordinatlarını yeniden kontrol et.",
      "Balık çiftliği, kafes, HES, tekne indirme veya ticari ağ çalışma alanını amatör kıyı rotası sayma.",
      "Harita bağlantısını güvenli son yaklaşım garantisi kabul etme; zemin ve kamusal geçişi sahada doğrula."
    ],
    links:[
      {href:"/iller/kayseri/",label:"Kayseri avlakları",note:"Yamula dışındaki Kayseri içsu seçeneklerini karşılaştır."},
      {href:"/meralar/bahcelik-baraji-resmi-amator-balikcilik-alani/",label:"Bahçelik Barajı",note:"Koordinatla tanımlanmış başka bir resmî amatör alanı incele."},
      {href:"/meralar/bayramhacili-baraji-amator-balikcilik-alani/",label:"Bayramhacılı Barajı",note:"Ticari ve amatör kullanım ayrımının açıklandığı alternatif rota dosyasını gör."},
      {href:"/baliklar/sazan/",label:"Sazan dosyası",note:"Tür, yöntem, yem ve ilişkili avlak bağlantılarını incele."}
    ]
  },
  "/meralar/tutunciftlik-sahil-parki/":{
    eyebrow:"Kocaeli · yol tarifi niyeti",
    title:"Tütünçiftlik Sahili’ne giderken rota ile av alanını ayır",
    body:"Tütünçiftlik aramalarında yol tarifi öne çıksa da sahil parkına ulaşmak ile güvenli olta alanı seçmek aynı şey değildir. Körfez kıyısında yaya kullanımı, kıyı düzeni ve deniz trafiği ziyaret saatine göre yeniden değerlendirilmelidir.",
    points:[
      "Navigasyonu sahil parkına yaklaşım için kullan; aktif iskele, tekne veya çalışma bölümünü av cebi sayma.",
      "Yaya ve rekreasyon yoğunluğu varsa uzun takım ve ağır kurşunla atış yapma; arkadaki koridor tamamen açık olmalı.",
      "Lodos ve kısa dalga koşullarında taş tahkimata gereksiz yaklaşma; kıyı güvenliği av planından önce gelir."
    ],
    links:[
      {href:"/iller/kocaeli/",label:"Kocaeli'de balık tutulacak yerler",note:"İzmit Körfezi ve çevresindeki alternatif rotaları karşılaştır."},
      {href:"/meralar/izmit-korfezi-sahil-bandi/",label:"İzmit Körfezi Sahil Bandı",note:"Kent kıyısındaki ulaşım, vapur trafiği ve güvenlik notlarını karşılaştır."},
      {href:"/meralar/hereke-sahili/",label:"Hereke Sahili",note:"Körfez ilçesindeki başka bir kamusal kıyı rotasını incele."},
      {href:"/baliklar/istavrit/",label:"İstavrit dosyası",note:"Körfez kıyısı için yöntem ve mevsim bağlamını incele."}
    ]
  },
  "/meralar/ulusal-adana-nergizlik-baraj-golu/":{
    eyebrow:"Arama niyeti · Nergizlik Barajı",
    title:"Nergizlik Barajı aramasında önce erişim ve doğrulama düzeyine bak",
    body:"Baraj adının arama sonuçlarında görünmesi, kıyının her bölümünün kamusal ve avlanmaya uygun olduğu anlamına gelmez. Nergizlik dosyasını genel su varlığı, mevcut kaynak gücü, saha teyidi ve güncel içsu mevzuatıyla birlikte değerlendir.",
    points:[
      "Genel koordinatı kesin araç girişi veya kıyı cebi gibi kullanma; son yaklaşımı gündüz ve tabelalara göre doğrula.",
      "Baraj işletme yapıları, özel geçişler veya güvenliği belirsiz kıyı bölümlerini rota dışında tut.",
      "Tür ve dönem bilgisini av garantisi sayma; 6/2 Tebliğ ve il bazlı güncel duyuruları hareket günü kontrol et."
    ],
    links:[
      {href:"/iller/adana/",label:"Adana'da balık tutulacak yerler",note:"İldeki diğer rota ve ilçe dosyalarını karşılaştır."},
      {href:"/meralar/ulusal-adana-seyhan-baraj-golu/",label:"Seyhan Baraj Gölü",note:"Daha fazla arama ve görüntüleme alan Adana içsu dosyasını incele."},
      {href:"/meralar/ulusal-adana-catalan-baraj-golu/",label:"Çatalan Baraj Gölü",note:"Aynı ildeki alternatif baraj dosyasını karşılaştır."},
      {href:"/rehberler/dip-oltasi-baslangic/",label:"Dip oltasına başlangıç",note:"İçsu kıyısında temel takım planını gözden geçir."}
    ]
  },
  "/meralar/seyhli-goleti-genel-amator-kiyi/":{
    eyebrow:"Arama niyeti · yol tarifi",
    title:"Şeyhli Göleti yol tarifinde son yaklaşımı neden ayrıca kontrol etmeli?",
    body:"Gölet için yayımlanan genel konum, araştırmayı başlatır fakat özel parsel, kapalı yol veya güvenli kıyı erişimini garanti etmez. Son yaklaşımın kamusal ve açık olduğuna emin olmadan navigasyon pinini doğrudan av noktası olarak kullanma.",
    points:[
      "İlk ziyareti gündüz yap; yol, park ve yaya yaklaşımının fiilen açık olduğunu sahada doğrula.",
      "Özel mülk, işletme, bakım yapısı veya kapalı geçiş işareti bulunan bölüme yönelme.",
      "İçsu türleri için dönem, boy, adet ve yem kısıtlarını hareket günü güncel mevzuattan kontrol et."
    ],
    links:[
      {href:"/iller/istanbul/",label:"İstanbul'da balık tutulacak yerler",note:"Deniz ve içsu rota seçeneklerini birlikte karşılaştır."},
      {href:"/meralar/",label:"Tüm avlak rotaları",note:"Su türü, il ve hedef balık filtreleriyle alternatif ara."},
      {href:"/rehberler/dip-oltasi-baslangic/",label:"Dip oltasına başlangıç",note:"Kıyı kurulumu ve temel takım dengesini gözden geçir."},
      {href:"/rehberler/samandirali-takim-kurma/",label:"Şamandıralı takım kurma",note:"Sığ ve kontrollü sunum için temel kurulum adımlarını incele."}
    ]
  },
  "/meralar/cubuklu-sahili/":{
    eyebrow:"Beykoz · Boğaz kıyısı",
    title:"Çubuklu Sahili’nde yol tarifi kadar operasyon sahası ayrımı da önemli",
    body:"Çubuklu kıyısında yolcu iskelesi ve arabalı vapur operasyonları, kamusal sahil kullanımından ayrı tutulmalıdır. Rota dosyasını kıyıya ulaşmak için değil, güvenli ve operasyon dışı bölümü seçmek için kullan.",
    points:[
      "Yolcu ve araç vapuru iskelelerinin yanaşma, bekleme ve güvenlik alanlarına olta taşırma.",
      "Boğaz akıntısı ve vapur geçişi kısa dalga oluşturabilir; taş kenara yaklaşmadan önce su hareketini gözle.",
      "Yaya hattında arkası boş olmayan bir noktada çapari veya ağır kurşunla atış yapma."
    ],
    links:[
      {href:"/iller/istanbul/beykoz/",label:"Beykoz balık tutma yerleri",note:"Aynı ilçedeki kıyıları hızlı karşılaştır."},
      {href:"/meralar/kanlica-sahili/",label:"Kanlıca Sahili",note:"Yakın Boğaz kıyısında farklı iskele ve akıntı bağlamını incele."},
      {href:"/meralar/pasabahce-sahili/",label:"Paşabahçe Sahili",note:"Rekreasyon kullanımı daha belirgin alternatif kıyı rotasını gör."},
      {href:"/baliklar/istavrit/",label:"İstavrit dosyası",note:"Çapari ve kıyı avı bağlamını incele."}
    ]
  },
  "/meralar/cengelkoy-sahili/":{
    eyebrow:"Üsküdar · Boğaz kıyısı",
    title:"Çengelköy Sahili’nde “yol tarifi” aramasını güvenli kıyı seçimiyle tamamla",
    body:"Çengelköy’de sahile ulaşmak kolay olabilir; asıl karar, iskele ve tekne hareketinden ayrılmış, yayaları tehlikeye atmayan kamusal kıyı bölümünü seçmektir. Akıntı ve kalabalık saatleri rota değerini aynı gün içinde değiştirebilir.",
    points:[
      "Aktif iskele ve yanaşma alanını av noktası kabul etme; açık kamusal kıyı bandını tercih et.",
      "Boğaz akıntısı güçlü olduğunda takım ağırlığını artırmadan önce çevre güvenliğini ve takılma riskini değerlendir.",
      "Sahil kalabalıksa atış koridoru açılmasını bekle veya yakın bir alternatif rotaya geç."
    ],
    links:[
      {href:"/iller/istanbul/",label:"İstanbul balık tutma yerleri",note:"Boğaz ve diğer kıyı seçeneklerini karşılaştır."},
      {href:"/meralar/beylerbeyi-sahili/",label:"Beylerbeyi Sahili",note:"Yakın Üsküdar kıyısındaki ulaşım ve iskele notlarını incele."},
      {href:"/meralar/kandilli-sahili/",label:"Kandilli Sahili",note:"Boğaz'ın başka bir Üsküdar kıyısında akıntı ve kamusal erişim bağlamını gör."},
      {href:"/baliklar/istavrit/",label:"İstavrit dosyası",note:"Kıyıdan çapari ve mevsim bağlamını incele."}
    ]
  },
  "/rehberler/sazan-icin-misir-hazirlama/":{
    eyebrow:"Hızlı uygulama özeti",
    title:"Sazan için mısır hazırlarken üç temel kontrol",
    body:"Mısırın amacı yalnızca iğnede durmak değildir; tane kıvamı, iğne açıklığı ve saklama koşulu birlikte doğru olmalıdır. Konserve ile kuru mısırı aynı hazırlık sürecine sokmak yerine, her birini kendi yapısına göre kontrol et.",
    points:[
      "Konserve mısırı süz; çatlamamış ve iğneye takılırken dağılmayan taneleri ayır.",
      "Kuru mısırı önce suyla yumuşat, ardından kontrollü biçimde haşla; sert çekirdek bırakma fakat taneleri hamur hâline getirme.",
      "Tekli veya çoklu sunumda iğne ucunu kapatma; kullanmadığın yemi güneşte bekletme ve bozulmuş yemi suya dökme."
    ],
    links:[
      {href:"/baliklar/sazan/",label:"Sazan balığı dosyası",note:"Habitat, yöntem, yem ve ilişkili avlakları incele."},
      {href:"/rehberler/dip-oltasi-baslangic/",label:"Dip oltasına başlangıç",note:"Kurşun, beden ve köstek dengesini kontrol et."},
      {href:"/rehberler/samandirali-takim-kurma/",label:"Şamandıralı takım kurma",note:"Derinlik ve yem sunumunu birlikte planla."},
      {href:"/meralar/",label:"Sazan rotalarını araştır",note:"Avlak arşivinde hedef balık filtresinden Sazan'ı seç."}
    ]
  }
};
const opportunity=opportunities[normalizedPath];
---
{isMeraDetail&&<section class="share-shell" aria-label="Avlak paylaşım araçları"><div class="container"><ShareToolbar title="Bu avlak sayfası" url={shareUrl}/></div></section>}
{opportunity&&<section class="seo-opportunity" aria-labelledby="seo-opportunity-title"><div class="container"><div class="seo-opportunity-copy"><span>{opportunity.eyebrow}</span><h2 id="seo-opportunity-title">{opportunity.title}</h2><p>{opportunity.body}</p><ul>{opportunity.points.map((point)=><li>{point}</li>)}</ul></div><nav class="seo-opportunity-links" aria-label="İlgili Olta Atlası içerikleri">{opportunity.links.map((link)=><a href={link.href}><strong>{link.label}</strong><small>{link.note}</small></a>)}</nav></div></section>}
<style>
.share-shell{padding:24px 0;background:#f7fbfb;border-top:1px solid #dce8e8}.seo-opportunity{background:#f0f7f7;border-top:1px solid #d7e7e8;border-bottom:1px solid #d7e7e8;padding:34px 0}.seo-opportunity>.container{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(300px,.85fr);gap:26px;align-items:start}.seo-opportunity-copy>span{display:block;color:#237381;font-size:.76rem;font-weight:900;letter-spacing:.12em;text-transform:uppercase}.seo-opportunity h2{color:#123e47;margin:.35rem 0 .7rem;font-size:clamp(1.5rem,3vw,2.15rem)}.seo-opportunity p{color:#49656a;line-height:1.7}.seo-opportunity ul{margin:18px 0 0;padding-left:20px}.seo-opportunity li{margin:9px 0;color:#294f56;line-height:1.55}.seo-opportunity-links{display:grid;gap:10px}.seo-opportunity-links a{display:block;background:#fff;border:1px solid #cfe0e2;border-radius:14px;padding:14px 16px;text-decoration:none;box-shadow:0 8px 18px #1439410a}.seo-opportunity-links strong,.seo-opportunity-links small{display:block}.seo-opportunity-links strong{color:#0b6574}.seo-opportunity-links small{color:#647d81;margin-top:4px;line-height:1.4}.seo-opportunity-links a:hover{border-color:#76abb3;transform:translateY(-1px)}@media(max-width:800px){.seo-opportunity>.container{grid-template-columns:1fr}.seo-opportunity{padding:26px 0}.share-shell{padding:18px 0}}
</style>