---
import BaseLayout from "../layouts/BaseLayout.astro";
import MeraCard from "../components/MeraCard.astro";
import Map from "../components/Map.astro";
import { meralar } from "../data/meralar-tumu";
import { baliklar, rehberler } from "../data/content-katalogu";
import { dunyaBalikcilikYazilari } from "../data/dunya-balikcilik";
const balikciGazetesiCount=2;
const totalPosts = meralar.length + baliklar.length + rehberler.length + dunyaBalikcilikYazilari.length + balikciGazetesiCount;
const istanbulCount=meralar.filter((m)=>m.province==="İstanbul").length;
const kocaeliCount=meralar.filter((m)=>m.province==="Kocaeli").length;
const provinceCount=new Set(meralar.map((m)=>m.province)).size;
const stronglyVerifiedProvinceCount=new Set(meralar.filter((m)=>m.confidence==="A"||m.confidence==="B").map((m)=>m.province)).size;
const nationalCoverageSufficient=provinceCount===81&&stronglyVerifiedProvinceCount===81;
const homeTitle=nationalCoverageSufficient?"Türkiye’de Balık Tutulacak Yerler ve Avlak Rehberi":"Türkiye Balıkçılık Rotaları ve Konum Rehberi";
const homeDescription=nationalCoverageSufficient
  ? "Türkiye’de balık tutulacak yerleri; rota, ulaşım, raporlanan türler, yöntemler, saha güvenliği ve kaynaklarla karşılaştır."
  : `${provinceCount} ilde ${meralar.length} balıkçılık rotası: konum, ulaşım, raporlanan türler, yöntemler, saha güvenliği, kaynak ve güven seviyesi.`;
const featuredMeralar=meralar.filter((route)=>route.confidence!=="D").sort((a,b)=>b.publishedAt.localeCompare(a.publishedAt)).slice(0,12);
---
<BaseLayout title={homeTitle} description={homeDescription}>
<section class="home-map-stage"><div class="container"><div class="map-stage-intro"><div><span class="kicker">{provinceCount} ilde kaynaklı rota ve konum rehberi</span><h1>{nationalCoverageSufficient?"Türkiye’de balık tutulacak yerler":"Türkiye genelinde balıkçılık rotaları"}</h1><p>Güven C kayıtları güçlü masa başı doğrulamayı gösterir. Güven D rotalarında da konum bilgisi sunulur; ancak son kıyı girişi, güncel av uygunluğu ve saha koşulları ayrıca kontrol edilmelidir.</p></div><div class="map-stage-actions" aria-label="Hızlı rota bağlantıları"><a class="button" href="/meralar/">Tüm rotaları filtrele</a><a class="button button-ghost" href="/iller/istanbul/">İstanbul</a><a class="button button-ghost" href="/iller/kocaeli/">Kocaeli</a></div></div><Map/></div></section>
<section class="hero home-hero"><div class="container hero-grid"><div><span class="kicker">Kaynaklı rota rehberi</span><h2>Haritadaki noktayı, sahaya çıkmadan önce tanı.</h2><p class="lead">İl ve ilçeye göre avlak, raporlanan balık türleri, kıyı karakteri, ulaşım, yöntem ve doğrulama bilgisini tek rotada bir araya getiriyoruz.</p><div class="hero-actions"><a class="button" href="/meralar/">Avlak arşivini aç</a><a class="button button-ghost" href="/rehberler/">Görselli rehberlere git</a><a class="button button-ghost" id="saved-routes-link" href="/meralar/?saved=1" hidden>★ Kaydettiklerim</a></div><div class="stats"><div><strong>{meralar.length}</strong><span>Rota ve konum dosyası</span></div><div><strong>{baliklar.length}</strong><span>Balık türü</span></div><div><strong>{rehberler.length}</strong><span>Uygulama rehberi</span></div><div><strong>{totalPosts}</strong><span>Toplam içerik</span></div></div></div><aside class="hero-card"><img class="hero-illustration" src="/images/site/og-default.svg" alt="Olta Atlası kıyı ve balıkçılık illüstrasyonu" width="1200" height="630"/><h2>Rota dosyasında ne var?</h2><ul class="check-list"><li>İlçe, kıyı yapısı ve toplu taşıma notu</li><li>Raporlanan tür, yöntem ve yem seçenekleri</li><li>Google, Apple, Yandex ve OSM navigasyon bağlantıları</li><li>Kaynak, güncelleme tarihi ve bilgi güveni</li></ul><p class="note">Raporlanan türler av garantisi değildir. Hassas ve işletme sınırı bulunan alanlarda konum genel erişim bölgesini gösterir.</p></aside></div></section>
<section class="city-entry-section"><div class="container city-entry-grid"><a href="/iller/istanbul/" class="city-entry-card featured"><span class="kicker">{istanbulCount} rota · Avrupa ve Anadolu Yakası</span><h2>İstanbul’da balık tutulacak yerler</h2><p>Boğaz kıyılarından Marmara sahiline uzanan ilçe bazlı rota merkezini aç.</p><strong>İstanbul rehberini aç →</strong></a><a href="/iller/kocaeli/" class="city-entry-card"><span class="kicker">{kocaeliCount} rota · Marmara, Karadeniz ve iç su</span><h2>Kocaeli’de balık tutulacak yerler</h2><p>İzmit Körfezi, Kandıra kıyıları ve iç su kayıtlarını güven seviyesiyle karşılaştır.</p><strong>Kocaeli rehberini aç →</strong></a></div></section>
<section class="container section"><div class="section-heading"><div><span class="kicker">Yeni ve güncellenen rotalar</span><h2>Öne çıkan 12 avlak</h2></div><a class="text-link" href="/meralar/">Bütün avlakları ara ve filtrele →</a></div><div class="card-grid">{featuredMeralar.map((mera)=><MeraCard mera={mera}/>)}</div></section>
<section class="container section article-prose"><div class="section-heading"><div><span class="kicker">Olta Atlası nasıl çalışır?</span><h2>Bir avlak sayfasını nasıl okumalı?</h2></div></div><div class="three-feature-grid"><div><strong>01 · Kaynak</strong><p>Resmî mevzuat, resmî kullanım doğrulaması, editör araştırması ve saha gözlemi birbirinden ayrılır.</p></div><div><strong>02 · Güven seviyesi</strong><p>A saha doğrulaması ve güçlü resmî kaynağı; B rota özelinde güçlü resmî kullanım kanıtını; C güçlü masa başı doğrulamayı; D ise genel konumu sunulan ancak mikro kıyı erişimi ve saha kanıtı daha sınırlı rotayı gösterir.</p></div><div><strong>03 · Konum hassasiyeti</strong><p>Navigasyon çoğu zaman yalnızca genel planlama konumunu açar. Kamusal giriş, iskele, marina, liman ve özel mülkiyet sınırı yerinde doğrulanır.</p></div></div></section>
<div class="container" style="padding:0 0 30px"><a class="text-link" href="/balikci-gazetesi/">Balıkçı Gazetesi →</a></div>
<section class="section soft-section"><div class="container two-column"><div><span class="kicker">Saha etiği</span><h2>Merayı göstermek, merayı tüketmek değildir.</h2><p>Hassas ve küçük alanlarda tam koordinat yayımlamıyoruz. Navigasyon bağlantıları çoğu kayıtta yalnızca genel planlama bölgesini açar.</p></div><div class="principle-list"><div><strong>01</strong><span>Misina, iğne ve çöpünü geri götür.</span></div><div><strong>02</strong><span>Güncel yasak ve limitleri doğrula.</span></div><div><strong>03</strong><span>Şüpheli bilgiyi kesin gerçek gibi paylaşma.</span></div></div></div></section>
<style is:global>
.home-map-stage{padding:32px 0 44px;background:radial-gradient(circle at 88% 12%,rgba(246,180,74,.24),transparent 28%),linear-gradient(145deg,#071f27,#0f5564);border-bottom:1px solid rgba(255,255,255,.08)}
.map-stage-intro{display:flex;justify-content:space-between;align-items:end;gap:28px;margin-bottom:24px;color:white}.map-stage-intro>div:first-child{max-width:900px}.map-stage-intro h1{font-size:clamp(2rem,4.3vw,4.2rem);max-width:880px;margin-bottom:.7rem}.map-stage-intro p{max-width:780px;margin:0;color:#d8ecef}.map-stage-intro .kicker{color:#f7c66f}.map-stage-actions{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:9px;max-width:360px}.map-stage-actions .button{min-height:44px;padding-inline:15px}.map-stage-actions .button-ghost{color:white}
.home-map-stage .map-shell{background:rgba(255,255,255,.97);border-color:rgba(255,255,255,.22);box-shadow:0 24px 70px rgba(0,0,0,.24)}.home-map-stage .map{height:min(52vh,520px);min-height:360px}.home-map-stage .section-heading{margin-bottom:20px}.home-hero h2{font-size:clamp(2.7rem,6vw,5.4rem);max-width:900px}
@media(max-width:760px){.home-map-stage{padding:22px 0 28px}.map-stage-intro{align-items:stretch;flex-direction:column}.map-stage-actions{display:grid;grid-template-columns:1fr 1fr;max-width:none}.map-stage-actions .button:first-child{grid-column:1/-1}.home-map-stage .map-shell{padding:14px}.home-map-stage .section-heading{display:block}.home-map-stage .section-heading p{margin-top:8px}.home-map-stage .map{height:330px;min-height:300px}.home-hero{padding-top:64px}}
</style>
<script is:inline>
const legacyKey="balikrotasi-favoriler",storageKey="oltaatlasi-favoriler";
const readSaved=()=>{try{const raw=localStorage.getItem(storageKey)||localStorage.getItem(legacyKey)||"[]";const parsed=JSON.parse(raw);return Array.isArray(parsed)?parsed.filter(Boolean):[];}catch{return [];}};
const saved=new Set(readSaved());
if(!localStorage.getItem(storageKey)&&saved.size)localStorage.setItem(storageKey,JSON.stringify([...saved]));
const savedLink=document.querySelector("#saved-routes-link");
const track=(name,params={})=>{if(typeof window.gtag==="function")window.gtag("event",name,params);};
const refresh=()=>{document.querySelectorAll("[data-bookmark]").forEach(button=>{const active=saved.has(button.dataset.bookmark);button.textContent=active?"★":"☆";button.setAttribute("aria-pressed",String(active));});if(savedLink){savedLink.hidden=saved.size===0;savedLink.textContent=`★ Kaydettiklerim (${saved.size})`;}};
document.querySelectorAll("[data-bookmark]").forEach(button=>button.addEventListener("click",()=>{const slug=button.dataset.bookmark;const wasSaved=saved.has(slug);wasSaved?saved.delete(slug):saved.add(slug);localStorage.setItem(storageKey,JSON.stringify([...saved]));refresh();track("route_bookmark",{route_slug:slug,action:wasSaved?"remove":"add",saved_count:saved.size});}));
document.addEventListener("click",event=>{const link=event.target instanceof Element?event.target.closest("a[href]"):null;if(!link)return;const href=link.getAttribute("href")||"";if(href.startsWith("/meralar/")||href.startsWith("/iller/")||href.startsWith("/rehberler/"))track("home_navigation",{destination:href,link_text:(link.textContent||"").trim().slice(0,80)});});
refresh();
</script>
</BaseLayout>
