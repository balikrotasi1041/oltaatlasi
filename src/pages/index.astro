---
import BaseLayout from "../layouts/BaseLayout.astro";
import MeraCard from "../components/MeraCard.astro";
import Map from "../components/Map.astro";
import { meralar, provinces, districtsByProvince, fishOptions, zonesByProvince } from "../data/meralar";
import { baliklar } from "../data/baliklar";
import { rehberler } from "../data/rehberler";
const totalPosts = meralar.length + baliklar.length + rehberler.length;
const istanbulCount=meralar.filter((m)=>m.province==="İstanbul").length;
const kocaeliCount=meralar.filter((m)=>m.province==="Kocaeli").length;
---
<BaseLayout title="Olta Atlası" description="İstanbul ve Kocaeli balık tutulacak yerler, balık türleri, ulaşım, navigasyon, takım ve saha güvenliği rehberi.">
<section class="hero"><div class="container hero-grid"><div><span class="kicker">İstanbul ve Kocaeli rota rehberi</span><h1>Balık tutulacak yeri yalnızca haritada değil, sahaya çıkmadan önce tanı.</h1><p class="lead">İl ve ilçeye göre mera, raporlanan balık türleri, kıyı karakteri, ulaşım, navigasyon, yöntem ve doğrulama bilgisini tek rotada bir araya getiriyoruz.</p><div class="hero-actions"><a class="button" href="#meralar">Meraları filtrele</a><a class="button button-ghost" href="/iller/istanbul/">İstanbul rehberini aç</a></div><div class="stats"><div><strong>{meralar.length}</strong><span>Mera dosyası</span></div><div><strong>{baliklar.length}</strong><span>Balık türü</span></div><div><strong>{rehberler.length}</strong><span>Uygulama rehberi</span></div><div><strong>{totalPosts}</strong><span>Toplam içerik</span></div></div></div><aside class="hero-card"><img class="hero-illustration" src="/images/site/og-default.svg" alt="Olta Atlası kıyı ve balıkçılık illüstrasyonu" width="1200" height="630"/><h2>Rota dosyasında ne var?</h2><ul class="check-list"><li>İlçe, kıyı yapısı ve toplu taşıma notu</li><li>Raporlanan tür, yöntem ve yem seçenekleri</li><li>Google, Apple, Yandex ve OSM navigasyon bağlantıları</li><li>Kaynak, güncelleme tarihi ve bilgi güveni</li></ul><p class="note">Raporlanan türler av garantisi değildir. Hassas ve işletme sınırı bulunan alanlarda konum genel erişim bölgesini gösterir.</p></aside></div></section>
<section class="city-entry-section"><div class="container city-entry-grid"><a href="/iller/istanbul/" class="city-entry-card featured"><span class="kicker">{istanbulCount} rota · Avrupa ve Anadolu Yakası</span><h2>İstanbul’da balık tutulacak yerler</h2><p>Galata ve Unkapanı köprülerinden Boğaz kıyılarına, Kadıköy’den Pendik’e Marmara sahiline uzanan ilçe bazlı rota merkezi.</p><strong>İstanbul rehberini aç →</strong></a><a href="/iller/kocaeli/" class="city-entry-card"><span class="kicker">{kocaeliCount} rota · Marmara, Karadeniz ve iç su</span><h2>Kocaeli’de balık tutulacak yerler</h2><p>İzmit Körfezi, Kandıra kıyıları ve iç su pilot kayıtlarını güven seviyesiyle karşılaştır.</p><strong>Kocaeli rehberini aç →</strong></a></div></section>
<section class="container section article-prose"><div class="section-heading"><div><span class="kicker">Olta Atlası nasıl çalışır?</span><h2>Bir mera sayfasını nasıl okumalı?</h2></div></div><div class="three-feature-grid"><div><strong>01 · Kaynak</strong><p>Resmî mevzuat, resmî kullanım doğrulaması, editör araştırması ve saha gözlemi birbirinden ayrılır.</p></div><div><strong>02 · Güven seviyesi</strong><p>A ve B daha güçlü doğrulamayı; C ve D ise güncel saha kontrolüne daha çok ihtiyaç olduğunu gösterir.</p></div><div><strong>03 · Konum hassasiyeti</strong><p>Navigasyon çoğu zaman kamusal genel erişimi açar. İskele, marina, liman ve özel mülkiyet sınırı yerinde doğrulanır.</p></div></div></section>
<section class="container section" id="meralar"><div class="section-heading"><div><span class="kicker">İl ve ilçeye göre arama</span><h2>Mera bul</h2></div><p id="result-count">{meralar.length} kayıt gösteriliyor</p></div>
<form class="filter-panel select-filters v4-filters" id="filters"><label><span>İl</span><select id="province"><option value="">Tüm iller</option>{provinces.map((p)=><option value={p}>{p}</option>)}</select></label><label><span>İlçe</span><select id="district" disabled><option value="">Önce il seçin</option></select></label><label><span>Yaka / bölge</span><select id="zone" disabled><option value="">Önce il seçin</option></select></label><label><span>Su türü</span><select id="water"><option value="">Tümü</option><option value="Deniz">Deniz</option><option value="Gölet">Gölet</option><option value="Göl">Göl</option><option value="Akarsu">Akarsu</option><option value="Baraj">Baraj</option></select></label><label><span>Hedef balık</span><select id="fish"><option value="">Tümü</option>{fishOptions.map((f)=><option value={f}>{f}</option>)}</select></label><button class="button button-ghost reset-button" type="button" id="reset">Filtreyi temizle</button></form>
<div class="filter-note">İl seçildiğinde ilçe ve yaka/bölge menüleri otomatik güncellenir. Filtreler yeni sayfa üretmez; Google’a indekslenecek kalıcı il ve ilçe sayfaları <a href="/iller/">İller</a> bölümündedir.</div><div class="empty-state" id="empty-state" hidden><span>🫧</span><h3>Bu filtrelerde kayıt bulunamadı.</h3><p>Bir seçeneği gevşet veya farklı hedef balık seç.</p></div><div class="card-grid" id="cards">{meralar.map((mera)=><MeraCard mera={mera}/>)}</div></section>
<div class="container section"><Map/></div>
<section class="section soft-section"><div class="container two-column"><div><span class="kicker">Saha etiği</span><h2>Merayı göstermek, merayı tüketmek değildir.</h2><p>Hassas ve küçük alanlarda tam koordinat yayımlamıyoruz. Navigasyon bağlantıları çoğu kayıtta güvenli genel erişim bölgesini açar.</p></div><div class="principle-list"><div><strong>01</strong><span>Misina, iğne ve çöpünü geri götür.</span></div><div><strong>02</strong><span>Güncel yasak ve limitleri doğrula.</span></div><div><strong>03</strong><span>Şüpheli bilgiyi kesin gerçek gibi paylaşma.</span></div></div></div></section>
<script is:inline define:vars={{districtsByProvince,zonesByProvince}}>
const filters=document.querySelector("#filters");filters?.addEventListener("submit",e=>e.preventDefault());const province=document.querySelector("#province"),district=document.querySelector("#district"),zone=document.querySelector("#zone"),water=document.querySelector("#water"),fish=document.querySelector("#fish"),cards=[...document.querySelectorAll("[data-card]")],resultCount=document.querySelector("#result-count"),emptyState=document.querySelector("#empty-state");
const fillSelect=(select,values,emptyLabel)=>{select.innerHTML="";const first=document.createElement("option");first.value="";first.textContent=values.length?emptyLabel:"Önce il seçin";select.appendChild(first);select.disabled=!values.length;values.forEach((name)=>{const option=document.createElement("option");option.value=name;option.textContent=name;select.appendChild(option);});};
const fillLocation=()=>{const selected=province.value;fillSelect(district,districtsByProvince[selected]||[],"Tüm ilçeler");fillSelect(zone,zonesByProvince[selected]||[],"Tüm bölgeler");};
const filterCards=()=>{let count=0;cards.forEach(card=>{const matches=(!province.value||card.dataset.province===province.value)&&(!district.value||card.dataset.district===district.value)&&(!zone.value||card.dataset.zone===zone.value)&&(!water.value||card.dataset.water===water.value)&&(!fish.value||(card.dataset.fish||"").split("|").includes(fish.value));card.hidden=!matches;if(matches)count++;});resultCount.textContent=`${count} kayıt gösteriliyor`;emptyState.hidden=count!==0;};
province.addEventListener("change",()=>{fillLocation();filterCards();});[district,zone,water,fish].forEach(field=>field.addEventListener("change",filterCards));document.querySelector("#reset").addEventListener("click",()=>{filters.reset();fillLocation();filterCards();});fillLocation();
const legacyKey="balikrotasi-favoriler";const storageKey="oltaatlasi-favoriler";const existing=localStorage.getItem(storageKey)||localStorage.getItem(legacyKey)||"[]";const saved=new Set(JSON.parse(existing));if(!localStorage.getItem(storageKey)&&localStorage.getItem(legacyKey))localStorage.setItem(storageKey,existing);const refresh=()=>document.querySelectorAll("[data-bookmark]").forEach(button=>{const active=saved.has(button.dataset.bookmark);button.textContent=active?"★":"☆";button.setAttribute("aria-pressed",String(active));});document.querySelectorAll("[data-bookmark]").forEach(button=>button.addEventListener("click",()=>{const slug=button.dataset.bookmark;saved.has(slug)?saved.delete(slug):saved.add(slug);localStorage.setItem(storageKey,JSON.stringify([...saved]));refresh();}));refresh();
</script></BaseLayout>
