---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { dunyaBalikcilikYazilari } from "../../data/dunya-balikcilik";
const posts=[...dunyaBalikcilikYazilari].sort((a,b)=>b.publishedAt.localeCompare(a.publishedAt));
---
<BaseLayout title="Dünyada Balıkçılık" description="Dünyanın farklı kıyı ve iç sularından, kaynağı doğrulanmış günlük amatör balıkçılık hikâyeleri ve av kayıtları.">
<section class="page-hero world-hero"><div class="container world-hero-grid"><div><Breadcrumbs items={[{label:"Ana sayfa",href:"/"},{label:"Dünyada Balıkçılık"}]}/><span class="kicker">Günün avı, dünyanın bir köşesinden</span><h1>Dünyada Balıkçılık</h1><p class="lead">Balıkçıların kendi yayımladıkları av kayıtlarını, tür ve bölge bağlamıyla özgün olarak özetliyoruz. Fotoğraf kopyalamak yerine kaynağa yönlendiriyor, yalnızca izinli veya resmî gömülebilir medyayı kullanıyoruz.</p></div><img src="/images/site/dunyada-balikcilik.svg" alt="Dünya çevresinde balıkçılık rotalarını gösteren özgün Olta Atlası illüstrasyonu" width="1200" height="760"/></div></section>
<section class="container section"><div class="world-policy-grid"><article><span>01</span><h2>Kaynak görünür</h2><p>Her kayıtta balıkçının veya yayıncının adı, platformu, özgün gönderi bağlantısı ve kontrol tarihi açıkça yazılır.</p></article><article><span>02</span><h2>Fotoğraf kopyalanmaz</h2><p>Açık lisans veya yazılı izin yoksa üçüncü taraf görseli sunucumuza alınmaz. Yerine özgün Olta Atlası illüstrasyonu kullanılır.</p></article><article><span>03</span><h2>İzin izi tutulur</h2><p>CC lisansı, kamu malı kaydı, açık yazılı izin veya resmî platform gömme yöntemi yoksa medya yalnızca kaynak bağlantısıyla gösterilir.</p></article></div></section>
<section class="container section world-feed"><div class="section-heading"><div><span class="kicker">Günlük dünya günlüğü</span><h2>Son av hikâyeleri</h2></div><p>{posts.length} doğrulanmış kayıt</p></div>
{posts.length ? <div class="world-card-grid">{posts.map((post)=><article class="world-card"><a href={`/dunyada-balikcilik/${post.slug}/`} class="world-cover"><img src={post.cover} alt={`${post.country} ${post.species} avı için özgün Olta Atlası illüstrasyonu`} loading="lazy"/></a><div class="world-card-body"><div class="eyebrow-row"><span class="pill">{post.country}</span><span class="microcopy">{new Date(post.publishedAt).toLocaleDateString("tr-TR")}</span></div><h2><a href={`/dunyada-balikcilik/${post.slug}/`}>{post.title}</a></h2><p>{post.summary}</p><dl class="world-meta"><div><dt>Balık</dt><dd>{post.species}</dd></div><div><dt>Balıkçı</dt><dd>{post.angler}</dd></div><div><dt>Kaynak</dt><dd>{post.sourcePlatform}</dd></div></dl><a class="text-link" href={`/dunyada-balikcilik/${post.slug}/`}>Hikâyeyi aç →</a></div></article>)}</div> : <div class="world-empty"><span>🌍🎣</span><h2>İlk doğrulanmış dünya avı hazırlanıyor.</h2><p>Bu bölüm sayı doldurmak için örnek av üretmez. Kaynağı, yayın tarihi ve medya kullanım hakkı doğrulanmış ilk kayıtla açılır.</p></div>}
</section>
<section class="section soft-section"><div class="container two-column"><div><span class="kicker">Telif ve kaldırma politikası</span><h2>Kaynak sahibinin hakkı, vitrinin önündedir.</h2><p>Bir içerik sahibi bağlantısının, adının veya izinli medyasının kaldırılmasını isterse kayıt incelenir ve gerekli işlem uygulanır. Lisans bilgisi belirsizleşen medya yayından kaldırılır.</p><a class="button" href="/iletisim/?konu=Telif%20ve%20i%C3%A7erik%20kald%C4%B1rma%20talebi">Telif veya kaldırma talebi gönder</a></div><div class="principle-list"><div><strong>01</strong><span>Kaynak gönderiden uzun metin kopyalanmaz; içerik özgün cümlelerle özetlenir.</span></div><div><strong>02</strong><span>Lisans adı, eser sahibi ve lisans bağlantısı birlikte tutulur.</span></div><div><strong>03</strong><span>YouTube içeriği yalnızca resmî oynatıcıyla ve yayıncı kimliği görünür biçimde gömülür.</span></div></div></div></section>
</BaseLayout>
