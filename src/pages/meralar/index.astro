---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import MeraCard from "../../components/MeraCard.astro";
import { meralar, provinces, districtsByProvince, fishOptions, zonesByProvince } from "../../data/meralar-tumu";
const pageSize=18;
const verifiedRouteCount=meralar.filter((route)=>route.confidence!=="D").length;
---
<BaseLayout title="Balık Tutulacak Yerler ve Avlaklar" description="Türkiye'nin 81 ilinde kaynak, güven seviyesi ve saha kontrol notlarıyla sunulan balıkçılık rota ve avlak arşivi.">
<section class="page-hero"><div class="container"><Breadcrumbs items={[{label:"Ana sayfa",href:"/"},{label:"Meralar"}]}/><span class="kicker">{meralar.length} indekslenebilir rota · {verifiedRouteCount} güçlü dosya · {meralar.length-verifiedRouteCount} araştırma başlangıcı</span><h1>Balık tutulacak yerler ve rota araştırmaları</h1><p class="lead">81 ildeki tüm kayıtları il, ilçe, su türü, bölge, kanıt seviyesi ve raporlanan ya da araştırılan balığa göre ara. Güven seviyesi görünürlüğü değil, kanıt kapsamını gösterir.</p></div></section>
<section class="container section" id="meralar">
  <div class="archive-toolbar">
    <label class="search-field"><span>Avlak ara</span><input id="search" type="search" placeholder="Örn. Adana, baraj, sahil" autocomplete="off"/></label>
    <button class="archive-saved-button" id="saved-only" type="button" aria-pressed="false"><span aria-hidden="true">★</span> Kaydettiklerim <span id="saved-count"></span></button>
    <div class="quick-chips" aria-label="Hızlı il filtreleri"><button type="button" data-quick-province="">Tümü</button>{provinces.map((province)=><button type="button" data-quick-province={province}>{province}</button>)}</div>
  </div>
  <div class="section-heading"><div><span class="kicker">Ayrıntılı filtre</span><h2>Arşivi daralt</h2></div><p id="result-count" role="status" aria-live="polite">{Math.min(pageSize,meralar.length)} / {meralar.length} kayıt gösteriliyor</p></div>
  <form class="filter-panel select-filters v4-filters" id="filters"><label><span>Kanıt seviyesi</span><select id="confidence"><option value="" selected>Tüm kayıtlar</option><option value="verified">Güçlü dosyalar (A–C)</option><option value="D">Araştırma başlangıcı (D)</option><option value="A">Yalnız A</option><option value="B">Yalnız B</option><option value="C">Yalnız C</option></select></label><label><span>İl</span><select id="province"><option value="">Tüm iller</option>{provinces.map((p)=><option value={p}>{p}</option>)}</select></label><label><span>İlçe</span><select id="district" disabled><option value="">Önce il seçin</option></select></label><label><span>Bölge</span><select id="zone" disabled><option value="">Önce il seçin</option></select></label><label><span>Su türü</span><select id="water"><option value="">Tümü</option><option value="Deniz">Deniz</option><option value="Gölet">Gölet</option><option value="Göl">Göl</option><option value="Akarsu">Akarsu</option><option value="Baraj">Baraj</option></select></label><label><span>Hedef balık</span><select id="fish"><option value="">Tümü</option>{fishOptions.map((f)=><option value={f}>{f}</option>)}</select></label><button class="button button-ghost reset-button" type="button" id="reset">Filtreyi temizle</button></form>
  <div class="empty-state" id="empty-state" hidden><span>🫧</span><h3>Bu filtrelerde kayıt bulunamadı.</h3><p>Arama sözcüğünü veya filtrelerden birini gevşet.</p></div>
  <div class="card-grid" id="cards">{meralar.map((mera,index)=><div class="archive-card-wrap" data-index={index}><MeraCard mera={mera}/></div>)}</div>
  <div class="load-more-wrap"><button class="button" id="load-more" type="button">18 kayıt daha göster</button></div>
</section>
<style>
.archive-toolbar{display:grid;grid-template-columns:minmax(240px,1fr) auto;gap:12px 16px;align-items:end;margin-bottom:26px}.archive-toolbar .search-field{display:grid;gap:7px;color:var(--muted);font-size:.8rem;font-weight:800}.archive-toolbar .search-field input{width:100%;min-height:48px;padding:12px 14px;border:1px solid var(--line);border-radius:13px;background:#fff;color:var(--ink);outline:none}.archive-toolbar .search-field input:focus{border-color:var(--sea-2);box-shadow:0 0 0 3px rgba(18,87,106,.1)}.archive-saved-button,.quick-chips button{min-height:42px;padding:8px 13px;border:1px solid var(--line);border-radius:999px;background:#fff;color:var(--sea);font-weight:850;white-space:nowrap}.archive-saved-button{min-height:48px;border-radius:13px}.archive-saved-button[aria-pressed="true"],.quick-chips button.is-active{background:var(--sea);border-color:var(--sea);color:#fff}.archive-saved-button:disabled{opacity:.48;cursor:not-allowed}.quick-chips{grid-column:1/-1;display:flex;gap:8px;overflow-x:auto;padding:2px 0 6px;scrollbar-width:thin;overscroll-behavior-inline:contain}.load-more-wrap{display:flex;justify-content:center;padding-top:30px}.archive-card-wrap[hidden]{display:none}@media(max-width:760px){.archive-toolbar{grid-template-columns:1fr}.archive-saved-button{width:100%}.quick-chips{grid-column:1}.section-heading{align-items:flex-start;flex-direction:column;gap:8px}.section-heading #result-count{margin:0}}
</style>
<script is:inline define:vars={{districtsByProvince,zonesByProvince,pageSize}}>
const filters=document.querySelector("#filters"),search=document.querySelector("#search"),confidence=document.querySelector("#confidence"),province=document.querySelector("#province"),district=document.querySelector("#district"),zone=document.querySelector("#zone"),water=document.querySelector("#water"),fish=document.querySelector("#fish"),wraps=[...document.querySelectorAll(".archive-card-wrap")],count=document.querySelector("#result-count"),empty=document.querySelector("#empty-state"),loadMore=document.querySelector("#load-more"),savedOnlyButton=document.querySelector("#saved-only"),savedCount=document.querySelector("#saved-count");
let visibleLimit=pageSize,savedOnly=false;
filters?.addEventListener("submit",event=>event.preventDefault());
const normalize=value=>(value||"").toLocaleLowerCase("tr-TR").normalize("NFD").replace(/[\u0300-\u036f]/g,"");
const legacyKey="balikrotasi-favoriler",storageKey="oltaatlasi-favoriler";
const readSaved=()=>{try{const raw=localStorage.getItem(storageKey)||localStorage.getItem(legacyKey)||"[]";const parsed=JSON.parse(raw);return Array.isArray(parsed)?parsed.filter(Boolean):[];}catch{return [];}};
const saved=new Set(readSaved());
if(!localStorage.getItem(storageKey)&&saved.size)localStorage.setItem(storageKey,JSON.stringify([...saved]));
const track=(name,params={})=>{if(typeof window.gtag==="function")window.gtag("event",name,params);};
const optionExists=(select,value)=>[...select.options].some(option=>option.value===value);
const setSelect=(select,value)=>{if(value&&optionExists(select,value))select.value=value;};
const fillSelect=(select,values,label)=>{select.innerHTML="";const option=document.createElement("option");option.value="";option.textContent=values.length?label:"Önce il seçin";select.appendChild(option);select.disabled=!values.length;values.forEach(value=>{const item=document.createElement("option");item.value=value;item.textContent=value;select.appendChild(item);});};
const fillLocation=()=>{fillSelect(district,districtsByProvince[province.value]||[],"Tüm ilçeler");fillSelect(zone,zonesByProvince[province.value]||[],"Tüm bölgeler");};
const applyUrlState=()=>{const params=new URLSearchParams(location.search);search.value=params.get("q")||"";setSelect(confidence,params.get("confidence")||"");setSelect(province,params.get("province")||"");fillLocation();setSelect(district,params.get("district")||"");setSelect(zone,params.get("zone")||"");setSelect(water,params.get("water")||"");setSelect(fish,params.get("fish")||"");savedOnly=params.get("saved")==="1"&&saved.size>0;};
const syncUrl=()=>{const params=new URLSearchParams();const values=[["q",search.value.trim()],["confidence",confidence.value],["province",province.value],["district",district.value],["zone",zone.value],["water",water.value],["fish",fish.value]];values.forEach(([key,value])=>{if(value)params.set(key,value);});if(savedOnly)params.set("saved","1");const query=params.toString();history.replaceState(null,"",`${location.pathname}${query?`?${query}`:""}${location.hash}`);};
const getMatches=()=>{const query=normalize(search.value);return wraps.filter(wrap=>{const card=wrap.querySelector("[data-card]");const haystack=normalize(`${card.dataset.province} ${card.dataset.district} ${card.dataset.zone} ${card.dataset.water} ${card.dataset.fish} ${card.textContent}`);const confidenceMatch=!confidence.value||(confidence.value==="verified"?card.dataset.confidence!=="D":card.dataset.confidence===confidence.value);const savedMatch=!savedOnly||saved.has(card.dataset.slug);return savedMatch&&confidenceMatch&&(!query||haystack.includes(query))&&(!province.value||card.dataset.province===province.value)&&(!district.value||card.dataset.district===district.value)&&(!zone.value||card.dataset.zone===zone.value)&&(!water.value||card.dataset.water===water.value)&&(!fish.value||(card.dataset.fish||"").split("|").includes(fish.value));});};
const refreshBookmarks=()=>{document.querySelectorAll("[data-bookmark]").forEach(button=>{const active=saved.has(button.dataset.bookmark);button.textContent=active?"★":"☆";button.setAttribute("aria-pressed",String(active));});savedCount.textContent=saved.size?`(${saved.size})`:"";savedOnlyButton.disabled=saved.size===0;savedOnlyButton.setAttribute("aria-pressed",String(savedOnly));};
const refreshQuickChips=()=>document.querySelectorAll("[data-quick-province]").forEach(item=>item.classList.toggle("is-active",item.dataset.quickProvince===province.value));
const render=()=>{const matches=getMatches();wraps.forEach(wrap=>wrap.hidden=true);matches.slice(0,visibleLimit).forEach(wrap=>wrap.hidden=false);count.textContent=`${Math.min(visibleLimit,matches.length)} / ${matches.length} kayıt gösteriliyor${savedOnly?" · kaydedilenler":""}`;empty.hidden=matches.length!==0;if(matches.length===0){empty.querySelector("h3").textContent=savedOnly?"Kaydedilmiş rotalar bu filtrelerle eşleşmedi.":"Bu filtrelerde kayıt bulunamadı.";empty.querySelector("p").textContent=savedOnly?"Filtreleri gevşet veya yıldızladığın rotalara yeni bir kayıt ekle.":"Arama sözcüğünü veya filtrelerden birini gevşet.";}loadMore.hidden=matches.length<=visibleLimit;refreshBookmarks();refreshQuickChips();};
const commit=(eventName,eventParams={})=>{visibleLimit=pageSize;render();syncUrl();if(eventName)track(eventName,eventParams);};
applyUrlState();render();syncUrl();
province.addEventListener("change",()=>{fillLocation();commit("route_filter",{filter_name:"province",filter_value:province.value||"all"});});
[confidence,district,zone,water,fish].forEach(field=>field.addEventListener("change",()=>commit("route_filter",{filter_name:field.id,filter_value:field.value||"all"})));
search.addEventListener("input",()=>{visibleLimit=pageSize;render();syncUrl();});
search.addEventListener("change",()=>{const query=search.value.trim();if(query)track("route_search",{query_length:Math.min(query.length,80)});});
loadMore.addEventListener("click",()=>{visibleLimit+=pageSize;render();track("route_load_more",{visible_limit:visibleLimit});});
document.querySelector("#reset").addEventListener("click",()=>{filters.reset();search.value="";savedOnly=false;fillLocation();commit("route_filter_reset");});
document.querySelectorAll("[data-quick-province]").forEach(button=>button.addEventListener("click",()=>{province.value=button.dataset.quickProvince;fillLocation();commit("route_quick_province",{province:province.value||"all"});}));
savedOnlyButton.addEventListener("click",()=>{if(!saved.size)return;savedOnly=!savedOnly;commit("saved_routes_filter",{enabled:savedOnly?1:0,saved_count:saved.size});});
document.querySelectorAll("[data-bookmark]").forEach(button=>button.addEventListener("click",()=>{const slug=button.dataset.bookmark;const wasSaved=saved.has(slug);wasSaved?saved.delete(slug):saved.add(slug);localStorage.setItem(storageKey,JSON.stringify([...saved]));if(savedOnly&&!saved.size)savedOnly=false;render();syncUrl();track("route_bookmark",{route_slug:slug,action:wasSaved?"remove":"add",saved_count:saved.size});}));
document.querySelector("#cards")?.addEventListener("click",event=>{const link=event.target instanceof Element?event.target.closest('a[href^="/meralar/"]'):null;if(!link)return;const card=link.closest("[data-card]");track("route_open",{route_slug:card?.dataset.slug||"unknown",source:"archive"});});
</script>
</BaseLayout>
