---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import MeraCard from "../../components/MeraCard.astro";
import { meralar, provinces, districtsByProvince, fishOptions, zonesByProvince } from "../../data/meralar-tumu";
const pageSize=18;
const verifiedRouteCount=meralar.filter((route)=>route.confidence!=="D").length;
---
<BaseLayout title="Balık Tutulacak Yerler ve Avlaklar" description="Türkiye'nin 81 ilinde kaynak, güven seviyesi ve saha kontrol notlarıyla sunulan balıkçılık rota ve avlak arşivi.">
<section class="page-hero"><div class="container"><Breadcrumbs items={[{label:"Ana sayfa",href:"/"},{label:"Meralar"}]}/><span class="kicker">{meralar.length} indekslenebilir rota · {verifiedRouteCount} güçlü dosya · {meralar.length-verifiedRouteCount} araştırma başlangıcı</span><h1>Balık tutulacak yerler ve rota araştırmaları</h1><p class="lead">81 ildeki tüm kayıtları il, ilçe, su türü, bölge, kanıt seviyesi ve raporlanan ya da araştırılan balığa göre ara. Güven seviyesi görünürlüğü değil, kanıt kapsamını gösterir.</p></div></section>
<section class="container section" id="meralar"><div class="archive-toolbar"><label class="search-field"><span>Avlak ara</span><input id="search" type="search" placeholder="Örn. Adana, baraj, sahil" autocomplete="off"/></label><div class="quick-chips" aria-label="Hızlı il filtreleri"><button type="button" data-quick-province="">Tümü</button>{provinces.map((province)=><button type="button" data-quick-province={province}>{province}</button>)}</div></div><div class="section-heading"><div><span class="kicker">Ayrıntılı filtre</span><h2>Arşivi daralt</h2></div><p id="result-count">{Math.min(pageSize,meralar.length)} / {meralar.length} kayıt gösteriliyor</p></div>
<form class="filter-panel select-filters v4-filters" id="filters"><label><span>Kanıt seviyesi</span><select id="confidence"><option value="" selected>Tüm kayıtlar</option><option value="verified">Güçlü dosyalar (A–C)</option><option value="D">Araştırma başlangıcı (D)</option><option value="A">Yalnız A</option><option value="B">Yalnız B</option><option value="C">Yalnız C</option></select></label><label><span>İl</span><select id="province"><option value="">Tüm iller</option>{provinces.map((p)=><option value={p}>{p}</option>)}</select></label><label><span>İlçe</span><select id="district" disabled><option value="">Önce il seçin</option></select></label><label><span>Bölge</span><select id="zone" disabled><option value="">Önce il seçin</option></select></label><label><span>Su türü</span><select id="water"><option value="">Tümü</option><option value="Deniz">Deniz</option><option value="Gölet">Gölet</option><option value="Göl">Göl</option><option value="Akarsu">Akarsu</option><option value="Baraj">Baraj</option></select></label><label><span>Hedef balık</span><select id="fish"><option value="">Tümü</option>{fishOptions.map((f)=><option value={f}>{f}</option>)}</select></label><button class="button button-ghost reset-button" type="button" id="reset">Filtreyi temizle</button></form>
<div class="empty-state" id="empty-state" hidden><span>🫧</span><h3>Bu filtrelerde kayıt bulunamadı.</h3><p>Arama sözcüğünü veya filtrelerden birini gevşet.</p></div><div class="card-grid" id="cards">{meralar.map((mera,index)=><div class="archive-card-wrap" data-index={index}><MeraCard mera={mera}/></div>)}</div><div class="load-more-wrap"><button class="button" id="load-more" type="button">18 kayıt daha göster</button></div></section>
<script is:inline define:vars={{districtsByProvince,zonesByProvince,pageSize}}>
const filters=document.querySelector("#filters"),search=document.querySelector("#search"),confidence=document.querySelector("#confidence"),province=document.querySelector("#province"),district=document.querySelector("#district"),zone=document.querySelector("#zone"),water=document.querySelector("#water"),fish=document.querySelector("#fish"),wraps=[...document.querySelectorAll(".archive-card-wrap")],count=document.querySelector("#result-count"),empty=document.querySelector("#empty-state"),loadMore=document.querySelector("#load-more");let visibleLimit=pageSize;
filters?.addEventListener("submit",event=>event.preventDefault());
const normalize=value=>(value||"").toLocaleLowerCase("tr-TR").normalize("NFD").replace(/[\u0300-\u036f]/g,"");
const fillSelect=(select,values,label)=>{select.innerHTML="";const option=document.createElement("option");option.value="";option.textContent=values.length?label:"Önce il seçin";select.appendChild(option);select.disabled=!values.length;values.forEach(value=>{const item=document.createElement("option");item.value=value;item.textContent=value;select.appendChild(item);});};
const fillLocation=()=>{fillSelect(district,districtsByProvince[province.value]||[],"Tüm ilçeler");fillSelect(zone,zonesByProvince[province.value]||[],"Tüm bölgeler");};
const getMatches=()=>{const query=normalize(search.value);return wraps.filter(wrap=>{const card=wrap.querySelector("[data-card]");const haystack=normalize(`${card.dataset.province} ${card.dataset.district} ${card.dataset.zone} ${card.dataset.water} ${card.dataset.fish} ${card.textContent}`);const confidenceMatch=!confidence.value||(confidence.value==="verified"?card.dataset.confidence!=="D":card.dataset.confidence===confidence.value);return confidenceMatch&&(!query||haystack.includes(query))&&(!province.value||card.dataset.province===province.value)&&(!district.value||card.dataset.district===district.value)&&(!zone.value||card.dataset.zone===zone.value)&&(!water.value||card.dataset.water===water.value)&&(!fish.value||(card.dataset.fish||"").split("|").includes(fish.value));});};
const render=()=>{const matches=getMatches();wraps.forEach(wrap=>wrap.hidden=true);matches.slice(0,visibleLimit).forEach(wrap=>wrap.hidden=false);count.textContent=`${Math.min(visibleLimit,matches.length)} / ${matches.length} kayıt gösteriliyor`;empty.hidden=matches.length!==0;loadMore.hidden=matches.length<=visibleLimit;};
const resetLimit=()=>{visibleLimit=pageSize;render();};
province.addEventListener("change",()=>{fillLocation();resetLimit();});[confidence,district,zone,water,fish].forEach(field=>field.addEventListener("change",resetLimit));search.addEventListener("input",resetLimit);loadMore.addEventListener("click",()=>{visibleLimit+=pageSize;render();});document.querySelector("#reset").addEventListener("click",()=>{filters.reset();search.value="";fillLocation();resetLimit();});document.querySelectorAll("[data-quick-province]").forEach(button=>button.addEventListener("click",()=>{province.value=button.dataset.quickProvince;fillLocation();resetLimit();document.querySelectorAll("[data-quick-province]").forEach(item=>item.classList.toggle("is-active",item===button));}));fillLocation();render();
const legacyKey="balikrotasi-favoriler",storageKey="oltaatlasi-favoriler",existing=localStorage.getItem(storageKey)||localStorage.getItem(legacyKey)||"[]",saved=new Set(JSON.parse(existing));const refresh=()=>document.querySelectorAll("[data-bookmark]").forEach(button=>{const active=saved.has(button.dataset.bookmark);button.textContent=active?"★":"☆";button.setAttribute("aria-pressed",String(active));});document.querySelectorAll("[data-bookmark]").forEach(button=>button.addEventListener("click",()=>{const slug=button.dataset.bookmark;saved.has(slug)?saved.delete(slug):saved.add(slug);localStorage.setItem(storageKey,JSON.stringify([...saved]));refresh();}));refresh();
</script>
</BaseLayout>
