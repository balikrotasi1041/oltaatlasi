---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FeedbackButtons from "../../components/FeedbackButtons.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { meralar, districtRouteCounts } from "../../data/meralar-tumu";
import { baliklar } from "../../data/baliklar";
import { rehberler } from "../../data/rehber-katalogu";
import { slugifyTr } from "../../utils/slug";

export function getStaticPaths(){return meralar.map((mera)=>({params:{slug:mera.slug},props:{mera}}));}
const {mera}=Astro.props;
const preliminary=mera.confidence==="D";
const hasResearch=Boolean(mera.researchStatus);
const confidenceProfile=mera.confidenceProfile;
const confidenceDimensions=confidenceProfile?[
  {key:"identity",icon:"🧭",...confidenceProfile.identity},
  {key:"legal",icon:"⚖️",...confidenceProfile.legal},
  {key:"access",icon:"🥾",...confidenceProfile.access},
  {key:"species",icon:"🐟",...confidenceProfile.species},
  {key:"field",icon:"📍",...confidenceProfile.field},
]:[];
const confidenceLevelLabel:Record<string,string>={strong:"Güçlü kanıt",partial:"Kısmi kanıt",unverified:"Doğrulanmadı"};
const hasCoordinates=Number.isFinite(mera.lat)&&Number.isFinite(mera.lng);
const directionsVerified=hasCoordinates&&!preliminary&&mera.navigationVerified!==false;
const googleDirections=directionsVerified?`https://www.google.com/maps/dir/?api=1&destination=${mera.lat},${mera.lng}&travelmode=driving`:"";
const googlePoint=hasCoordinates?`https://www.google.com/maps/search/?api=1&query=${mera.lat},${mera.lng}`:"";
const appleMaps=directionsVerified?`https://maps.apple.com/?daddr=${mera.lat},${mera.lng}&dirflg=d`:"";
const yandexMaps=directionsVerified?`https://yandex.com/maps/?rtext=~${mera.lat},${mera.lng}&rtt=auto`:"";
const osmMaps=hasCoordinates?`https://www.openstreetmap.org/?mlat=${mera.lat}&mlon=${mera.lng}#map=13/${mera.lat}/${mera.lng}`:"";
const osmSearch=`https://www.openstreetmap.org/search?query=${encodeURIComponent(`${mera.name}, ${mera.province}, Türkiye`)}`;
const relatedFish=baliklar.filter((b)=>mera.fish.includes(b.name));
const provinceUrl=`/iller/${slugifyTr(mera.province)}/`;
const districtCount=districtRouteCounts[`${mera.province}|${mera.district}`] || 0;
const districtUrl=districtCount>=2?`/iller/${slugifyTr(mera.province)}/${slugifyTr(mera.district)}/`:`/iller/${slugifyTr(mera.province)}/#${slugifyTr(mera.district)}`;
const pagePath=`/meralar/${mera.slug}/`;
const pageUrl=new URL(pagePath,Astro.site).href;
const pageHeading=preliminary?`${mera.name} Ön Değerlendirme Rota Dosyası`:`${mera.name} Balık Avı Rehberi`;
const accessDisplay=hasResearch?mera.vehicleAccess:(preliminary?"Kontrol edilmeli":mera.vehicleAccess);
const fieldVerificationLabel=confidenceProfile?.field?.level==="strong"?"Güçlü saha kanıtı":confidenceProfile?.field?.level==="partial"?"Kısmi saha kanıtı":"Yayımlanmış saha teyidi yok";
const navigationPlanLabel=directionsVerified?"Doğrulanmış rota bağlantıları mevcut":hasCoordinates?"Genel planlama konumu; erişim noktası teyitsiz":"Kesin erişim noktası yayımlanmadı";
const fishPlanLabel=mera.fish.length>0?mera.fish.join(" · "):"Doğrulanmış tür listesi yayımlanmadı";
const amenitiesPlanLabel=mera.amenities.length>0?mera.amenities.slice(0,3).join(" · "):"Yakın imkânlar rota bazında teyit bekliyor";
const confidenceScore:Record<string,number>={A:4,B:3,C:2,D:0};
const toRad=(value:number)=>value*Math.PI/180;
const distanceKm=(a:any,b:any)=>{
  if(!Number.isFinite(a.lat)||!Number.isFinite(a.lng)||!Number.isFinite(b.lat)||!Number.isFinite(b.lng)) return Number.POSITIVE_INFINITY;
  const R=6371,dLat=toRad(b.lat-a.lat),dLng=toRad(b.lng-a.lng);
  const x=Math.sin(dLat/2)**2+Math.cos(toRad(a.lat))*Math.cos(toRad(b.lat))*Math.sin(dLng/2)**2;
  return 2*R*Math.atan2(Math.sqrt(x),Math.sqrt(1-x));
};
const routeScore=(candidate:any)=>{
  const overlap=candidate.fish.filter((name:string)=>mera.fish.includes(name)).length;
  const km=distanceKm(mera,candidate);
  let score=overlap*16+(confidenceScore[candidate.confidence]||0)*3;
  if(candidate.district===mera.district&&candidate.province===mera.province) score+=55;
  else if(candidate.province===mera.province) score+=35;
  if(candidate.waterType===mera.waterType) score+=7;
  if(km<=25) score+=30; else if(km<=75) score+=20; else if(km<=150) score+=10;
  if(candidate.confidence==="D") score-=10;
  return score;
};
const relatedRoutes=meralar.filter((candidate)=>candidate.slug!==mera.slug).map((candidate)=>({candidate,score:routeScore(candidate),km:distanceKm(mera,candidate)})).filter(({score})=>score>15).sort((a,b)=>b.score-a.score||a.km-b.km||(b.candidate.updatedAt||b.candidate.publishedAt).localeCompare(a.candidate.updatedAt||a.candidate.publishedAt)).slice(0,6);
const guideScore=(guide:any)=>{
  const overlap=guide.targetSpecies.filter((name:string)=>mera.fish.includes(name)).length;
  let score=overlap*35;
  if(guide.targetSpecies.includes("Genel kıyı türleri")&&mera.waterType==="Deniz") score+=18;
  if(guide.targetSpecies.includes("Genel kullanım")) score+=5;
  if(["Mera","Hava","Güvenlik","Navigasyon","Mevsim"].includes(guide.category)) score+=8;
  return score;
};
const relatedGuides=rehberler.map((guide)=>({guide,score:guideScore(guide)})).filter(({score})=>score>7).sort((a,b)=>b.score-a.score||b.guide.updatedAt.localeCompare(a.guide.updatedAt)).slice(0,5).map(({guide})=>guide);
const spatialCoverage=hasCoordinates?{"@type":"Place",name:`${mera.district}, ${mera.province}`,geo:{"@type":"GeoCoordinates",latitude:mera.lat,longitude:mera.lng}}:{"@type":"Place",name:`${mera.province}, Türkiye`};
const articleSchema={"@context":"https://schema.org","@type":"Article","@id":`${pageUrl}#article`,headline:pageHeading,description:mera.summary,image:[new URL(mera.socialImage,Astro.site).href,new URL(mera.image,Astro.site).href],datePublished:mera.publishedAt,dateModified:mera.updatedAt,inLanguage:"tr-TR",mainEntityOfPage:{"@type":"WebPage","@id":pageUrl},author:{"@type":"Organization","@id":`${new URL("/",Astro.site).href}#organization`,name:"Olta Atlası Editörlüğü"},publisher:{"@id":`${new URL("/",Astro.site).href}#organization`},about:mera.fish.map((name)=>({"@type":"Thing",name})),spatialCoverage};
---
<BaseLayout title={pageHeading} description={mera.summary} image={mera.socialImage} type="article" publishedAt={mera.publishedAt} modifiedAt={mera.updatedAt}>
<script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)}/>
<section class="detail-hero"><div class="container detail-grid"><div><Breadcrumbs items={[{label:"Ana sayfa",href:"/"},{label:mera.province,href:provinceUrl},{label:mera.district,href:districtUrl},{label:mera.name}]}/><div class="eyebrow-row"><span class="pill">{mera.province} · {mera.district}</span><span class="pill pill-muted">{mera.zone}</span><span class={`confidence confidence-${mera.confidence.toLowerCase()}`}>Güven {mera.confidence}</span>{hasResearch&&<span class="pill">{preliminary?"Ön araştırma kaydı":"Açık kaynak araştırması tamamlandı"}</span>}</div><h1>{pageHeading}</h1><p class="lead">{mera.summary}</p>{preliminary&&<div class="warning-box"><strong>Ön değerlendirme kaydı:</strong> Harita pini eşleşen su varlığının genel coğrafi konumunu gösterir. Kamusal kıyı girişi, güvenli yaklaşım, yol tarifi veya avlanma izni değildir.</div>}{hasResearch&&<div class="warning-box"><strong>Araştırma kapsamı:</strong> {mera.researchSummary}</div>}<div class="article-byline"><span>Olta Atlası Editörlüğü</span><span>İlk yayın: {new Date(mera.publishedAt).toLocaleDateString("tr-TR")}</span><span>Son güncelleme: {new Date(mera.updatedAt).toLocaleDateString("tr-TR")}</span></div><div class="detail-actions">{hasCoordinates?(directionsVerified?<a class="button" href={googleDirections} target="_blank" rel="noreferrer">Google Maps yol tarifi</a>:<a class="button" href={osmMaps} target="_blank" rel="noreferrer">Genel konumu aç</a>):<a class="button" href={osmSearch} target="_blank" rel="noreferrer">Açık haritada adı ara</a>}<button class="button button-ghost" id="copy-link" type="button">Bağlantıyı kopyala</button></div></div><aside class="status-card image-status"><img src={mera.image} alt={`${mera.name} rota karakterini anlatan özgün illüstrasyon`} width="1200" height="675"/><dl><div><dt>Doğrulama</dt><dd>{mera.verification}</dd></div><div><dt>Konum</dt><dd>{mera.locationPrecision}</dd></div><div><dt>Su</dt><dd>{mera.region}</dd></div><div><dt>Araç erişimi</dt><dd>{accessDisplay}</dd></div>{hasResearch&&<div><dt>Araştırma</dt><dd>{mera.researchStatus}</dd></div>}</dl></aside></div></section>
<section class="container section detail-content"><article class="content-main article-prose">
<section class="article-intro">{mera.longIntro.map((paragraph)=><p>{paragraph}</p>)}</section>
<nav class="on-page-nav" aria-label="Sayfa içeriği"><strong>Bu dosyada</strong><a href="#av-plani">Av planı</a>{confidenceProfile&&<a href="#guven-endeksi">Güven endeksi</a>}{hasResearch&&<a href="#arastirma">Araştırma kanıtları</a>}<a href="#kiyi">Kıyı yapısı</a><a href="#ulasim">Ulaşım</a><a href="#baliklar">Balıklar</a><a href="#planlama">Planlama</a>{relatedRoutes.length>0&&<a href="#yakin-rotalar">Yakın rotalar</a>}{relatedGuides.length>0&&<a href="#ilgili-rehberler">Rehberler</a>}<a href="#kaynaklar">Kaynaklar</a></nav>
<section class="source-box" id="av-plani"><span class="kicker">🎣 Av Planı</span><h2>Gitmeden önce hızlı bakış</h2><p>Bu kart, rota dosyasındaki doğrulanmış veya doğrulama durumu açıkça belirtilmiş bilgileri tek yerde toplar. Bilinmeyen alanlar tahminle doldurulmaz.</p><div class="info-grid"><section class="info-card"><span>🌊</span><h3>Su ve rota</h3><ul><li>Su türü: {mera.waterType}</li><li>Su / bölge: {mera.region}</li><li>Kıyı karakteri: {mera.shoreProfile}</li></ul></section><section class="info-card"><span>🐟</span><h3>Raporlanan türler</h3><p>{fishPlanLabel}</p><p class="microcopy">Tür listesi av garantisi değildir.</p></section><section class="info-card"><span>🚗</span><h3>Erişim</h3><ul><li>Araç erişimi: {accessDisplay}</li><li>Navigasyon: {navigationPlanLabel}</li><li>Konum hassasiyeti: {mera.locationPrecision}</li></ul></section><section class="info-card"><span>🏕️</span><h3>Kullanım ve imkânlar</h3><ul><li>Kamp: {mera.camping}</li><li>Yakın imkânlar: {amenitiesPlanLabel}</li></ul></section><section class="info-card"><span>🧭</span><h3>Doğrulama</h3><ul><li>Güven: {mera.confidence}</li><li>Saha teyidi: {fieldVerificationLabel}</li><li>Son kontrol: {new Date(mera.updatedAt).toLocaleDateString("tr-TR")}</li></ul></section><section class="info-card"><span>⚠️</span><h3>Öne çıkan riskler</h3>{mera.cautions.length>0?<ul>{mera.cautions.slice(0,3).map((i)=><li>{i}</li>)}</ul>:<p>Rota bazında ayrı risk notu yayımlanmadı; genel saha tedbirleri geçerlidir.</p>}</section></div><div class="warning-box"><h3>Gitmeden önce kontrol et</h3><p><strong>⚖️ Mevzuat</strong> → <strong>🌦️ hava ve rüzgâr</strong> → <strong>🌊 su durumu</strong> → <strong>🚗 erişim</strong> → <strong>🎣 ekipman</strong></p><p>Harita bağlantısı, tür kaydı veya geçmiş erişim bilgisi tek başına güncel avlanma izni ve güvenli giriş garantisi değildir.</p></div></section>
{confidenceProfile&&<section class="source-box confidence-profile" id="guven-endeksi"><span class="kicker">Kanıt modeli v1 · Son inceleme {new Date(confidenceProfile.reviewedAt).toLocaleDateString("tr-TR")}</span><h2>Güven {confidenceProfile.overall} nasıl oluştu?</h2><p>Tek bir güçlü kaynak bütün rotayı doğrulamaz. Kimlik, hukuk, erişim, tür ve saha kanıtı ayrı değerlendirilir; tür kaydı kıyıdan amatör av izni veya kamusal giriş kanıtı sayılmaz.</p><div class="confidence-dimension-grid">{confidenceDimensions.map((dimension)=><article class={`confidence-dimension confidence-dimension-${dimension.level}`}><div class="confidence-dimension-heading"><span aria-hidden="true">{dimension.icon}</span><div><small>{confidenceLevelLabel[dimension.level]}</small><h3>{dimension.label}</h3></div></div><p>{dimension.note}</p></article>)}</div></section>}
{hasResearch&&<section class="source-box" id="arastirma"><span class="kicker">{preliminary?"Ön araştırma ve aday kanıtlar":"Rota özelinde açık kaynak araştırması"}</span><h2>{preliminary?"Hangi bilgiler hâlâ doğrulama bekliyor?":"Hangi bilgiler doğrudan araştırıldı?"}</h2><p>{mera.researchSummary}</p>{mera.fishEvidence?.length>0&&<><h3>Balık türü kanıtları</h3><ul>{mera.fishEvidence.map((item)=><li><a href={item.sourceUrl} target="_blank" rel="noreferrer"><strong>{item.name}{item.scientificName?` (${item.scientificName})`:""}</strong></a><span>{item.evidenceLevel}: {item.note}</span></li>)}</ul></>}{mera.accessEvidence?.length>0&&<><h3>Ulaşım ve erişim araştırması</h3><ul>{mera.accessEvidence.map((item)=><li><a href={item.sourceUrl} target="_blank" rel="noreferrer"><strong>{item.label}</strong></a><span>{item.value} {item.note}</span></li>)}</ul></>}{mera.accommodationOptions?.length>0&&<><h3>Konaklama ve geceleme seçenekleri</h3><ul>{mera.accommodationOptions.map((item)=><li><a href={item.sourceUrl} target="_blank" rel="noreferrer"><strong>{item.name}</strong></a><span>{item.type}{Number.isFinite(item.distanceKm)?` · yaklaşık ${item.distanceKm} km`:""} · {item.note}</span></li>)}</ul></>}</section>}
<section class="info-block" id="kiyi"><span class="kicker">Kıyı karakteri</span><h2>{mera.name} nasıl bir rota?</h2><p>{mera.shoreProfile}</p><p>{mera.crowdNote}</p></section>
<section class="info-block navigation-block" id="ulasim"><span class="kicker">Ulaşım ve navigasyon</span><h2>Rotaya nasıl gidilir?</h2><p>{mera.transport}</p><p>{mera.navigationNote}</p>{directionsVerified?<div class="navigation-grid"><a href={googleDirections} target="_blank" rel="noreferrer"><strong>Google Maps</strong><span>Mevcut konumdan araç rotası</span></a><a href={appleMaps} target="_blank" rel="noreferrer"><strong>Apple Maps</strong><span>Apple cihazlarında yol tarifi</span></a><a href={yandexMaps} target="_blank" rel="noreferrer"><strong>Yandex Maps</strong><span>Koordinata araç rotası</span></a><a href={osmMaps} target="_blank" rel="noreferrer"><strong>OpenStreetMap</strong><span>Açık haritada konumu gör</span></a></div>:hasCoordinates?<div class="warning-box"><h3>Pin erişim noktası değildir</h3><p>Bu koordinat genel planlama konumudur. Araç rotası üretmek yasaklı, özel veya ulaşılamayan noktaya yöneltebilir.</p><div class="navigation-grid"><a href={osmMaps} target="_blank" rel="noreferrer"><strong>OpenStreetMap</strong><span>Genel konumu incele</span></a><a href={googlePoint} target="_blank" rel="noreferrer"><strong>Google Maps</strong><span>Genel noktayı aç</span></a></div></div>:<div class="warning-box"><h3>Kesin erişim noktası yayımlanmadı</h3><p>Yanlış yol tarifi, özel mülkiyet veya yasaklı alana yönlendirme riski nedeniyle doğrulanmamış koordinat vermiyoruz.</p><a href={osmSearch} target="_blank" rel="noreferrer">OpenStreetMap üzerinde ad ve il ile araştır</a></div>}<p class="microcopy">Harita bağlantısı yolun açık, kamuya ait ya da araçla geçilebilir olduğunu garanti etmez. Tabela, bariyer ve görevli talimatı üstündür.</p></section>
<section class="info-block" id="baliklar"><span class="kicker">Raporlanan veya araştırma adayı türler</span><h2>{mera.name} çevresinde hangi balıklar bulunabilir?</h2><p>{mera.seasonalNotes[0]}</p>{mera.fish.length>0?<><div class="tag-row" aria-label="Araştırılan balık türleri">{mera.fish.map((fish)=><span>{fish}</span>)}</div>{relatedFish.length>0&&<div class="related-fish-grid">{relatedFish.map((fish)=><a href={`/baliklar/${fish.slug}/`}><img src={fish.image} alt={`${fish.name} illüstrasyonu`} loading="lazy"/><span>{fish.name}</span></a>)}</div>}</>:<div class="warning-box"><p>Bu rota için kaynaklarla desteklenmiş tür listesi henüz yayımlanmadı.</p></div>}<p>{mera.seasonalNotes[1]}</p><p class="microcopy">Tür listesi av garantisi değildir; kanıt düzeyi ve güncellik rota dosyasına göre değişebilir.</p></section>
<div class="info-grid"><section class="info-card"><span>🧰</span><h2>{preliminary?"Araştırma adayı yöntemler":"Önerilen yöntemler"}</h2>{mera.methods.length>0?<ul>{mera.methods.map((i)=><li>{i}</li>)}</ul>:<p>Rota bazında doğrulanmış yöntem önerisi henüz yayımlanmadı.</p>}</section><section class="info-card"><span>🪱</span><h2>{preliminary?"Araştırma adayı yemler":"Yem ve sahteler"}</h2>{mera.baits.length>0?<ul>{mera.baits.map((i)=><li>{i}</li>)}</ul>:<p>Rota bazında doğrulanmış yem veya sahte önerisi henüz yayımlanmadı.</p>}</section><section class="info-card"><span>🚗</span><h2>Kullanım bilgisi</h2><ul><li>Araç erişimi: {accessDisplay}</li><li>Kamp: {mera.camping}</li><li>Konum hassasiyeti: {mera.locationPrecision}</li></ul></section><section class="info-card"><span>🏕️</span><h2>Yakın imkânlar</h2>{mera.amenities.length>0?<ul>{mera.amenities.map((i)=><li>{i}</li>)}</ul>:<p>Yakın hizmetler ve tesisler rota bazında doğrulanmayı bekliyor.</p>}</section></div>
<section class="info-block" id="planlama"><span class="kicker">Saha planı</span><h2>Gitmeden önce hangi kontroller yapılmalı?</h2>{mera.planningNotes.map((p)=><p>{p}</p>)}<div class="warning-box"><h3>Öne çıkan riskler</h3><ul>{mera.cautions.map((i)=><li>{i}</li>)}</ul></div></section>
{relatedRoutes.length>0&&<section class="info-block" id="yakin-rotalar"><span class="kicker">Yer ve konu yakınlığı</span><h2>{mera.name} sonrasında hangi rotalara bakılabilir?</h2><p>Öneriler aynı il/ilçe, yaklaşık coğrafi yakınlık, su türü ve ortak raporlanan balıklar birlikte puanlanarak seçilir. Liste av verimi sıralaması değildir.</p><div class="link-list">{relatedRoutes.map(({candidate,km})=><a href={`/meralar/${candidate.slug}/`}><strong>{candidate.name}</strong><span>{candidate.province} · {candidate.district} · {candidate.waterType}{Number.isFinite(km)&&directionsVerified&&candidate.navigationVerified!==false&&candidate.locationPrecision!=="Genel bölge"?` · yaklaşık ${Math.round(km)} km`:""} · Güven {candidate.confidence}</span></a>)}</div></section>}
{relatedGuides.length>0&&<section class="info-block" id="ilgili-rehberler"><span class="kicker">Hazırlık ve teknik</span><h2>Bu rota için ilgili rehberler</h2><div class="link-list">{relatedGuides.map((guide)=><a href={`/rehberler/${guide.slug}/`}><strong>{guide.title}</strong><span>{guide.category} · {guide.difficulty} · {guide.readingTime} dk</span></a>)}</div></section>}
<section class="source-box" id="kaynaklar"><span class="kicker">Kaynak ve yöntem</span><h2>Bu sayfa hangi bilgilere dayanıyor?</h2><p>Olta Atlası, su varlığının kayıtlardaki mevcudiyetini; kıyı erişimi, avlanma izni ve balık türü doğrulamasından ayrı değerlendirir.</p><ul>{mera.sources.map((source)=><li><a href={source.url} target="_blank" rel="noreferrer"><strong>{source.label}</strong></a><span>{source.note}</span></li>)}</ul><p class="microcopy">Saha doğrulaması bekleyen kayıtlar güven seviyesiyle işaretlenir.</p></section>
<FeedbackButtons title={pageHeading} contentKey={`mera:${mera.slug}`} path={pagePath} /></article>
<aside class="content-aside"><div class="aside-card sticky-card"><h2>Hızlı özet</h2><dl class="compact-dl"><div><dt>İl</dt><dd><a href={provinceUrl}>{mera.province}</a></dd></div><div><dt>İlçe</dt><dd><a href={districtUrl}>{mera.district}</a></dd></div><div><dt>Su türü</dt><dd>{mera.waterType}</dd></div><div><dt>Güven</dt><dd>{mera.confidence}</dd></div>{hasResearch&&<div><dt>Araştırma</dt><dd>{mera.researchStatus}</dd></div>}<div><dt>Son kontrol</dt><dd>{new Date(mera.updatedAt).toLocaleDateString("tr-TR")}</dd></div></dl></div><div class="aside-card"><h2>İçerik ağı</h2><a href={provinceUrl}>{mera.province} avlakları</a><br/><a href="/baliklar/">Balık türleri</a><br/><a href="/rehberler/">Balıkçılık rehberleri</a></div><div class="aside-card"><h2>Resmî kurallar</h2><a href="https://www.tarimorman.gov.tr/Konular/Su-Urunleri/Su-Urunleri-Avciligi" target="_blank" rel="noreferrer">Güncel tebliği aç</a></div><div class="aside-card"><h2>Hata mı gördün?</h2><p>Konum, tür veya ulaşım bilgisi değiştiyse editöre bildir.</p><a href={`/iletisim/?konu=Konum%20veya%20navigasyon%20hatası&sayfa=${encodeURIComponent(mera.name)}&url=${encodeURIComponent(pageUrl)}`}>Hata bildir</a></div></aside></section>
<script is:inline>document.querySelector("#copy-link")?.addEventListener("click",async(event)=>{await navigator.clipboard.writeText(location.href);event.currentTarget.textContent="Kopyalandı";});</script>
</BaseLayout>
