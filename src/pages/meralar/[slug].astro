---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FeedbackButtons from "../../components/FeedbackButtons.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { meralar, districtRouteCounts } from "../../data/meralar-tumu";
import { baliklar } from "../../data/baliklar";
import { rehberler } from "../../data/rehber-katalogu";
import { routeLocationOverrides20260815 } from "../../data/route-location-overrides-2026-08-15";
import { slugifyTr } from "../../utils/slug";

export function getStaticPaths(){return meralar.map((mera)=>({params:{slug:mera.slug},props:{mera}}));}
const {mera}=Astro.props;
const isLevelD=mera.confidence==="D";
const hasResearch=Boolean(mera.researchStatus);
const confidenceProfile=mera.confidenceProfile;
const locationOverride=routeLocationOverrides20260815[mera.slug];
const effectiveLat=locationOverride?.lat ?? mera.lat;
const effectiveLng=locationOverride?.lng ?? mera.lng;
const effectiveLocationPrecision=locationOverride?.precision ?? mera.locationPrecision;
const hasCoordinates=Number.isFinite(effectiveLat)&&Number.isFinite(effectiveLng);
const locationLabel=locationOverride?.label || `${mera.name} · ${mera.province}`;
const coordinateLabel=hasCoordinates?`${Number(effectiveLat).toFixed(5)}, ${Number(effectiveLng).toFixed(5)}`:"Su adı + il ile harita araması";
const locationNote=locationOverride?.note || (hasCoordinates
  ? "Gösterilen koordinat rota planlaması için genel konumdur; son kıyı girişi, park ve av yapılabilirlik ayrıca kontrol edilmelidir."
  : `${mera.name} için doğrulanmış tek bir koordinat yayımlanmadığından, harita bağlantıları su adını ${mera.province} ile birlikte aratır. Arama sonucu son kıyı erişimi veya avlanma izni anlamına gelmez.`);
const confidenceDimensions=confidenceProfile?[
  {key:"identity",icon:"🧭",...confidenceProfile.identity},
  {key:"legal",icon:"⚖️",...confidenceProfile.legal},
  {key:"access",icon:"🥾",...confidenceProfile.access},
  {key:"species",icon:"🐟",...confidenceProfile.species},
  {key:"field",icon:"📍",...confidenceProfile.field},
]:[];
const confidenceLevelLabel:Record<string,string>={strong:"Güçlü kanıt",partial:"Kısmi kanıt",unverified:"Doğrulanmadı"};
const directionsVerified=hasCoordinates&&!isLevelD&&mera.navigationVerified!==false&&!locationOverride;
const googleDirections=directionsVerified?`https://www.google.com/maps/dir/?api=1&destination=${effectiveLat},${effectiveLng}&travelmode=driving`:"";
const googlePoint=hasCoordinates?`https://www.google.com/maps/search/?api=1&query=${effectiveLat},${effectiveLng}`:"";
const googleSearch=`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${mera.name}, ${mera.province}, Türkiye`)}`;
const appleMaps=directionsVerified?`https://maps.apple.com/?daddr=${effectiveLat},${effectiveLng}&dirflg=d`:"";
const yandexMaps=directionsVerified?`https://yandex.com/maps/?rtext=~${effectiveLat},${effectiveLng}&rtt=auto`:"";
const osmMaps=hasCoordinates?`https://www.openstreetmap.org/?mlat=${effectiveLat}&mlon=${effectiveLng}#map=13/${effectiveLat}/${effectiveLng}`:"";
const osmSearch=`https://www.openstreetmap.org/search?query=${encodeURIComponent(`${mera.name}, ${mera.province}, Türkiye`)}`;
const relatedFish=baliklar.filter((b)=>mera.fish.includes(b.name));
const provinceUrl=`/iller/${slugifyTr(mera.province)}/`;
const districtCount=districtRouteCounts[`${mera.province}|${mera.district}`] || 0;
const districtUrl=districtCount>=2?`/iller/${slugifyTr(mera.province)}/${slugifyTr(mera.district)}/`:`/iller/${slugifyTr(mera.province)}/#${slugifyTr(mera.district)}`;
const pagePath=`/meralar/${mera.slug}/`;
const pageUrl=new URL(pagePath,Astro.site).href;
const pageHeading=isLevelD?`${mera.name} Balık Tutma ve Konum Rehberi`:`${mera.name} Balık Avı Rehberi`;
const draftLikeSummary=/ön değerlendirme|araştırma başlangıcı|su varlığı olarak eşleştirilmiş/i.test(mera.summary||"");
const displaySummary=isLevelD&&draftLikeSummary
  ? `${mera.name}, ${mera.province} için genel konumu, su tipini ve av öncesi saha kontrollerini bir araya getiren rota rehberidir. Harita bilgisi planlama içindir; son kıyı erişimi ve güncel avlanma koşulları yerinde kontrol edilmelidir.`
  : mera.summary;
const displayIntro=isLevelD?[
  `${mera.name}, ${mera.province} ilindeki ${mera.waterType.toLocaleLowerCase("tr-TR")} rotasını haritada bulmaya, genel erişim yönünü görmeye ve av öncesi kontrolleri planlamaya yardımcı olan bir konum ve balıkçılık rehberidir.`,
  `Güven D; mikro kıyı girişi, güncel av uygunluğu, tür ve saha koşullarının daha sınırlı doğrulandığını gösterir. Konumu planlama başlangıcı olarak kullan; tabela, koruma statüsü, özel mülkiyet ve güncel resmî kuralları hareket günü ayrıca kontrol et.`
]:mera.longIntro;
const accessDisplay=hasResearch?mera.vehicleAccess:(isLevelD?"Yerinde kontrol":mera.vehicleAccess);
const fieldVerificationLabel=confidenceProfile?.field?.level==="strong"?"Güçlü saha kanıtı":confidenceProfile?.field?.level==="partial"?"Kısmi saha kanıtı":"Yayımlanmış saha teyidi yok";
const navigationPlanLabel=directionsVerified?"Doğrulanmış rota bağlantıları mevcut":hasCoordinates?"Genel su konumu; son kıyı girişi ayrıca kontrol edilir":"Google Maps ve OSM üzerinde adla konum araması hazır";
const fishPlanLabel=mera.fish.length>0?mera.fish.join(" · "):"Rota özelinde kaynaklanmış tür listesi henüz yok";
const amenitiesPlanLabel=mera.amenities.length>0?mera.amenities.slice(0,3).join(" · "):"Yakın imkânlar rota bazında teyit bekliyor";
const confidenceScore:Record<string,number>={A:4,B:3,C:2,D:0};
const toRad=(value:number)=>value*Math.PI/180;
const distanceKm=(a:any,b:any)=>{
  if(!Number.isFinite(a.lat)||!Number.isFinite(a.lng)||!Number.isFinite(b.lat)||!Number.isFinite(b.lng)) return Number.POSITIVE_INFINITY;
  const R=6371,dLat=toRad(b.lat-a.lat),dLng=toRad(b.lng-a.lng);
  const x=Math.sin(dLat/2)**2+Math.cos(toRad(a.lat))*Math.cos(toRad(b.lat))*Math.sin(dLng/2)**2;
  return 2*R*Math.atan2(Math.sqrt(x),Math.sqrt(1-x));
};
const routeOrigin={...mera,lat:effectiveLat,lng:effectiveLng};
const routeScore=(candidate:any)=>{
  const overlap=candidate.fish.filter((name:string)=>mera.fish.includes(name)).length;
  const km=distanceKm(routeOrigin,candidate);
  let score=overlap*16+(confidenceScore[candidate.confidence]||0)*3;
  if(candidate.district===mera.district&&candidate.province===mera.province) score+=55;
  else if(candidate.province===mera.province) score+=35;
  if(candidate.waterType===mera.waterType) score+=7;
  if(km<=25) score+=30; else if(km<=75) score+=20; else if(km<=150) score+=10;
  if(candidate.confidence==="D") score-=10;
  return score;
};
const relatedRoutes=meralar.filter((candidate)=>candidate.slug!==mera.slug).map((candidate)=>({candidate,score:routeScore(candidate),km:distanceKm(routeOrigin,candidate)})).filter(({score})=>score>15).sort((a,b)=>b.score-a.score||a.km-b.km||(b.candidate.updatedAt||b.candidate.publishedAt).localeCompare(a.candidate.updatedAt||a.candidate.publishedAt)).slice(0,6);
const guideScore=(guide:any)=>{
  const overlap=guide.targetSpecies.filter((name:string)=>mera.fish.includes(name)).length;
  let score=overlap*35;
  if(guide.targetSpecies.includes("Genel kıyı türleri")&&mera.waterType==="Deniz") score+=18;
  if(guide.targetSpecies.includes("Genel kullanım")) score+=5;
  if(["Mera","Hava","Güvenlik","Navigasyon","Mevsim"].includes(guide.category)) score+=8;
  return score;
};
const relatedGuides=rehberler.map((guide)=>({guide,score:guideScore(guide)})).filter(({score})=>score>7).sort((a,b)=>b.score-a.score||b.guide.updatedAt.localeCompare(a.guide.updatedAt)).slice(0,5).map(({guide})=>guide);
const cleanDText=(value:string)=>isLevelD?String(value||"")
  .replace(/ön değerlendirme rota dosyası/gi,"konum ve rota rehberi")
  .replace(/ön değerlendirme kaydı/gi,"genel konum kaydı")
  .replace(/ön değerlendirme rotası/gi,"genel konumlu rota")
  .replace(/ön araştırma kaydı/gi,"kaynak taraması")
  .replace(/araştırma başlangıcı/gi,"genel konumlu rota")
  :value;
const seasonalNotes=(mera.seasonalNotes||[]).map(cleanDText);
const planningNotes=(mera.planningNotes||[]).map(cleanDText);
const sourceMap=new Map<string,any>();
for(const source of [...(locationOverride?.sources||[]),...(mera.sources||[])])if(source?.url&&!sourceMap.has(source.url))sourceMap.set(source.url,source);
const displaySources=[...sourceMap.values()];
const spatialCoverage=hasCoordinates?{"@type":"Place",name:locationLabel,geo:{"@type":"GeoCoordinates",latitude:effectiveLat,longitude:effectiveLng}}:{"@type":"Place",name:`${mera.name}, ${mera.province}, Türkiye`};
const articleSchema={"@context":"https://schema.org","@type":"Article","@id":`${pageUrl}#article`,headline:pageHeading,description:displaySummary,image:[new URL(mera.socialImage,Astro.site).href,new URL(mera.image,Astro.site).href],datePublished:mera.publishedAt,dateModified:mera.updatedAt,inLanguage:"tr-TR",mainEntityOfPage:{"@type":"WebPage","@id":pageUrl},author:{"@type":"Organization","@id":`${new URL("/",Astro.site).href}#organization`,name:"Olta Atlası Editörlüğü"},publisher:{"@id":`${new URL("/",Astro.site).href}#organization`},about:mera.fish.map((name)=>({"@type":"Thing",name})),spatialCoverage};
---
<BaseLayout title={pageHeading} description={displaySummary} image={mera.socialImage} type="article" publishedAt={mera.publishedAt} modifiedAt={mera.updatedAt}>
<script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)}/>
<section class="detail-hero"><div class="container detail-grid"><div><Breadcrumbs items={[{label:"Ana sayfa",href:"/"},{label:mera.province,href:provinceUrl},{label:mera.district,href:districtUrl},{label:mera.name}]}/><div class="eyebrow-row"><span class="pill">{mera.province} · {mera.district}</span><span class="pill pill-muted">{mera.zone}</span><span class={`confidence confidence-${mera.confidence.toLowerCase()}`}>Güven {mera.confidence}</span>{hasResearch&&<span class="pill">{isLevelD?"Konum ve kaynak taraması":"Açık kaynak araştırması tamamlandı"}</span>}</div><h1>{pageHeading}</h1><p class="lead">{displaySummary}</p>{isLevelD&&<div class="warning-box"><strong>Konum notu:</strong> {locationNote}</div>}{hasResearch&&<div class="warning-box"><strong>Araştırma kapsamı:</strong> {cleanDText(mera.researchSummary||"")}</div>}<div class="article-byline"><span>Olta Atlası Editörlüğü</span><span>İlk yayın: {new Date(mera.publishedAt).toLocaleDateString("tr-TR")}</span><span>Son güncelleme: {new Date(mera.updatedAt).toLocaleDateString("tr-TR")}</span></div><div class="detail-actions">{directionsVerified?<a class="button" href={googleDirections} target="_blank" rel="noreferrer">Google Maps yol tarifi</a>:hasCoordinates?<><a class="button" href={googlePoint} target="_blank" rel="noreferrer">Google Maps'te konumu aç</a><a class="button button-ghost" href={osmMaps} target="_blank" rel="noreferrer">OpenStreetMap'te aç</a></>:<><a class="button" href={googleSearch} target="_blank" rel="noreferrer">Google Maps'te konumu ara</a><a class="button button-ghost" href={osmSearch} target="_blank" rel="noreferrer">OpenStreetMap'te ara</a></>}<button class="button button-ghost" id="copy-link" type="button">Bağlantıyı kopyala</button></div></div><aside class="status-card image-status"><img src={mera.image} alt={`${mera.name} rota karakterini anlatan özgün illüstrasyon`} width="1200" height="675"/><dl><div><dt>Konum</dt><dd>{locationLabel}</dd></div><div><dt>Koordinat</dt><dd>{coordinateLabel}</dd></div><div><dt>Hassasiyet</dt><dd>{effectiveLocationPrecision}</dd></div><div><dt>Su</dt><dd>{mera.waterType}</dd></div><div><dt>Güven</dt><dd>{mera.confidence}</dd></div><div><dt>Erişim</dt><dd>{accessDisplay}</dd></div></dl></aside></div></section>
<section class="container section detail-content"><article class="content-main article-prose">
<section class="article-intro">{displayIntro.map((paragraph)=><p>{paragraph}</p>)}</section>
<nav class="on-page-nav" aria-label="Sayfa içeriği"><strong>Bu rehberde</strong><a href="#konum">Konum</a><a href="#av-plani">Av planı</a>{confidenceProfile&&<a href="#guven-endeksi">Güven endeksi</a>}{hasResearch&&<a href="#arastirma">Kaynaklar</a>}<a href="#kiyi">Kıyı yapısı</a><a href="#ulasim">Ulaşım</a><a href="#baliklar">Balıklar</a><a href="#planlama">Planlama</a>{relatedRoutes.length>0&&<a href="#yakin-rotalar">Yakın rotalar</a>}<a href="#kaynaklar">Kaynakça</a></nav>
<section class="source-box" id="konum"><span class="kicker">📍 Konum</span><h2>{mera.name} nerede?</h2><p><strong>{locationLabel}</strong></p><div class="info-grid"><section class="info-card"><span>🧭</span><h3>Harita bilgisi</h3><ul><li>İl: {mera.province}</li><li>İlçe / alan: {mera.district}</li><li>Su türü: {mera.waterType}</li><li>Konum hassasiyeti: {effectiveLocationPrecision}</li>{hasCoordinates&&<li>Koordinat: <code>{coordinateLabel}</code></li>}</ul></section><section class="info-card"><span>🗺️</span><h3>Haritada aç</h3><p>{locationNote}</p><div class="detail-actions">{hasCoordinates?<><a class="button button-small" href={googlePoint} target="_blank" rel="noreferrer">Google Maps</a><a class="button button-small button-ghost" href={osmMaps} target="_blank" rel="noreferrer">OpenStreetMap</a></>:<><a class="button button-small" href={googleSearch} target="_blank" rel="noreferrer">Google Maps'te ara</a><a class="button button-small button-ghost" href={osmSearch} target="_blank" rel="noreferrer">OpenStreetMap'te ara</a></>}</div></section></div></section>
<section class="source-box" id="av-plani"><span class="kicker">🎣 Av planı</span><h2>Gitmeden önce hızlı bakış</h2><p>Bu kart, mevcut kaynaklarla desteklenen bilgileri tek yerde toplar. Güven D rotalarında genel konum sunulur; mikro kıyı girişi ve güncel av uygunluğu ayrıca kontrol edilir.</p><div class="info-grid"><section class="info-card"><span>🌊</span><h3>Su ve rota</h3><ul><li>Su türü: {mera.waterType}</li><li>Bölge: {mera.region}</li><li>Kıyı karakteri: {cleanDText(mera.shoreProfile)}</li></ul></section><section class="info-card"><span>🐟</span><h3>Raporlanan türler</h3><p>{fishPlanLabel}</p><p class="microcopy">Tür listesi av garantisi değildir.</p></section><section class="info-card"><span>🚗</span><h3>Erişim</h3><ul><li>Araç erişimi: {accessDisplay}</li><li>Navigasyon: {navigationPlanLabel}</li><li>Konum hassasiyeti: {effectiveLocationPrecision}</li></ul></section><section class="info-card"><span>🏕️</span><h3>Kullanım ve imkânlar</h3><ul><li>Kamp: {mera.camping}</li><li>Yakın imkânlar: {amenitiesPlanLabel}</li></ul></section><section class="info-card"><span>🧭</span><h3>Doğrulama</h3><ul><li>Güven: {mera.confidence}</li><li>Saha teyidi: {fieldVerificationLabel}</li><li>Son kontrol: {new Date(mera.updatedAt).toLocaleDateString("tr-TR")}</li></ul></section><section class="info-card"><span>⚠️</span><h3>Öne çıkan riskler</h3>{mera.cautions.length>0?<ul>{mera.cautions.slice(0,3).map((i)=><li>{cleanDText(i)}</li>)}</ul>:<p>Rota bazında ayrı risk notu yayımlanmadı; genel saha tedbirleri geçerlidir.</p>}</section></div><div class="warning-box"><h3>Gitmeden önce kontrol et</h3><p><strong>⚖️ Mevzuat</strong> → <strong>🌦️ hava ve rüzgâr</strong> → <strong>🌊 su durumu</strong> → <strong>🚗 erişim</strong> → <strong>🎣 ekipman</strong></p><p>Harita bağlantısı, tür kaydı veya geçmiş erişim bilgisi tek başına güncel avlanma izni ve güvenli giriş garantisi değildir.</p></div></section>
{confidenceProfile&&<section class="source-box confidence-profile" id="guven-endeksi"><span class="kicker">Kanıt modeli v1 · Son inceleme {new Date(confidenceProfile.reviewedAt).toLocaleDateString("tr-TR")}</span><h2>Güven {confidenceProfile.overall} nasıl oluştu?</h2><p>Kimlik, hukuk, erişim, tür ve saha kanıtı ayrı değerlendirilir. Güven D özellikle mikro erişim, tür ve saha kanıtının sınırlı olduğuna işaret eder.</p><div class="confidence-dimension-grid">{confidenceDimensions.map((dimension)=><article class={`confidence-dimension confidence-dimension-${dimension.level}`}><div class="confidence-dimension-heading"><span aria-hidden="true">{dimension.icon}</span><div><small>{confidenceLevelLabel[dimension.level]}</small><h3>{dimension.label}</h3></div></div><p>{cleanDText(dimension.note)}</p></article>)}</div></section>}
{hasResearch&&<section class="source-box" id="arastirma"><span class="kicker">{isLevelD?"Konum ve kaynak doğrulaması":"Rota özelinde açık kaynak araştırması"}</span><h2>{isLevelD?"Bu rota hakkında hangi bilgiler kaynaklarla destekleniyor?":"Hangi bilgiler doğrudan araştırıldı?"}</h2><p>{cleanDText(mera.researchSummary||"")}</p>{mera.fishEvidence?.length>0&&<><h3>Balık türü kanıtları</h3><ul>{mera.fishEvidence.map((item)=><li><a href={item.sourceUrl} target="_blank" rel="noreferrer"><strong>{item.name}{item.scientificName?` (${item.scientificName})`:""}</strong></a><span>{item.evidenceLevel}: {item.note}</span></li>)}</ul></>}{mera.accessEvidence?.length>0&&<><h3>Ulaşım ve erişim araştırması</h3><ul>{mera.accessEvidence.map((item)=><li><a href={item.sourceUrl} target="_blank" rel="noreferrer"><strong>{item.label}</strong></a><span>{item.value} {item.note}</span></li>)}</ul></>}{mera.accommodationOptions?.length>0&&<><h3>Konaklama ve geceleme seçenekleri</h3><ul>{mera.accommodationOptions.map((item)=><li><a href={item.sourceUrl} target="_blank" rel="noreferrer"><strong>{item.name}</strong></a><span>{item.type}{Number.isFinite(item.distanceKm)?` · yaklaşık ${item.distanceKm} km`:""} · {item.note}</span></li>)}</ul></>}</section>}
<section class="info-block" id="kiyi"><span class="kicker">Kıyı karakteri</span><h2>{mera.name} nasıl bir rota?</h2><p>{cleanDText(mera.shoreProfile)}</p><p>{cleanDText(mera.crowdNote)}</p></section>
<section class="info-block navigation-block" id="ulasim"><span class="kicker">Ulaşım ve navigasyon</span><h2>Rotaya nasıl gidilir?</h2><p>{cleanDText(mera.transport)}</p><p>{locationNote}</p>{directionsVerified?<div class="navigation-grid"><a href={googleDirections} target="_blank" rel="noreferrer"><strong>Google Maps</strong><span>Mevcut konumdan araç rotası</span></a><a href={appleMaps} target="_blank" rel="noreferrer"><strong>Apple Maps</strong><span>Apple cihazlarında yol tarifi</span></a><a href={yandexMaps} target="_blank" rel="noreferrer"><strong>Yandex Maps</strong><span>Koordinata araç rotası</span></a><a href={osmMaps} target="_blank" rel="noreferrer"><strong>OpenStreetMap</strong><span>Açık haritada konumu gör</span></a></div>:hasCoordinates?<div class="warning-box"><h3>Genel konum pini</h3><p>Bu koordinat suyu veya rota bölgesini bulmak içindir; doğrudan araç girişi ya da olta atılacak kıyı noktası olarak kullanılmamalıdır.</p><div class="navigation-grid"><a href={googlePoint} target="_blank" rel="noreferrer"><strong>Google Maps</strong><span>Genel konumu aç</span></a><a href={osmMaps} target="_blank" rel="noreferrer"><strong>OpenStreetMap</strong><span>Genel konumu incele</span></a></div></div>:<div class="warning-box"><h3>Harita araması hazır</h3><p>Tek bir koordinatı tahmin ederek vermek yerine su adı ve il ile iki ayrı harita araması açıyoruz. Sonucu uydu görünümü, yol ağı ve saha tabelalarıyla kontrol et.</p><div class="navigation-grid"><a href={googleSearch} target="_blank" rel="noreferrer"><strong>Google Maps</strong><span>{mera.name} konumunu ara</span></a><a href={osmSearch} target="_blank" rel="noreferrer"><strong>OpenStreetMap</strong><span>Ad ve il ile açık haritada ara</span></a></div></div>}<p class="microcopy">Harita bağlantısı yolun açık, kamuya ait ya da araçla geçilebilir olduğunu garanti etmez. Tabela, bariyer ve görevli talimatı üstündür.</p></section>
<section class="info-block" id="baliklar"><span class="kicker">Raporlanan ve kaynaklanan türler</span><h2>{mera.name} çevresinde hangi balıklar bulunabilir?</h2>{seasonalNotes[0]&&<p>{seasonalNotes[0]}</p>}{mera.fish.length>0?<><div class="tag-row" aria-label="Raporlanan balık türleri">{mera.fish.map((fish)=><span>{fish}</span>)}</div>{relatedFish.length>0&&<div class="related-fish-grid">{relatedFish.map((fish)=><a href={`/baliklar/${fish.slug}/`}><img src={fish.image} alt={`${fish.name} illüstrasyonu`} loading="lazy"/><span>{fish.name}</span></a>)}</div>}</>:<div class="warning-box"><p>Bu su için rota özelinde yeterli kaynakla desteklenmiş tür listesi henüz yok. Tür tahmini eklemek yerine konum ve saha planını sunuyoruz.</p></div>}{seasonalNotes[1]&&<p>{seasonalNotes[1]}</p>}<p class="microcopy">Tür listesi av garantisi değildir; kanıt düzeyi ve güncellik rota dosyasına göre değişebilir.</p></section>
<div class="info-grid"><section class="info-card"><span>🧰</span><h2>Yöntem bilgisi</h2>{mera.methods.length>0?<ul>{mera.methods.map((i)=><li>{i}</li>)}</ul>:<p>Bu rota için güvenilir, nokta-özel yöntem önerisi henüz eklenmedi.</p>}</section><section class="info-card"><span>🪱</span><h2>Yem ve sahteler</h2>{mera.baits.length>0?<ul>{mera.baits.map((i)=><li>{i}</li>)}</ul>:<p>Bu rota için güvenilir, nokta-özel yem veya sahte önerisi henüz eklenmedi.</p>}</section><section class="info-card"><span>🚗</span><h2>Kullanım bilgisi</h2><ul><li>Araç erişimi: {accessDisplay}</li><li>Kamp: {mera.camping}</li><li>Konum hassasiyeti: {effectiveLocationPrecision}</li></ul></section><section class="info-card"><span>🏕️</span><h2>Yakın imkânlar</h2>{mera.amenities.length>0?<ul>{mera.amenities.map((i)=><li>{i}</li>)}</ul>:<p>Yakın hizmetler ve tesisler rota bazında doğrulanmayı bekliyor.</p>}</section></div>
<section class="info-block" id="planlama"><span class="kicker">Saha planı</span><h2>Gitmeden önce hangi kontroller yapılmalı?</h2>{planningNotes.map((p)=><p>{p}</p>)}<div class="warning-box"><h3>Öne çıkan riskler</h3><ul>{mera.cautions.map((i)=><li>{cleanDText(i)}</li>)}</ul></div></section>
{relatedRoutes.length>0&&<section class="info-block" id="yakin-rotalar"><span class="kicker">Yer ve konu yakınlığı</span><h2>{mera.name} sonrasında hangi rotalara bakılabilir?</h2><p>Öneriler aynı il/ilçe, yaklaşık coğrafi yakınlık, su türü ve ortak raporlanan balıklar birlikte puanlanarak seçilir. Liste av verimi sıralaması değildir.</p><div class="link-list">{relatedRoutes.map(({candidate,km})=><a href={`/meralar/${candidate.slug}/`}><strong>{candidate.name}</strong><span>{candidate.province} · {candidate.district} · {candidate.waterType}{Number.isFinite(km)&&km>1?` · yaklaşık ${Math.round(km)} km`:""} · Güven {candidate.confidence}</span></a>)}</div></section>}
{relatedGuides.length>0&&<section class="info-block" id="ilgili-rehberler"><span class="kicker">Hazırlık ve teknik</span><h2>Bu rota için ilgili rehberler</h2><div class="link-list">{relatedGuides.map((guide)=><a href={`/rehberler/${guide.slug}/`}><strong>{guide.title}</strong><span>{guide.category} · {guide.difficulty} · {guide.readingTime} dk</span></a>)}</div></section>}
<section class="source-box" id="kaynaklar"><span class="kicker">Kaynak ve yöntem</span><h2>Bu sayfa hangi bilgilere dayanıyor?</h2><p>Su varlığı, yaklaşık konum, kıyı erişimi, avlanma kuralları ve balık türü birbirinden ayrı kanıt düzeyleriyle değerlendirilir. Konum göstermek, belirli kıyıda av izni olduğu anlamına gelmez.</p><ul>{displaySources.map((source)=><li><a href={source.url} target="_blank" rel="noreferrer"><strong>{source.label}</strong></a><span>{source.note}</span></li>)}</ul><p class="microcopy">Güven D sayfaları da yayımlanmış rota rehberleridir; harita ve kaynaklar sunulur, yalnızca doğrulanmamış mikro detaylar kesinmiş gibi yazılmaz.</p></section>
<FeedbackButtons title={pageHeading} contentKey={`mera:${mera.slug}`} path={pagePath} /></article>
<aside class="content-aside"><div class="aside-card sticky-card"><h2>Hızlı özet</h2><dl class="compact-dl"><div><dt>İl</dt><dd><a href={provinceUrl}>{mera.province}</a></dd></div><div><dt>Alan</dt><dd>{mera.district}</dd></div><div><dt>Su türü</dt><dd>{mera.waterType}</dd></div><div><dt>Konum</dt><dd>{effectiveLocationPrecision}</dd></div><div><dt>Koordinat</dt><dd>{coordinateLabel}</dd></div><div><dt>Güven</dt><dd>{mera.confidence}</dd></div><div><dt>Son kontrol</dt><dd>{new Date(mera.updatedAt).toLocaleDateString("tr-TR")}</dd></div></dl></div><div class="aside-card"><h2>Haritada aç</h2>{hasCoordinates?<><a href={googlePoint} target="_blank" rel="noreferrer">Google Maps</a><br/><a href={osmMaps} target="_blank" rel="noreferrer">OpenStreetMap</a></>:<><a href={googleSearch} target="_blank" rel="noreferrer">Google Maps'te ara</a><br/><a href={osmSearch} target="_blank" rel="noreferrer">OpenStreetMap'te ara</a></>}</div><div class="aside-card"><h2>İçerik ağı</h2><a href={provinceUrl}>{mera.province} avlakları</a><br/><a href="/baliklar/">Balık türleri</a><br/><a href="/rehberler/">Balıkçılık rehberleri</a></div><div class="aside-card"><h2>Resmî kurallar</h2><a href="https://www.tarimorman.gov.tr/Konular/Su-Urunleri/Su-Urunleri-Avciligi" target="_blank" rel="noreferrer">Güncel tebliği aç</a></div><div class="aside-card"><h2>Hata mı gördün?</h2><p>Konum, tür veya ulaşım bilgisi değiştiyse editöre bildir.</p><a href={`/iletisim/?konu=Konum%20veya%20navigasyon%20hatası&sayfa=${encodeURIComponent(mera.name)}&url=${encodeURIComponent(pageUrl)}`}>Hata bildir</a></div></aside></section>
<script is:inline>document.querySelector("#copy-link")?.addEventListener("click",async(event)=>{await navigator.clipboard.writeText(location.href);event.currentTarget.textContent="Kopyalandı";});</script>
</BaseLayout>

