---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FeedbackButtons from "../../components/FeedbackButtons.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { meralar, districtRouteCounts } from "../../data/meralar-tumu";
import { baliklar } from "../../data/baliklar";
import { slugifyTr } from "../../utils/slug";

export function getStaticPaths(){
  return meralar.map((mera)=>({params:{slug:mera.slug},props:{mera}}));
}

const {mera}=Astro.props;
const hasCoordinates=Number.isFinite(mera.lat)&&Number.isFinite(mera.lng);
const googleMaps=hasCoordinates?`https://www.google.com/maps/dir/?api=1&destination=${mera.lat},${mera.lng}&travelmode=driving`:"";
const appleMaps=hasCoordinates?`https://maps.apple.com/?daddr=${mera.lat},${mera.lng}&dirflg=d`:"";
const yandexMaps=hasCoordinates?`https://yandex.com/maps/?rtext=~${mera.lat},${mera.lng}&rtt=auto`:"";
const osmMaps=hasCoordinates?`https://www.openstreetmap.org/?mlat=${mera.lat}&mlon=${mera.lng}#map=14/${mera.lat}/${mera.lng}`:"";
const osmSearch=`https://www.openstreetmap.org/search?query=${encodeURIComponent(`${mera.name}, ${mera.province}, Türkiye`)}`;
const relatedFish=baliklar.filter((b)=>mera.fish.includes(b.name));
const provinceUrl=`/iller/${slugifyTr(mera.province)}/`;
const districtCount=districtRouteCounts[`${mera.province}|${mera.district}`] || 0;
const districtUrl=districtCount>=2 ? `/iller/${slugifyTr(mera.province)}/${slugifyTr(mera.district)}/` : `/iller/${slugifyTr(mera.province)}/#${slugifyTr(mera.district)}`;
const pagePath=`/meralar/${mera.slug}/`;
const pageUrl=new URL(pagePath,Astro.site).href;
const preliminary=mera.confidence==="D";
const pageHeading=preliminary?`${mera.name} Ön Değerlendirme Rota Dosyası`:`${mera.name} Balık Avı Rehberi`;
const spatialCoverage=hasCoordinates
  ? {"@type":"Place",name:`${mera.district}, ${mera.province}`,geo:{"@type":"GeoCoordinates",latitude:mera.lat,longitude:mera.lng}}
  : {"@type":"Place",name:`${mera.province}, Türkiye`};
const articleSchema={
  "@context":"https://schema.org",
  "@type":"Article",
  "@id":`${pageUrl}#article`,
  headline:pageHeading,
  description:mera.summary,
  image:[new URL(mera.socialImage,Astro.site).href,new URL(mera.image,Astro.site).href],
  datePublished:mera.publishedAt,
  dateModified:mera.updatedAt,
  inLanguage:"tr-TR",
  mainEntityOfPage:{"@type":"WebPage","@id":pageUrl},
  author:{"@type":"Organization","@id":`${new URL("/",Astro.site).href}#organization`,name:"Olta Atlası Editörlüğü"},
  publisher:{"@id":`${new URL("/",Astro.site).href}#organization`},
  about:mera.fish.map((name)=>({"@type":"Thing",name})),
  spatialCoverage,
};
---
<BaseLayout title={pageHeading} description={mera.summary} image={mera.socialImage} type="article" publishedAt={mera.publishedAt} modifiedAt={mera.updatedAt}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)}/>
  <section class="detail-hero">
    <div class="container detail-grid">
      <div>
        <Breadcrumbs items={[{label:"Ana sayfa",href:"/"},{label:mera.province,href:provinceUrl},{label:mera.district,href:districtUrl},{label:mera.name}]} />
        <div class="eyebrow-row">
          <span class="pill">{mera.province} · {mera.district}</span>
          <span class="pill pill-muted">{mera.zone}</span>
          <span class={`confidence confidence-${mera.confidence.toLowerCase()}`}>Güven {mera.confidence}</span>
        </div>
        <h1>{pageHeading}</h1>
        <p class="lead">{mera.summary}</p>
        {preliminary && <div class="warning-box"><strong>Ön değerlendirme kaydı:</strong> Bu dosya bir su varlığını araştırma başlangıcı olarak gösterir; belirli kıyının kamusal, güvenli veya avlanmaya açık olduğunu doğrulamaz.</div>}
        <div class="article-byline">
          <span>Olta Atlası Editörlüğü</span>
          <span>İlk yayın: {new Date(mera.publishedAt).toLocaleDateString("tr-TR")}</span>
          <span>Son güncelleme: {new Date(mera.updatedAt).toLocaleDateString("tr-TR")}</span>
        </div>
        <div class="detail-actions">
          {hasCoordinates
            ? <a class="button" href={googleMaps} target="_blank" rel="noreferrer">Google Maps yol tarifi</a>
            : <a class="button" href={osmSearch} target="_blank" rel="noreferrer">Açık haritada adı ara</a>}
          <button class="button button-ghost" id="copy-link" type="button">Bağlantıyı kopyala</button>
        </div>
      </div>
      <aside class="status-card image-status">
        <img src={mera.image} alt={`${mera.name} rota karakterini anlatan özgün illüstrasyon`} width="1200" height="675"/>
        <dl>
          <div><dt>Doğrulama</dt><dd>{mera.verification}</dd></div>
          <div><dt>Konum</dt><dd>{mera.locationPrecision}</dd></div>
          <div><dt>Su</dt><dd>{mera.region}</dd></div>
          <div><dt>Araç erişimi</dt><dd>{mera.vehicleAccess}</dd></div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="container section detail-content">
    <article class="content-main article-prose">
      <section class="article-intro">{mera.longIntro.map((paragraph)=><p>{paragraph}</p>)}</section>
      <nav class="on-page-nav" aria-label="Sayfa içeriği">
        <strong>Bu dosyada</strong>
        <a href="#kiyi">Kıyı yapısı</a>
        <a href="#ulasim">Ulaşım</a>
        <a href="#baliklar">Balıklar</a>
        <a href="#planlama">Planlama</a>
        <a href="#kaynaklar">Kaynaklar</a>
      </nav>

      <section class="info-block" id="kiyi">
        <span class="kicker">Kıyı karakteri</span>
        <h2>{mera.name} nasıl bir rota?</h2>
        <p>{mera.shoreProfile}</p>
        <p>{mera.crowdNote}</p>
      </section>

      <section class="info-block navigation-block" id="ulasim">
        <span class="kicker">Ulaşım ve navigasyon</span>
        <h2>Rotaya nasıl gidilir?</h2>
        <p>{mera.transport}</p>
        <p>{mera.navigationNote}</p>
        {hasCoordinates ? (
          <div class="navigation-grid">
            <a href={googleMaps} target="_blank" rel="noreferrer"><strong>Google Maps</strong><span>Mevcut konumdan araç rotası</span></a>
            <a href={appleMaps} target="_blank" rel="noreferrer"><strong>Apple Maps</strong><span>Apple cihazlarında yol tarifi</span></a>
            <a href={yandexMaps} target="_blank" rel="noreferrer"><strong>Yandex Maps</strong><span>Koordinata araç rotası</span></a>
            <a href={osmMaps} target="_blank" rel="noreferrer"><strong>OpenStreetMap</strong><span>Açık haritada konumu gör</span></a>
          </div>
        ) : (
          <div class="warning-box">
            <h3>Kesin erişim noktası yayımlanmadı</h3>
            <p>Yanlış yol tarifi, özel mülkiyet veya yasaklı alana yönlendirme riski nedeniyle doğrulanmamış koordinat vermiyoruz.</p>
            <a href={osmSearch} target="_blank" rel="noreferrer"><strong>OpenStreetMap üzerinde ad ve il ile araştır</strong></a>
          </div>
        )}
        <p class="microcopy">Harita veya arama bağlantısı yolun açık, kamuya ait ya da araçla geçilebilir olduğunu garanti etmez. Tabela, bariyer, görevli talimatı ve özel mülkiyet sınırı haritadan üstündür.</p>
      </section>

      <section class="info-block" id="baliklar">
        <span class="kicker">Raporlanan türler</span>
        <h2>{mera.name} çevresinde hangi balıklar raporlanıyor?</h2>
        <p>{mera.seasonalNotes[0]}</p>
        {relatedFish.length > 0 ? (
          <div class="related-fish-grid">
            {relatedFish.map((fish)=><a href={`/baliklar/${fish.slug}/`}><img src={fish.image} alt={`${fish.name} illüstrasyonu`} loading="lazy"/><span>{fish.name}</span></a>)}
          </div>
        ) : (
          <div class="warning-box"><p>Bu rota için kaynaklarla desteklenmiş tür listesi henüz yayımlanmadı. Bölgesel tür tahmini yapılmadı.</p></div>
        )}
        <p>{mera.seasonalNotes[1]}</p>
        <p class="microcopy">Tür listesi av garantisi değildir. Mevsim, su koşulu, balık göçü ve doğrulama tarihi sonucu değiştirebilir.</p>
      </section>

      <div class="info-grid">
        <section class="info-card">
          <span>🧰</span><h2>Önerilen yöntemler</h2>
          {mera.methods.length > 0 ? <ul>{mera.methods.map((i)=><li>{i}</li>)}</ul> : <p>Rota bazında doğrulanmış yöntem önerisi henüz yayımlanmadı.</p>}
          <p>Takım ağırlığı, kıyı yüksekliği, akıntı ve çevredeki insan yoğunluğuna göre yeniden ayarlanmalıdır.</p>
        </section>
        <section class="info-card">
          <span>🪱</span><h2>Yem ve sahteler</h2>
          {mera.baits.length > 0 ? <ul>{mera.baits.map((i)=><li>{i}</li>)}</ul> : <p>Rota bazında doğrulanmış yem veya sahte önerisi henüz yayımlanmadı.</p>}
          <p>Yem seçimi hedef tür kadar su berraklığı, küçük balık baskısı ve günün saatine de bağlıdır.</p>
        </section>
        <section class="info-card">
          <span>🚗</span><h2>Kullanım bilgisi</h2>
          <ul><li>Araç erişimi: {mera.vehicleAccess}</li><li>Kamp: {mera.camping}</li><li>Konum hassasiyeti: {mera.locationPrecision}</li></ul>
        </section>
        <section class="info-card">
          <span>🏕️</span><h2>Yakın imkânlar</h2>
          {mera.amenities.length > 0 ? <ul>{mera.amenities.map((i)=><li>{i}</li>)}</ul> : <p>Yakın hizmetler ve tesisler rota bazında doğrulanmayı bekliyor.</p>}
        </section>
      </div>

      <section class="info-block" id="planlama">
        <span class="kicker">Saha planı</span>
        <h2>Gitmeden önce hangi kontroller yapılmalı?</h2>
        {mera.planningNotes.map((p)=><p>{p}</p>)}
        <div class="warning-box"><h3>Öne çıkan riskler</h3><ul>{mera.cautions.map((i)=><li>{i}</li>)}</ul></div>
      </section>

      <section class="source-box" id="kaynaklar">
        <span class="kicker">Kaynak ve yöntem</span>
        <h2>Bu sayfa hangi bilgilere dayanıyor?</h2>
        <p>Olta Atlası, su varlığının kayıtlardaki mevcudiyetini; kıyı erişimi, avlanma izni ve balık türü doğrulamasından ayrı değerlendirir. Bir suyun açık kaynakta bulunması o noktada av yapılabileceği anlamına gelmez.</p>
        <ul>{mera.sources.map((source)=><li><a href={source.url} target="_blank" rel="noreferrer"><strong>{source.label}</strong></a><span>{source.note}</span></li>)}</ul>
        <p class="microcopy">İçerik hazırlanırken yapay zekâ destekli taslak ve veri düzenleme araçları kullanılmış; kaynak kapsamı, yanıltıcı kesinlik ve sorumluluk ifadeleri editörlük kurallarıyla sınırlandırılmıştır. Saha doğrulaması bekleyen kayıtlar güven seviyesiyle işaretlenir.</p>
      </section>

      <FeedbackButtons title={pageHeading} contentKey={`mera:${mera.slug}`} path={pagePath} />
    </article>

    <aside class="content-aside">
      <div class="aside-card sticky-card">
        <h2>Hızlı özet</h2>
        <dl class="compact-dl">
          <div><dt>İlçe</dt><dd><a href={districtUrl}>{mera.district}</a></dd></div>
          <div><dt>Su türü</dt><dd>{mera.waterType}</dd></div>
          <div><dt>Güven</dt><dd>{mera.confidence}</dd></div>
          <div><dt>Son kontrol</dt><dd>{new Date(mera.updatedAt).toLocaleDateString("tr-TR")}</dd></div>
        </dl>
      </div>
      <div class="aside-card"><h2>Resmî kurallar</h2><a href="https://www.tarimorman.gov.tr/Konular/Su-Urunleri/Su-Urunleri-Avciligi" target="_blank" rel="noreferrer">Güncel tebliği aç</a></div>
      <div class="aside-card"><h2>Hata mı gördün?</h2><p>Konum, tür veya ulaşım bilgisi değiştiyse editöre bildir.</p><a href={`/iletisim/?konu=Konum%20veya%20navigasyon%20hatası&sayfa=${encodeURIComponent(mera.name)}&url=${encodeURIComponent(pageUrl)}`}>Hata bildir</a></div>
    </aside>
  </section>
  <script is:inline>document.querySelector("#copy-link")?.addEventListener("click",async(event)=>{await navigator.clipboard.writeText(location.href);event.currentTarget.textContent="Kopyalandı";});</script>
</BaseLayout>
