---
import BaseLayout from "../../layouts/BaseLayout.astro";import { meralar } from "../../data/meralar";import { baliklar } from "../../data/baliklar";import { rehberler } from "../../data/rehberler";import { dunyaBalikcilikYazilari } from "../../data/dunya-balikcilik";
const posts=[...meralar.map((m)=>({type:"Mera",title:m.name,summary:m.summary,url:`/meralar/${m.slug}/`,image:m.image,icon:null,meta:`${m.province} · ${m.district}`})),...baliklar.map((b)=>({type:"Balık",title:b.name,summary:b.habitat,url:`/baliklar/${b.slug}/`,image:b.image,icon:null,meta:b.water})),...rehberler.map((r)=>({type:"Rehber",title:r.title,summary:r.summary,url:`/rehberler/${r.slug}/`,image:null,meta:r.category,icon:r.icon})),...dunyaBalikcilikYazilari.map((p)=>({type:"Dünya",title:p.title,summary:p.summary,url:`/dunyada-balikcilik/${p.slug}/`,image:p.cover,meta:`${p.country} · ${p.species}`,icon:null}))];
---
<BaseLayout title="Tüm Yazılar" description="Olta Atlası mera, balık türü, dünya balıkçılık günlüğü ve uygulama rehberlerinin tamamı."><section class="page-hero"><div class="container"><span class="kicker">{posts.length} bağımsız içerik</span><h1>Tüm yazılar</h1><p class="lead">Mera dosyaları, balık türleri, dünya av günlüğü ve uygulamalı rehberler tek arşivde.</p></div></section><section class="container section"><div class="category-filter"><label><span>İçerik türü</span><select id="post-type"><option value="">Tümü</option><option value="Mera">Meralar</option><option value="Balık">Balıklar</option><option value="Dünya">Dünyada Balıkçılık</option><option value="Rehber">Rehberler</option></select></label><p id="post-count">{posts.length} içerik gösteriliyor</p></div><div class="card-grid post-grid">{posts.map((p)=><article class="post-card" data-post data-type={p.type}>{p.image?<a href={p.url}><img src={p.image} alt={`${p.title} görseli`} loading="lazy"/></a>:<div class="post-icon" aria-hidden="true">{p.icon}</div>}<div class="card-body"><div class="eyebrow-row"><span class="pill">{p.type}</span><span class="microcopy">{p.meta}</span></div><h2><a href={p.url}>{p.title}</a></h2><p>{p.summary}</p><a class="text-link" href={p.url}>İçeriği aç →</a></div></article>)}</div></section><script is:inline>const select=document.querySelector("#post-type"),cards=[...document.querySelectorAll("[data-post]")],count=document.querySelector("#post-count");select.addEventListener("change",()=>{let n=0;cards.forEach(card=>{const show=!select.value||card.dataset.type===select.value;card.hidden=!show;if(show)n++;});count.textContent=`${n} içerik gösteriliyor`;});</script></BaseLayout>
