---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { meralar, provinces } from "../../data/meralar-tumu";
import { slugifyTr } from "../../utils/slug";
const provinceCards=provinces.map((province)=>{const items=meralar.filter((m)=>m.province===province);return {province,count:items.length,verifiedCount:items.filter((m)=>m.confidence!=="D").length,districts:[...new Set(items.map((m)=>m.district))],fish:[...new Set(items.flatMap((m)=>m.fish))].slice(0,8)};});
---
<BaseLayout title="İllere Göre Balık Tutulacak Yerler" description="Türkiye'nin 81 ilindeki tüm indekslenebilir mera rotalarını; güven seviyesi, ilçe, ulaşım, kıyı ve saha notlarıyla karşılaştır."><section class="page-hero"><div class="container"><Breadcrumbs items={[{label:"Ana sayfa",href:"/"},{label:"İller"}]}/><span class="kicker">{provinceCards.length} il · {meralar.length} indekslenebilir rota</span><h1>İllere göre balık tutulacak yerler</h1><p class="lead">Güven seviyesi ne olursa olsun tüm rota dosyalarını il merkezlerinde bir araya getiriyor; kanıt kapsamını ve doğrulanmamış noktaları sayfalarda açıkça gösteriyoruz.</p></div></section><section class="container section"><div class="province-grid">{provinceCards.map((card)=><article class="province-card"><span class="kicker">{card.count} rota · {card.verifiedCount} güçlü dosya · {card.districts.length} ilçe</span><h2><a href={`/iller/${slugifyTr(card.province)}/`}>{card.province}</a></h2><p>{card.districts.join(", ")} ilçelerindeki tüm rota dosyalarını incele.</p><div class="tag-row">{card.fish.map((fish)=><span>{fish}</span>)}</div><a class="button button-small" href={`/iller/${slugifyTr(card.province)}/`}>{card.province} rehberini aç</a></article>)}</div></section></BaseLayout>
