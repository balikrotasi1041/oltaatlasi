---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import MeraCard from "../../../components/MeraCard.astro";
import { meralar, provinces } from "../../../data/meralar";
import { slugifyTr } from "../../../utils/slug";
export function getStaticPaths(){return provinces.map((province)=>({params:{province:slugifyTr(province)},props:{province}}));}
const {province}=Astro.props;const items=meralar.filter((m)=>m.province===province);const districts=[...new Set(items.map((m)=>m.district))].sort((a,b)=>a.localeCompare(b,"tr"));const zones=[...new Set(items.map((m)=>m.zone))];const fish=[...new Set(items.flatMap((m)=>m.fish))].sort((a,b)=>a.localeCompare(b,"tr"));const pageUrl=new URL(`/iller/${slugifyTr(province)}/`,Astro.site).href;
const schema={"@context":"https://schema.org","@type":"CollectionPage","@id":pageUrl,name:`${province} Balık Tutulacak Yerler`,description:`${province} ilindeki balıkçılık rotaları, ilçeler, ulaşım ve raporlanan balık türleri.`,mainEntity:{"@type":"ItemList",itemListElement:items.map((m,index)=>({"@type":"ListItem",position:index+1,url:new URL(`/meralar/${m.slug}/`,Astro.site).href,name:m.name}))}};
const istanbulIntro=province==="İstanbul" ? ["İstanbul, Boğaz, Haliç, Marmara ve Karadeniz geçişlerini aynı şehir sınırında buluşturduğu için tek tip bir kıyı avı sunmaz. Galata ve Unkapanı köprülerindeki dik av ile Marmara sahilindeki uzun taş tahkimat, üst Boğaz’daki güçlü akıntı ve batı kıyılarındaki açık rüzgâr aynı takım ve aynı güvenlik yaklaşımıyla değerlendirilemez.","Bu il rehberi, Avrupa ve Anadolu yakasındaki rota dosyalarını ilçe düzeyinde ayırır. Sayfalarda verilen koordinatlar çoğunlukla genel kamusal erişim bölgesini gösterir; iskele, marina, liman, yüzme alanı ve etkinlik sahası sınırları yerinde kontrol edilmelidir."] : ["Kocaeli, Marmara kıyısı, İzmit Körfezi, Karadeniz sahilleri ve iç su rotalarını kısa mesafelerde bir araya getirir. Bu çeşitlilik; takım, ulaşım ve güvenlik planının her rota için ayrı kurulmasını gerektirir.","Kayıtların bir bölümü editör gözlemi, bir bölümü ise araştırma ve kullanıcı bildirimi düzeyindedir. Güven seviyesi düşük kayıtlar kesin av noktası olarak değil, saha doğrulaması bekleyen planlama dosyası olarak okunmalıdır."];
---
<BaseLayout title={`${province} Balık Tutulacak Yerler`} description={`${province} ilinde balık tutulacak yerler, ilçelere göre mera dosyaları, navigasyon, yöntem ve raporlanan türler.`}><script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}/><section class="page-hero"><div class="container"><Breadcrumbs items={[{label:"Ana sayfa",href:"/"},{label:"İller",href:"/iller/"},{label:province}]}/><span class="kicker">{items.length} rota · {districts.length} ilçe</span><h1>{province} balık tutulacak yerler</h1><p class="lead">{province} genelindeki kıyı ve iç su rota dosyalarını ilçe, su tipi ve raporlanan balık türleriyle incele.</p></div></section><section class="container section article-prose"><section class="article-intro">{istanbulIntro.map((p:string)=><p>{p}</p>)}</section><div class="city-summary-grid"><div><strong>{items.length}</strong><span>Mera dosyası</span></div><div><strong>{districts.length}</strong><span>İlçe</span></div><div><strong>{zones.length}</strong><span>Bölge</span></div><div><strong>{fish.length}</strong><span>Raporlanan tür</span></div></div><section class="info-block"><span class="kicker">İlçeler</span><h2>{province} ilçe rehberleri</h2><div class="district-link-grid">{districts.map((district)=>{const districtItems=items.filter((m)=>m.district===district);const count=districtItems.length;const href=count>=2?`/iller/${slugifyTr(province)}/${slugifyTr(district)}/`:`/meralar/${districtItems[0].slug}/`;return <a id={slugifyTr(district)} href={href}><strong>{district}</strong><span>{count} rota dosyası</span></a>})}</div></section>{province==="İstanbul"&&<section class="info-block"><span class="kicker">İki yaka, farklı koşullar</span><h2>Avrupa ve Anadolu Yakası nasıl ayrılıyor?</h2><div class="zone-columns">{zones.map((zone)=><div><h3>{zone}</h3><p>{zone==="Avrupa Yakası"?"Haliç köprüleri, tarihî yarımada, Boğaz kıyıları ve batı Marmara sahilleri; toplu taşıma gücü kadar yoğun yaya kullanımı ve akıntı farklılıklarıyla öne çıkar.":"Üsküdar’dan Anadolu Kavağı’na Boğaz kıyıları ile Kadıköy’den Pendik’e Marmara sahili; iskele trafiği, park kullanımı ve uzun taş tahkimat bölümleriyle farklı av planları gerektirir."}</p><ul>{items.filter((m)=>m.zone===zone).slice(0,6).map((m)=><li><a href={`/meralar/${m.slug}/`}>{m.name}</a></li>)}</ul></div>)}</div></section>}<section class="info-block"><span class="kicker">Raporlanan türler</span><h2>{province} rota dosyalarında hangi balıklar geçiyor?</h2><p>Bu liste, ilgili türün en az bir rota dosyasında raporlandığını gösterir. Balığın her mevsim veya her gün kıyıda bulunacağı anlamına gelmez.</p><div class="tag-row large-tags">{fish.map((f)=><span>{f}</span>)}</div></section></section><section class="container section"><div class="section-heading"><div><span class="kicker">Tüm rota dosyaları</span><h2>{province} meraları</h2></div><p>Güven seviyesi ve son güncelleme tarihini her dosyada kontrol et.</p></div><div class="card-grid">{items.map((m)=><MeraCard mera={m}/>)}</div></section></BaseLayout>
