---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import MeraCard from "../../../components/MeraCard.astro";
import { meralar, provinces } from "../../../data/meralar-tumu";
import { slugifyTr } from "../../../utils/slug";

export function getStaticPaths(){
  return provinces.map((province)=>({params:{province:slugifyTr(province)},props:{province}}));
}

const {province}=Astro.props;
const items=meralar.filter((m)=>m.province===province);
const verifiedItems=items.filter((m)=>m.confidence!=="D");
const preliminaryItems=items.filter((m)=>m.confidence==="D");
const orderedItems=[...verifiedItems,...preliminaryItems];
const districts=[...new Set(items.map((m)=>m.district))].sort((a,b)=>a.localeCompare(b,"tr"));
const zones=[...new Set(items.map((m)=>m.zone))];
const fish=[...new Set(items.flatMap((m)=>m.fish))].sort((a,b)=>a.localeCompare(b,"tr"));
const preliminaryCount=preliminaryItems.length;
const pageUrl=new URL(`/iller/${slugifyTr(province)}/`,Astro.site).href;

const locative=(name:string)=>{
  const lower=name.toLocaleLowerCase("tr-TR");
  const vowels=[...lower].filter((letter)=>"aeıioöuü".includes(letter));
  const lastVowel=vowels.at(-1) || "e";
  const back="aıou".includes(lastVowel);
  const lastLetter=lower.at(-1) || "";
  const hard="fstkçşhp".includes(lastLetter);
  return `${name}'${hard?(back?"ta":"te"):(back?"da":"de")}`;
};

const provinceLocative=locative(province);
const isKirikkale=province==="Kırıkkale";
const seoTitle=isKirikkale?`Kırıkkale'de Balık Tutulacak Yerler: Hirfanlı ve Kapulukaya`:`${provinceLocative} Balık Tutulacak Yerler ve Avlaklar`;
const seoDescription=isKirikkale
  ? `Kırıkkale'de balık tutulacak yerler: Hirfanlı ve Kapulukaya başta olmak üzere ${items.length} rotayı tür, ulaşım, güven seviyesi ve güncel içsu notlarıyla karşılaştır.`
  : `${provinceLocative} balık tutulacak yerleri keşfet: ${items.length} rota, ${verifiedItems.length} güçlü doğrulama ve ${preliminaryCount} genel konumlu rota.`;
const schema={
  "@context":"https://schema.org",
  "@type":"CollectionPage",
  "@id":pageUrl,
  name:seoTitle,
  description:seoDescription,
  about:{"@type":"Place",name:`${province}, Türkiye`},
  mainEntity:{
    "@type":"ItemList",
    itemListElement:items.map((m,index)=>({
      "@type":"ListItem",
      position:index+1,
      url:new URL(`/meralar/${m.slug}/`,Astro.site).href,
      name:m.name
    }))
  }
};

const provinceIntros:Record<string,string[]>={
  "İstanbul":[
    "İstanbul, Boğaz, Haliç, Marmara ve Karadeniz geçişlerini aynı şehir sınırında buluşturduğu için tek tip bir kıyı avı sunmaz.",
    "Koordinatlar çoğunlukla genel kamusal erişim bölgesini gösterir; iskele, marina, liman, yüzme alanı ve etkinlik sahası sınırları yerinde kontrol edilmelidir."
  ],
  "Kocaeli":[
    "Kocaeli, Marmara kıyısı, İzmit Körfezi, Karadeniz sahilleri ve iç su rotalarını kısa mesafelerde bir araya getirir.",
    "Güven D rotalarında da konum bilgisi sunulur; son kıyı girişi, av uygunluğu ve saha koşulları hareket günü ayrıca kontrol edilmelidir."
  ],
  "Kırıkkale":[
    "Kırıkkale rota kataloğunda Hirfanlı Baraj Gölü ve Kapulukaya Baraj Gölü gibi Kızılırmak havzasındaki büyük içsu sistemleri öne çıkar; aynı su alanı içindeki farklı kıyı cepleri ancak ayrı erişim ve resmî sınır kanıtı varsa ayrı rota olarak tutulur.",
    "İçsu planında kapalı dönem, boy-adet limitleri, baraj işletme alanları ve kıyıya fiilî kamusal erişim birlikte kontrol edilmelidir; tür kaydı tek başına belirli kıyıda av yapılabileceği anlamına gelmez."
  ],
  "Yalova":[
    "Yalova kıyıları Güney Marmara'da koy, burun, dere ağzı ve düzenlenmiş sahil bölümlerini kısa mesafelerde birleştirir.",
    "Turizm yoğunluğu, yüzme alanları ve yerel kıyı kullanımı her rota için yerinde kontrol edilmelidir."
  ],
  "Sakarya":[
    "Sakarya'nın Karadeniz kıyıları uzun kum plajları, açık deniz dalgası ve mevsimsel göç balıklarıyla öne çıkar.",
    "Dalga, kıyı akıntısı ve yüzme alanı güvenliği av planının temel parçasıdır."
  ],
  "Bursa":[
    "Bursa'nın Marmara kıyıları mesire alanları, yerleşim içi sahiller ve aktif balıkçı barınaklarını bir araya getirir.",
    "Barınak operasyon sahaları ile kamusal kıyı bölümleri kesin biçimde ayrılmalıdır."
  ]
};
const intro=provinceIntros[province]||[
  `${province} için yayımlanan rotalar açık kaynaklarda kayıtlı su varlıklarını ve varsa daha ayrıntılı doğrulanmış rotaları aynı merkezde toplar.`,
  `Güven D rotaları da kullanıcıyı konuma götürecek harita bilgisi veya adla harita araması sunar; mikro kıyı erişimi, avlanma uygunluğu, balık türleri ve fiziki koşullar ayrıca kontrol edilmelidir.`
];
---
<BaseLayout title={seoTitle} description={seoDescription}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}/>

  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={[{label:"Ana sayfa",href:"/"},{label:"İller",href:"/iller/"},{label:province}]}/>
      <span class="kicker">{items.length} rota · {preliminaryCount} genel konumlu rota</span>
      <h1>{provinceLocative} balık tutulacak yerler</h1>
      <p class="lead">{provinceLocative} balık tutmak için bakabileceğin kıyı ve iç su rotalarını; konum, ilçe, su tipi, kaynak düzeyi, güven seviyesi ve saha notlarıyla karşılaştır.</p>
      <div class="detail-actions">
        <a class="button" href="#ilceler">İlçelere göre incele</a>
        <a class="button button-ghost" href="#rotalar">Tüm rotaları gör</a>
      </div>
    </div>
  </section>

  <section class="container section article-prose">
    <section class="article-intro">
      <h2>{provinceLocative} nerede balık tutulur?</h2>
      <p>{province} için katalogda {verifiedItems.length} güçlü doğrulamalı rota, {preliminaryCount} genel konumlu rota ve {districts.length} konum grubu bulunuyor. Güven seviyesi sayfanın yayımlanma durumunu değil, kanıt derinliğini gösterir.</p>
      {intro.map((p:string)=><p>{p}</p>)}
    </section>

    <div class="city-summary-grid">
      <div><strong>{items.length}</strong><span>Avlak rotası</span></div>
      <div><strong>{districts.length}</strong><span>Konum grubu</span></div>
      <div><strong>{zones.length}</strong><span>Bölge</span></div>
      <div><strong>{fish.length}</strong><span>Raporlanan tür</span></div>
    </div>

    <section class="info-block" id="ilceler">
      <span class="kicker">İlçelere göre keşfet</span>
      <h2>{provinceLocative} balık tutulacak yerleri ilçelere göre karşılaştır</h2>
      <div class="district-link-grid">
        {districts.map((district)=>{
          const districtItems=items.filter((m)=>m.district===district);
          const count=districtItems.length;
          const href=count>=2?`/iller/${slugifyTr(province)}/${slugifyTr(district)}/`:`/meralar/${districtItems[0].slug}/`;
          return <a id={slugifyTr(district)} href={href}><strong>{locative(district)} balık tutulacak yerler</strong><span>{count} rota</span></a>;
        })}
      </div>
    </section>

    {province==="İstanbul"&&<section class="info-block">
      <span class="kicker">İki yaka, farklı koşullar</span>
      <h2>Avrupa ve Anadolu Yakası nasıl ayrılıyor?</h2>
      <div class="zone-columns">{zones.map((zone)=><div><h3>{zone}</h3><ul>{items.filter((m)=>m.zone===zone).slice(0,6).map((m)=><li><a href={`/meralar/${m.slug}/`}>{m.name}</a></li>)}</ul></div>)}</div>
    </section>}

    <section class="info-block">
      <span class="kicker">Raporlanan türler</span>
      <h2>{province} rotalarında hangi balıklar kaynaklarla destekleniyor?</h2>
      {fish.length>0?<><p>Bu liste, ilgili türün en az bir rotada raporlandığını gösterir. Balığın her mevsim veya her gün bulunacağı anlamına gelmez.</p><div class="tag-row large-tags">{fish.map((f)=><span>{f}</span>)}</div></>:<div class="warning-box"><p>Bu ildeki bazı Güven D rotalarında rota özelinde yeterli tür kaynağı henüz bulunmuyor. Konumu göstermeye devam ediyor, tür bilgisini ise tahminle doldurmuyoruz.</p></div>}
    </section>

    <section class="info-block">
      <span class="kicker">Saha kontrolü</span>
      <h2>Rota bilgisini kullanmadan önce ne kontrol edilmeli?</h2>
      <p>Olta Atlası bir noktaya giriş veya avlanma izni vermez. Özel mülkiyet, koruma statüsü, geçici kapatma, kıyı erişimi, hava, ulaşım ve güncel mevzuat yola çıkmadan önce ayrıca doğrulanmalıdır. Güven D olan {preliminaryCount} rotada konum planlama başlangıcıdır; son kıyı girişi ve av uygunluğu hareket günü ayrıca kontrol edilmelidir.</p>
    </section>
  </section>

  <section class="container section" id="rotalar">
    <div class="section-heading">
      <div><span class="kicker">Tüm avlak rotaları</span><h2>{provinceLocative} balıkçılık rotaları ve konumları</h2></div>
      <p>Konum hassasiyetini, güven seviyesini, kaynak kapsamını ve son güncelleme tarihini her rotada kontrol et.</p>
    </div>
    <div class="card-grid">{orderedItems.map((m)=><MeraCard mera={m}/>)}</div>
  </section>
</BaseLayout>
