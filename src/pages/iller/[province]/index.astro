---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import MeraCard from "../../../components/MeraCard.astro";
import { meralar, provinces } from "../../../data/meralar-tumu";
import { slugifyTr } from "../../../utils/slug";

export function getStaticPaths(){
  return provinces.map((province)=>({params:{province:slugifyTr(province)},props:{province}}));
}

const {province}=Astro.props;
const items=meralar.filter((m)=>m.province===province);
const indexableItems=items.filter((m)=>m.confidence!=="D");
const preliminaryItems=items.filter((m)=>m.confidence==="D");
const orderedItems=[...indexableItems,...preliminaryItems];
const districts=[...new Set(items.map((m)=>m.district))].sort((a,b)=>a.localeCompare(b,"tr"));
const zones=[...new Set(items.map((m)=>m.zone))];
const fish=[...new Set(indexableItems.flatMap((m)=>m.fish))].sort((a,b)=>a.localeCompare(b,"tr"));
const preliminaryCount=preliminaryItems.length;
const noindex=indexableItems.length===0;
const pageUrl=new URL(`/iller/${slugifyTr(province)}/`,Astro.site).href;

const locative=(name:string)=>{
  const lower=name.toLocaleLowerCase("tr-TR");
  const vowels=[...lower].filter((letter)=>"aeıioöuü".includes(letter));
  const lastVowel=vowels.at(-1) || "e";
  const back="aıou".includes(lastVowel);
  const lastLetter=lower.at(-1) || "";
  const hard="fstkçşhp".includes(lastLetter);
  return `${name}'${hard?(back?"ta":"te"):(back?"da":"de")}`;
};

const provinceLocative=locative(province);
const seoTitle=noindex?`${province} Balıkçılık Rota Araştırmaları`:`${provinceLocative} Balık Tutulacak Yerler ve Avlaklar`;
const seoDescription=noindex
  ? `${province} için erişim ve avlanma durumu henüz güçlü kanıtla doğrulanmamış ${preliminaryCount} ön araştırma kaydı.`
  : `${provinceLocative} balık tutulacak yerleri keşfet: ${indexableItems.length} doğrulanabilir rota, ${preliminaryCount} ön araştırma kaydı, ulaşım ve saha güvenliği notları.`;
const schema={
  "@context":"https://schema.org",
  "@type":"CollectionPage",
  "@id":pageUrl,
  name:seoTitle,
  description:seoDescription,
  about:{"@type":"Place",name:`${province}, Türkiye`},
  mainEntity:{
    "@type":"ItemList",
    itemListElement:indexableItems.map((m,index)=>({
      "@type":"ListItem",
      position:index+1,
      url:new URL(`/meralar/${m.slug}/`,Astro.site).href,
      name:m.name
    }))
  }
};

const provinceIntros:Record<string,string[]>={
  "İstanbul":[
    "İstanbul, Boğaz, Haliç, Marmara ve Karadeniz geçişlerini aynı şehir sınırında buluşturduğu için tek tip bir kıyı avı sunmaz.",
    "Koordinatlar çoğunlukla genel kamusal erişim bölgesini gösterir; iskele, marina, liman, yüzme alanı ve etkinlik sahası sınırları yerinde kontrol edilmelidir."
  ],
  "Kocaeli":[
    "Kocaeli, Marmara kıyısı, İzmit Körfezi, Karadeniz sahilleri ve iç su rotalarını kısa mesafelerde bir araya getirir.",
    "Güven seviyesi düşük kayıtlar kesin av noktası olarak değil, saha doğrulaması bekleyen planlama dosyası olarak okunmalıdır."
  ],
  "Yalova":[
    "Yalova kıyıları Güney Marmara'da koy, burun, dere ağzı ve düzenlenmiş sahil bölümlerini kısa mesafelerde birleştirir.",
    "Turizm yoğunluğu, yüzme alanları ve yerel kıyı kullanımı her rota için yerinde kontrol edilmelidir."
  ],
  "Sakarya":[
    "Sakarya'nın Karadeniz kıyıları uzun kum plajları, açık deniz dalgası ve mevsimsel göç balıklarıyla öne çıkar.",
    "Dalga, kıyı akıntısı ve yüzme alanı güvenliği av planının temel parçasıdır."
  ],
  "Bursa":[
    "Bursa'nın Marmara kıyıları mesire alanları, yerleşim içi sahiller ve aktif balıkçı barınaklarını bir araya getirir.",
    "Barınak operasyon sahaları ile kamusal kıyı bölümleri kesin biçimde ayrılmalıdır."
  ]
};
const intro=provinceIntros[province]||[
  `${province} için yayımlanan dosyalar açık kaynaklarda kayıtlı su varlıklarını ve varsa daha ayrıntılı doğrulanmış rotaları aynı merkezde toplar.`,
  `Güven D kayıtları yalnızca araştırma başlangıcıdır; kıyı erişimi, avlanma izni, balık türleri ve fiziki koşullar resmî kaynaklardan ve yerinde ayrıca doğrulanmalıdır.`
];
---
<BaseLayout title={seoTitle} description={seoDescription} noindex={noindex}>
  {!noindex&&<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}/>}

  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={[{label:"Ana sayfa",href:"/"},{label:"İller",href:"/iller/"},{label:province}]}/>
      <span class="kicker">{indexableItems.length} doğrulanabilir rota · {preliminaryCount} ön araştırma</span>
      <h1>{noindex?`${province} balıkçılık rota araştırmaları`:`${provinceLocative} balık tutulacak yerler`}</h1>
      <p class="lead">{noindex?`${province} için henüz avlak veya kamusal kullanım kanıtı tamamlanmamış su varlığı dosyalarını incele.`:`${provinceLocative} balık tutmak için araştırabileceğin kıyı ve iç su rotalarını; ilçe, su tipi, kaynak düzeyi, güven seviyesi ve saha notlarıyla karşılaştır.`}</p>
      <div class="detail-actions">
        <a class="button" href="#ilceler">İlçelere göre incele</a>
        <a class="button button-ghost" href="#rotalar">Tüm rotaları gör</a>
      </div>
    </div>
  </section>

  <section class="container section article-prose">
    <section class="article-intro">
      <h2>{noindex?`${province} araştırma dosyalarının durumu`:`${provinceLocative} nerede balık tutulur?`}</h2>
      <p>{province} için katalogda {indexableItems.length} doğrulanabilir rota, {preliminaryCount} ön araştırma kaydı ve {districts.length} konum grubu bulunuyor. Önce ilçeyi seçip ardından rota dosyalarındaki kıyı karakteri, ulaşım ve doğrulama notlarını karşılaştırabilirsin.</p>
      {intro.map((p:string)=><p>{p}</p>)}
    </section>

    <div class="city-summary-grid">
      <div><strong>{items.length}</strong><span>Rota dosyası</span></div>
      <div><strong>{districts.length}</strong><span>Konum grubu</span></div>
      <div><strong>{zones.length}</strong><span>Bölge</span></div>
      <div><strong>{fish.length}</strong><span>Raporlanan tür</span></div>
    </div>

    <section class="info-block" id="ilceler">
      <span class="kicker">İlçelere göre keşfet</span>
      <h2>{provinceLocative} balık tutulacak yerleri ilçelere göre karşılaştır</h2>
      <div class="district-link-grid">
        {districts.map((district)=>{
          const districtItems=items.filter((m)=>m.district===district);
          const count=districtItems.length;
          const href=count>=2?`/iller/${slugifyTr(province)}/${slugifyTr(district)}/`:`/meralar/${districtItems[0].slug}/`;
          return <a id={slugifyTr(district)} href={href}><strong>{locative(district)} balık tutulacak yerler</strong><span>{count} rota dosyası</span></a>;
        })}
      </div>
    </section>

    {province==="İstanbul"&&<section class="info-block">
      <span class="kicker">İki yaka, farklı koşullar</span>
      <h2>Avrupa ve Anadolu Yakası nasıl ayrılıyor?</h2>
      <div class="zone-columns">{zones.map((zone)=><div><h3>{zone}</h3><ul>{items.filter((m)=>m.zone===zone).slice(0,6).map((m)=><li><a href={`/meralar/${m.slug}/`}>{m.name}</a></li>)}</ul></div>)}</div>
    </section>}

    <section class="info-block">
      <span class="kicker">Raporlanan türler</span>
      <h2>{province} rota dosyalarında hangi balıklar kaynaklarla destekleniyor?</h2>
      {fish.length>0?<><p>Bu liste, ilgili türün en az bir rota dosyasında raporlandığını gösterir. Balığın her mevsim veya her gün bulunacağı anlamına gelmez.</p><div class="tag-row large-tags">{fish.map((f)=><span>{f}</span>)}</div></>:<div class="warning-box"><p>Bu ildeki yeni ön değerlendirme kayıtlarında rota bazında doğrulanmış tür listesi yayımlanmamıştır. Bölgesel tahmin eklenmemiştir.</p></div>}
    </section>

    <section class="info-block">
      <span class="kicker">Saha kontrolü</span>
      <h2>Rota bilgisini kullanmadan önce ne kontrol edilmeli?</h2>
      <p>Olta Atlası bir noktaya giriş veya avlanma izni vermez. Özel mülkiyet, koruma statüsü, geçici kapatma, kıyı erişimi, hava, ulaşım ve güncel mevzuat yola çıkmadan önce ayrıca doğrulanmalıdır. {preliminaryCount} ön değerlendirme kaydı kesin av noktası olarak değil araştırma başlangıcı olarak okunmalıdır.</p>
    </section>
  </section>

  <section class="container section" id="rotalar">
    <div class="section-heading">
      <div><span class="kicker">Tüm rota dosyaları</span><h2>{provinceLocative} araştırılan balıkçılık rotaları</h2></div>
      <p>Güven seviyesi, kaynak kapsamı ve son güncelleme tarihini her dosyada kontrol et.</p>
    </div>
    <div class="card-grid">{orderedItems.map((m)=><MeraCard mera={m}/>)}</div>
  </section>
</BaseLayout>
