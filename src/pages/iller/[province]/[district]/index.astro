---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../../components/Breadcrumbs.astro";
import MeraCard from "../../../../components/MeraCard.astro";
import { meralar } from "../../../../data/meralar";
import { slugifyTr } from "../../../../utils/slug";
export function getStaticPaths(){const groups=[...new Map(meralar.map((m)=>[`${m.province}|${m.district}`,{province:m.province,district:m.district}])).values()].filter((g)=>meralar.filter((m)=>m.province===g.province&&m.district===g.district).length>=2);return groups.map((g)=>({params:{province:slugifyTr(g.province),district:slugifyTr(g.district)},props:g}));}
const {province,district}=Astro.props;const items=meralar.filter((m)=>m.province===province&&m.district===district);const fish=[...new Set(items.flatMap((m)=>m.fish))].sort((a,b)=>a.localeCompare(b,"tr"));const methods=[...new Set(items.flatMap((m)=>m.methods))].sort((a,b)=>a.localeCompare(b,"tr"));const provinceUrl=`/iller/${slugifyTr(province)}/`;const pageUrl=new URL(`${provinceUrl}${slugifyTr(district)}/`,Astro.site).href;const schema={"@context":"https://schema.org","@type":"CollectionPage","@id":pageUrl,name:`${district} Balık Tutulacak Yerler`,description:`${district}, ${province} içindeki balıkçılık rotaları ve saha notları.`,mainEntity:{"@type":"ItemList",itemListElement:items.map((m,index)=>({"@type":"ListItem",position:index+1,url:new URL(`/meralar/${m.slug}/`,Astro.site).href,name:m.name}))}};
---
<BaseLayout title={`${district} Balık Tutulacak Yerler`} description={`${district}, ${province} çevresinde balık tutulacak yerler, raporlanan türler, ulaşım ve güvenlik notları.`}><script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}/><section class="page-hero"><div class="container"><Breadcrumbs items={[{label:"Ana sayfa",href:"/"},{label:"İller",href:"/iller/"},{label:province,href:provinceUrl},{label:district}]}/><span class="kicker">{items.length} rota dosyası</span><h1>{district} balık tutulacak yerler</h1><p class="lead">{district}, {province} kıyılarındaki rota dosyalarını ulaşım, su karakteri, raporlanan balıklar ve saha riskleriyle karşılaştır.</p></div></section><section class="container section article-prose"><section class="article-intro"><p>{district} için hazırlanan bu merkez sayfa, aynı ilçe içindeki farklı kıyı bölümlerini tek bir “kesin mera” gibi göstermemek için oluşturuldu. İskele, park, köprü, marina ve açık sahil aynı güvenlik ve takım koşullarına sahip değildir.</p><p>Rota dosyalarına geçmeden önce güncel hava, ulaşım, yerel yasak ve kıyı kullanım durumunu doğrula. İstanbul’da etkinlik, iskele işletmesi veya güvenlik çalışması; Kocaeli’de ise su seviyesi, özel mülkiyet ve mevsimsel tesis durumu erişimi değiştirebilir.</p></section><div class="info-grid"><section class="info-card"><span>🐟</span><h2>Raporlanan balıklar</h2><ul>{fish.map((f)=><li>{f}</li>)}</ul></section><section class="info-card"><span>🎣</span><h2>Geçen yöntemler</h2><ul>{methods.map((m)=><li>{m}</li>)}</ul></section></div></section><section class="container section"><div class="card-grid">{items.map((m)=><MeraCard mera={m}/>)}</div></section></BaseLayout>
