---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../../components/Breadcrumbs.astro";
import MeraCard from "../../../../components/MeraCard.astro";
import { meralar } from "../../../../data/meralar-tumu";
import { slugifyTr } from "../../../../utils/slug";
export function getStaticPaths(){const groups=[...new Map(meralar.map((m)=>[`${m.province}|${m.district}`,{province:m.province,district:m.district}])).values()].filter((g)=>meralar.filter((m)=>m.province===g.province&&m.district===g.district).length>=2);return groups.map((g)=>({params:{province:slugifyTr(g.province),district:slugifyTr(g.district)},props:g}));}
const {province,district}=Astro.props;const items=meralar.filter((m)=>m.province===province&&m.district===district);const fish=[...new Set(items.flatMap((m)=>m.fish))].sort((a,b)=>a.localeCompare(b,"tr"));const methods=[...new Set(items.flatMap((m)=>m.methods))].sort((a,b)=>a.localeCompare(b,"tr"));const provinceUrl=`/iller/${slugifyTr(province)}/`;const pageUrl=new URL(`${provinceUrl}${slugifyTr(district)}/`,Astro.site).href;const schema={"@context":"https://schema.org","@type":"CollectionPage","@id":pageUrl,name:`${district} Balıkçılık Rotaları`,description:`${district}, ${province} içindeki balıkçılık rotaları ve saha kontrol notları.`,mainEntity:{"@type":"ItemList",itemListElement:items.map((m,index)=>({"@type":"ListItem",position:index+1,url:new URL(`/meralar/${m.slug}/`,Astro.site).href,name:m.name}))}};
---
<BaseLayout title={`${district} Balıkçılık Rotaları`} description={`${district}, ${province} çevresindeki rota, ön değerlendirme, ulaşım ve güvenlik notları.`}><script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}/><section class="page-hero"><div class="container"><Breadcrumbs items={[{label:"Ana sayfa",href:"/"},{label:"İller",href:"/iller/"},{label:province,href:provinceUrl},{label:district}]}/><span class="kicker">{items.length} rota dosyası</span><h1>{district} balıkçılık rotaları</h1><p class="lead">{district}, {province} için yayımlanan dosyaları kaynak düzeyi, su karakteri, erişim durumu ve saha riskleriyle karşılaştır.</p></div></section><section class="container section article-prose"><section class="article-intro"><p>Bu merkez sayfa, aynı il veya ilçe içindeki farklı su varlıklarını tek bir kesin av noktası gibi göstermemek için oluşturuldu. Güven D kayıtları yalnızca açık kaynak araştırma başlangıcıdır; kamusal erişim veya avlanma izni değildir.</p><p>Rota dosyasına geçmeden önce güncel hava ve su koşullarını, ulaşımı, özel mülkiyeti, koruma statüsünü, yerel yasakları ve kıyı kullanım durumunu resmî kaynaklardan doğrula.</p></section><div class="info-grid"><section class="info-card"><span>🐟</span><h2>Doğrulanmış balıklar</h2>{fish.length?<ul>{fish.map((f)=><li>{f}</li>)}</ul>:<p>Bu grupta rota bazında doğrulanmış tür bilgisi henüz bulunmuyor.</p>}</section><section class="info-card"><span>🎣</span><h2>Doğrulanmış yöntemler</h2>{methods.length?<ul>{methods.map((m)=><li>{m}</li>)}</ul>:<p>Bu grupta rota bazında doğrulanmış yöntem bilgisi henüz bulunmuyor.</p>}</section></div></section><section class="container section"><div class="card-grid">{items.map((m)=><MeraCard mera={m}/>)}</div></section></BaseLayout>
