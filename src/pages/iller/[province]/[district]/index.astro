---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../../components/Breadcrumbs.astro";
import MeraCard from "../../../../components/MeraCard.astro";
import { meralar } from "../../../../data/meralar-tumu";
import { slugifyTr } from "../../../../utils/slug";

export function getStaticPaths(){
  const groups=[...new Map(meralar.map((m)=>[`${m.province}|${m.district}`,{province:m.province,district:m.district}])).values()]
    .filter((g)=>meralar.filter((m)=>m.province===g.province&&m.district===g.district).length>=2);
  return groups.map((g)=>({params:{province:slugifyTr(g.province),district:slugifyTr(g.district)},props:g}));
}

const {province,district}=Astro.props;
const items=meralar.filter((m)=>m.province===province&&m.district===district);
const fish=[...new Set(items.flatMap((m)=>m.fish))].sort((a,b)=>a.localeCompare(b,"tr"));
const methods=[...new Set(items.flatMap((m)=>m.methods))].sort((a,b)=>a.localeCompare(b,"tr"));
const waterTypes=[...new Set(items.map((m)=>m.waterType))].sort((a,b)=>a.localeCompare(b,"tr"));
const provinceUrl=`/iller/${slugifyTr(province)}/`;
const pageUrl=new URL(`${provinceUrl}${slugifyTr(district)}/`,Astro.site).href;

const locative=(name:string)=>{
  const lower=name.toLocaleLowerCase("tr-TR");
  const vowels=[...lower].filter((letter)=>"aeıioöuü".includes(letter));
  const lastVowel=vowels.at(-1) || "e";
  const back="aıou".includes(lastVowel);
  const lastLetter=lower.at(-1) || "";
  const hard="fstkçşhp".includes(lastLetter);
  return `${name}'${hard?(back?"ta":"te"):(back?"da":"de")}`;
};

const indexedLegacyProvinceWidePages=new Set(["Adana","Adıyaman"]);
const isProvinceWide=district==="İl geneli";
const preserveIndexedLegacyTitle=isProvinceWide&&indexedLegacyProvinceWidePages.has(province);
const seoLocationName=isProvinceWide&&!preserveIndexedLegacyTitle?province:district;
const districtLocative=locative(seoLocationName);
const isBeykoz=province==="İstanbul"&&district==="Beykoz";
const beykozHighlights=isBeykoz
  ? ["Paşabahçe","Kanlıca","Çubuklu","Küçüksu"].map((keyword)=>items.find((route)=>route.name.includes(keyword))).filter((route):route is typeof items[number]=>Boolean(route))
  : [];
const seoTitle=isBeykoz?`${items.length} Rota: Beykoz’da Balık Tutulacak Yerler`:`${districtLocative} Balık Tutulacak Yerler ve Avlaklar`;
const seoDescription=isBeykoz
  ? `Beykoz’da ${items.length} gerçek rota dosyasını karşılaştır: ${beykozHighlights.map((route)=>route.name).join(", ")}. Ulaşım, kıyı yapısı ve güncel saha uyarıları.`
  : `${districtLocative} balık tutulacak yerleri karşılaştır: ${items.length} rota, raporlanan balık türleri, kıyı yapısı, ulaşım, yöntem ve saha güvenliği notları.`;
const previewRoutes=items.slice(0,5);
const previewFish=fish.slice(0,8);
const schema={
  "@context":"https://schema.org",
  "@type":"CollectionPage",
  "@id":pageUrl,
  name:seoTitle,
  description:seoDescription,
  about:[
    {"@type":"Place",name:`${district}, ${province}`},
    ...previewFish.map((name)=>({"@type":"Thing",name}))
  ],
  mainEntity:{
    "@type":"ItemList",
    itemListElement:items.map((m,index)=>({
      "@type":"ListItem",
      position:index+1,
      url:new URL(`/meralar/${m.slug}/`,Astro.site).href,
      name:m.name
    }))
  }
};
---
<BaseLayout title={seoTitle} description={seoDescription}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}/>

  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={[{label:"Ana sayfa",href:"/"},{label:"İller",href:"/iller/"},{label:province,href:provinceUrl},{label:district}]}/>
      <span class="kicker">{items.length} araştırılmış rota</span>
      <h1>{districtLocative} balık tutulacak yerler</h1>
      <p class="lead">{districtLocative} balık tutmak için araştırabileceğin rota dosyalarını; raporlanan türler, kıyı karakteri, ulaşım ve saha notlarıyla tek yerde karşılaştır.</p>
      <div class="detail-actions">
        <a class="button" href="#rotalar">Rotaları karşılaştır</a>
        {fish.length>0&&<a class="button button-ghost" href="#baliklar">Balık türlerini gör</a>}
      </div>
    </div>
  </section>

  <section class="container section article-prose">
    <section class="article-intro">
      <h2>{districtLocative} nerede balık tutulur?</h2>
      <p>{district} için şu anda {items.length} rota dosyası bulunuyor. {waterTypes.length>0?`Katalogda ${waterTypes.join(", ")} karakterindeki sular yer alıyor. `:""}Aşağıdaki kartlardan kıyı yapısı, ulaşım, raporlanan balıklar ve doğrulama düzeyi sana uygun olan rotaları karşılaştırabilirsin.</p>
      {previewRoutes.length>0&&<p>Öne çıkan dosyalardan bazıları: {previewRoutes.map((route)=>route.name).join(", ")}. Bu liste av garantisi değil; araştırmaya nereden başlayacağını gösteren bir rota indeksidir.</p>}
    </section>

    {isBeykoz&&beykozHighlights.length>0&&<section class="quick-compare" aria-labelledby="beykoz-hizli-karsilastirma">
      <div class="section-heading">
        <div><span class="kicker">Mobil hızlı karşılaştırma</span><h2 id="beykoz-hizli-karsilastirma">Beykoz’un öne çıkan kıyı rotaları</h2></div>
        <p>Ulaşım ve risk özeti; ayrıntı için rota dosyasını aç.</p>
      </div>
      <div class="quick-compare-grid">
        {beykozHighlights.map((route)=><article>
          <div><strong><a href={`/meralar/${route.slug}/`}>{route.name}</a></strong><span>{route.waterType} · Güven {route.confidence}</span></div>
          <dl>
            <div><dt>Araç</dt><dd>{route.confidence==="D"?"Kontrol edilmeli":route.vehicleAccess}</dd></div>
            <div><dt>Son yaklaşım</dt><dd>{route.transport}</dd></div>
            <div><dt>Öne çıkan uyarı</dt><dd>{route.cautions[0]}</dd></div>
          </dl>
          <a class="quick-link" href={`/meralar/${route.slug}/`}>Rota ayrıntısını aç →</a>
        </article>)}
      </div>
    </section>}

    <div class="info-grid">
      <section class="info-card" id="baliklar">
        <span>🐟</span>
        <h2>Hangi balıklar raporlanıyor?</h2>
        {fish.length?<><p>{district} rota dosyalarında öne çıkan türler:</p><ul>{fish.map((f)=><li>{f}</li>)}</ul></>:<p>Bu grupta rota bazında kaynakla desteklenmiş tür bilgisi henüz bulunmuyor.</p>}
      </section>
      <section class="info-card">
        <span>🎣</span>
        <h2>Hangi yöntemler öne çıkıyor?</h2>
        {methods.length?<ul>{methods.map((m)=><li>{m}</li>)}</ul>:<p>Bu grupta rota bazında doğrulanmış yöntem bilgisi henüz bulunmuyor.</p>}
      </section>
    </div>

    <section class="info-block">
      <span class="kicker">Önce saha koşulu</span>
      <h2>Rota bilgisini nasıl kullanmalı?</h2>
      <p>Olta Atlası bir noktaya giriş veya avlanma izni vermez. Rota dosyaları açık kaynak araştırmasını düzenler; özel mülkiyet, koruma statüsü, geçici kapatma, kıyı erişimi, hava ve güncel mevzuat yola çıkmadan önce ayrıca kontrol edilmelidir.</p>
      <p>Güven D kayıtları yalnızca araştırma başlangıcıdır. Harita pini bulunan bir dosyada bile koordinat, kamusal kıyı girişi veya güvenli araç yaklaşımı anlamına gelmez.</p>
    </section>
  </section>

  <section class="container section" id="rotalar">
    <div class="section-heading">
      <div>
        <span class="kicker">Rota listesi</span>
        <h2>{districtLocative} araştırılan balıkçılık rotaları</h2>
      </div>
      <p>{items.length} dosyayı karşılaştır; her rota kendi kaynak, doğrulama ve saha notlarını taşır.</p>
    </div>
    <div class="card-grid">{items.map((m)=><MeraCard mera={m}/>)}</div>
  </section>
</BaseLayout>

<style>
  .quick-compare{margin:2.5rem 0}.quick-compare-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.quick-compare article{display:flex;flex-direction:column;gap:14px;padding:20px;border:1px solid var(--line);border-radius:18px;background:#fff;box-shadow:0 10px 30px rgba(10,51,64,.05)}.quick-compare article>div:first-child{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}.quick-compare article>div:first-child span{color:var(--muted);font-size:.82rem;white-space:nowrap}.quick-compare strong a{color:var(--ink);text-decoration:none}.quick-compare dl{display:grid;gap:10px;margin:0}.quick-compare dl>div{display:grid;grid-template-columns:105px minmax(0,1fr);gap:12px;padding-top:10px;border-top:1px solid var(--line)}.quick-compare dt{color:var(--muted);font-size:.78rem;font-weight:800;text-transform:uppercase}.quick-compare dd{margin:0;color:var(--ink);font-size:.92rem}.quick-link{margin-top:auto;font-weight:850}
  @media(max-width:760px){.quick-compare-grid{grid-template-columns:1fr}.quick-compare article{padding:17px}.quick-compare article>div:first-child{flex-direction:column;gap:4px}.quick-compare dl>div{grid-template-columns:1fr;gap:4px}.quick-compare article>div:first-child span{white-space:normal}}
</style>
