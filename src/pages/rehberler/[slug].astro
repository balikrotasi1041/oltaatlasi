---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FeedbackButtons from "../../components/FeedbackButtons.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { rehberler } from "../../data/rehber-katalogu";
import { meralar } from "../../data/meralar-tumu";
import { baliklar } from "../../data/baliklar";

export function getStaticPaths(){return rehberler.map((rehber)=>({params:{slug:rehber.slug},props:{rehber}}));}
const {rehber}=Astro.props;
const pagePath=`/rehberler/${rehber.slug}/`;
const pageUrl=new URL(pagePath,Astro.site).href;
const categoryContext: Record<string,string>={
 "Teknik":"Teknik bir yöntemi öğrenirken önce sade ve kontrol edilebilir bir takım kurmak, sonucu ekipman kalabalığından daha fazla iyileştirir.",
 "Düğüm":"Bir düğümün adı kadar ipin türü, çapı, ıslatılması ve kontrollü sıkılması da bağlantının güvenilirliğini belirler.",
 "Yem":"Yem seçimi yalnızca balığın adıyla değil, su sıcaklığı, küçük balık baskısı, dip yapısı ve sunum biçimiyle birlikte düşünülmelidir.",
 "Güvenlik":"Saha güvenliği, balık çıktıktan sonra değil kıyıya varmadan önce başlayan bir planlama işidir.",
 "Kamp":"Balık kampında konforun temeli fazla eşya değil; kuru kalmak, suya erişmek, dönüş planını bilmek ve iz bırakmamaktır.",
 "Mera":"Bir mera bilgisi, tarihi ve kaynağı yoksa yalnızca duyumdur. Yayınlanmadan önce erişim, mülkiyet ve mevzuat açısından ayrıştırılmalıdır.",
 "Hava":"Hava tahmini tek bir ikon değildir; rüzgâr yönü, hamle, yağış, sıcaklık ve deniz durumu birlikte okunmalıdır."
};
const context=categoryContext[rehber.category] || "Bu rehber, sahada uygulanabilir küçük adımları tek bir akışta toplar. Her madde mera, hava ve mevzuat koşullarına göre yeniden değerlendirilmelidir.";
const image=rehber.cover || "/images/site/og-default.svg";
const genericTargets=new Set(["Genel kullanım","Genel kıyı türleri","Genel kıyı balıkçılığı"]);
const specificTargets=rehber.targetSpecies.filter((name)=>!genericTargets.has(name));
const relatedFish=baliklar.filter((fish)=>specificTargets.includes(fish.name));
const confidenceScore:Record<string,number>={A:4,B:3,C:2,D:0};
const routeScore=(route:any)=>{
  const overlap=route.fish.filter((name:string)=>specificTargets.includes(name)).length;
  let score=overlap*30+(confidenceScore[route.confidence]||0)*4;
  if(route.province==="İstanbul"||route.province==="Kocaeli") score+=12;
  return score;
};
const relatedRoutes=specificTargets.length?meralar.filter((route)=>route.confidence!=="D").map((route)=>({route,score:routeScore(route)})).filter(({score})=>score>=30).sort((a,b)=>b.score-a.score||(b.route.updatedAt||b.route.publishedAt).localeCompare(a.route.updatedAt||a.route.publishedAt)).slice(0,10).map(({route})=>route):[];
const schema={"@context":"https://schema.org","@type":"Article","@id":`${pageUrl}#article`,headline:rehber.title,description:rehber.summary,image:[new URL(image,Astro.site).href],datePublished:rehber.publishedAt,dateModified:rehber.updatedAt,inLanguage:"tr-TR",mainEntityOfPage:{"@type":"WebPage","@id":pageUrl},author:{"@type":"Organization",name:rehber.author,url:new URL('/hakkinda/',Astro.site).href},publisher:{"@id":`${new URL('/',Astro.site).href}#organization`},about:rehber.targetSpecies.map((name)=>({"@type":"Thing",name})),citation:rehber.sources.map((source)=>source.url)};
---
<BaseLayout title={rehber.title} description={rehber.summary} image={image} type="article" publishedAt={rehber.publishedAt} modifiedAt={rehber.updatedAt}>
<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}/>
<section class="page-hero guide-detail-hero"><div class="container detail-grid"><div><Breadcrumbs items={[{label:"Ana sayfa",href:"/"},{label:"Rehberler",href:"/rehberler/"},{label:rehber.title}]}/><div class="eyebrow-row"><span class="pill">{rehber.category}</span><span class="pill pill-muted">{rehber.difficulty}</span><span class="pill pill-muted">{rehber.readingTime} dk okuma</span></div><h1>{rehber.title}</h1><p class="lead">{rehber.summary}</p><div class="article-byline"><span>{rehber.author}</span><span>İlk yayın: {new Date(rehber.publishedAt).toLocaleDateString("tr-TR")}</span><span>Son güncelleme: {new Date(rehber.updatedAt).toLocaleDateString("tr-TR")}</span></div></div><aside class="status-card guide-cover-card">{rehber.cover ? <img src={rehber.cover} alt={`${rehber.title} için özgün Olta Atlası çizimi`} width="1200" height="675"/> : <div class="guide-hero-icon" aria-hidden="true">{rehber.icon}</div>}<dl><div><dt>Zorluk</dt><dd>{rehber.difficulty}</dd></div><div><dt>Kategori</dt><dd>{rehber.category}</dd></div><div><dt>Hedef</dt><dd>{rehber.targetSpecies.join(", ")}</dd></div></dl></aside></div></section>
<section class="container section"><article class="article-prose guide-article">
<section class="article-intro"><p>{context}</p><p>{rehber.title} başlığı altındaki öneriler, tek doğru takım veya tek doğru saha davranışı iddiası taşımaz. Amaç, kullanıcıya sahaya çıkmadan önce kontrol edebileceği düzenli ve güvenli bir başlangıç vermektir.</p></section>
<nav class="on-page-nav" aria-label="Rehber bölümleri"><strong>Bu rehberde</strong>{rehber.sections.map((section,index)=><a href={`#adim-${index+1}`}>{index+1}. {section.title}</a>)}{relatedFish.length>0&&<a href="#ilgili-baliklar">İlgili balıklar</a>}{relatedRoutes.length>0&&<a href="#uygun-rotalar">İlişkili rotalar</a>}</nav>
<div class="detailed-guide-grid">{rehber.sections.map((section,index)=><section class="guide-step guide-step-rich" id={`adim-${index+1}`}><span>{String(index+1).padStart(2,"0")}</span><div class="guide-step-copy"><h2>{section.title}</h2><p>{section.intro}</p>{section.illustration && <figure class="guide-figure"><img src={section.illustration.src} alt={section.illustration.alt} loading={index===0?"eager":"lazy"} width="1200" height="675"/><figcaption>{section.illustration.caption}</figcaption></figure>}<ul>{section.items.map((item)=><li>{item}</li>)}</ul><p class="section-closing">Bu adımı tamamladıktan sonra bağlantıyı veya hazırlığı görsel ve elle kontrol et; şüpheli parçayı sahaya götürmeden yeniden kur.</p></div></section>)}</div>
<section class="info-block"><span class="kicker">Uygulama notu</span><h2>Rehberi sahada nasıl kullanmalı?</h2><p>Listeyi telefon ekranında son anda okumak yerine, malzeme hazırlarken ve rota seçerken kullan. Sahada koşullar değiştiğinde “planı tamamlamak” için risk alma; geri dönmek veya başka kıyıya geçmek de doğru bir balıkçılık kararıdır.</p></section>
{relatedFish.length>0&&<section class="info-block" id="ilgili-baliklar"><span class="kicker">Tür bağlantıları</span><h2>Bu rehber hangi balık dosyalarıyla ilişkili?</h2><div class="link-list">{relatedFish.map((fish)=><a href={`/baliklar/${fish.slug}/`}><strong>{fish.name}</strong><span>{fish.water} · yöntem, yem ve ilişkili avlaklar</span></a>)}</div></section>}
{relatedRoutes.length>0&&<section class="info-block" id="uygun-rotalar"><span class="kicker">Saha bağlantıları</span><h2>Rehberle ilişkili avlak dosyaları</h2><p>Bu eşleştirme rehberin hedef türleri ile rota dosyalarındaki raporlanan türlerin kesişimine dayanır; av garantisi veya yöntemin her noktada uygun olduğu anlamına gelmez.</p><div class="link-list">{relatedRoutes.map((route)=><a href={`/meralar/${route.slug}/`}><strong>{route.name}</strong><span>{route.province} · {route.district} · {route.waterType} · Güven {route.confidence}</span></a>)}</div></section>}
<div class="warning-box guide-warning"><h2>Sahaya çıkmadan önce</h2><p>Bu rehber genel hazırlık bilgisidir. Güncel mevzuat, yerel yasak, hava, yol, mülkiyet ve sağlık koşullarını ayrıca doğrula. Düğüm ve takım bağlantılarını kademeli yük altında denemeden kullanma.</p></div>
{rehber.sources.length>0 && <section class="source-box"><span class="kicker">Kaynaklar</span><h2>Bu rehber hangi kaynaklara dayanıyor?</h2><ul>{rehber.sources.map((source)=><li><a href={source.url} target={source.url.startsWith("http")?"_blank":undefined} rel={source.url.startsWith("http")?"noreferrer":undefined}><strong>{source.label}</strong></a><span>{source.note}</span></li>)}</ul></section>}
<section class="source-box"><span class="kicker">Editörlük notu</span><h2>Görseller ve metin nasıl hazırlandı?</h2><p>Metin Olta Atlası editörlük yapısında özgün olarak hazırlanmıştır. Sayfadaki adım çizimleri üçüncü taraf görsellerin kopyası değildir; Olta Atlası için oluşturulan açıklayıcı SVG illüstrasyonlardır.</p></section>
<FeedbackButtons title={rehber.title} contentKey={`rehber:${rehber.slug}`} path={pagePath} /></article></section>
</BaseLayout>
