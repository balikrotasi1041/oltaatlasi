---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FeedbackButtons from "../../components/FeedbackButtons.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { rehberler } from "../../data/rehberler";
export function getStaticPaths(){return rehberler.map((rehber)=>({params:{slug:rehber.slug},props:{rehber}}));}
const {rehber}=Astro.props;const pagePath=`/rehberler/${rehber.slug}/`;const pageUrl=new URL(pagePath,Astro.site).href;
const categoryContext: Record<string,string>={
 "Teknik":"Teknik bir yöntemi öğrenirken önce sade ve kontrol edilebilir bir takım kurmak, sonucu ekipman kalabalığından daha fazla iyileştirir.",
 "Yem":"Yem seçimi yalnızca balığın adıyla değil, su sıcaklığı, küçük balık baskısı, dip yapısı ve sunum biçimiyle birlikte düşünülmelidir.",
 "Güvenlik":"Saha güvenliği, balık çıktıktan sonra değil kıyıya varmadan önce başlayan bir planlama işidir.",
 "Kamp":"Balık kampında konforun temeli fazla eşya değil; kuru kalmak, suya erişmek, dönüş planını bilmek ve iz bırakmamaktır.",
 "Mera":"Bir mera bilgisi, tarihi ve kaynağı yoksa yalnızca duyumdur. Yayınlanmadan önce erişim, mülkiyet ve mevzuat açısından ayrıştırılmalıdır.",
 "Hava":"Hava tahmini tek bir ikon değildir; rüzgâr yönü, hamle, yağış, sıcaklık ve deniz durumu birlikte okunmalıdır."
};
const context=categoryContext[rehber.category] || "Bu rehber, sahada uygulanabilir küçük adımları tek bir akışta toplar. Her madde mera, hava ve mevzuat koşullarına göre yeniden değerlendirilmelidir.";
const schema={"@context":"https://schema.org","@type":"Article","@id":`${pageUrl}#article`,headline:rehber.title,description:rehber.summary,datePublished:rehber.publishedAt,dateModified:"2026-07-18",inLanguage:"tr-TR",mainEntityOfPage:{"@type":"WebPage","@id":pageUrl},author:{"@type":"Organization",name:"Olta Atlası Editörlüğü",url:new URL('/hakkinda/',Astro.site).href},publisher:{"@id":`${new URL('/',Astro.site).href}#organization`}};
---
<BaseLayout title={rehber.title} description={rehber.summary} type="article" publishedAt={rehber.publishedAt} modifiedAt="2026-07-18"><script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}/><section class="page-hero"><div class="container"><Breadcrumbs items={[{label:"Ana sayfa",href:"/"},{label:"Rehberler",href:"/rehberler/"},{label:rehber.title}]}/><span class="kicker">{rehber.category} · {rehber.readingTime} dk okuma</span><h1>{rehber.title}</h1><p class="lead">{rehber.summary}</p><div class="article-byline"><span>Olta Atlası Editörlüğü</span><span>Son güncelleme: 18.07.2026</span></div></div></section><section class="container section"><article class="article-prose guide-article"><section class="article-intro"><p>{context}</p><p>{rehber.title} başlığı altındaki öneriler, tek doğru takım veya tek doğru saha davranışı iddiası taşımaz. Amaç, kullanıcıya sahaya çıkmadan önce kontrol edebileceği düzenli bir başlangıç listesi vermektir.</p></section><div class="guide-grid detailed-guide-grid">{rehber.sections.map(([title,items],index)=><section class="guide-step"><span>{String(index+1).padStart(2,"0")}</span><h2>{title}</h2><p>{title} aşamasında aşağıdaki maddeleri sırayla kontrol etmek, eksik veya çelişkili hazırlığı daha kıyıya gitmeden fark etmeyi kolaylaştırır.</p><ul>{items.map((item)=><li>{item}</li>)}</ul><p class="section-closing">Bu adımlar mera, hava ve hedef türe göre sadeleştirilebilir; güvenliği azaltan hiçbir kısaltma yapılmamalıdır.</p></section>)}</div><section class="info-block"><span class="kicker">Uygulama notu</span><h2>Rehberi sahada nasıl kullanmalı?</h2><p>Listeyi telefon ekranında son anda okumak yerine, malzeme hazırlarken ve rota seçerken kullan. Sahada koşullar değiştiğinde “planı tamamlamak” için risk alma; geri dönmek veya başka kıyıya geçmek de doğru bir balıkçılık kararıdır.</p></section><div class="warning-box guide-warning"><h2>Sahaya çıkmadan önce</h2><p>Bu rehber genel hazırlık bilgisidir. Güncel mevzuat, yerel yasak, hava, yol, mülkiyet ve sağlık koşullarını ayrıca doğrula.</p></div><section class="source-box"><span class="kicker">Editörlük notu</span><h2>İçerik nasıl hazırlandı?</h2><p>Metin, balıkçılıkta tekrar eden saha sorunlarını pratik kontrol adımlarına dönüştürmek için hazırlanmıştır. Yapay zekâ destekli taslak üretimi kullanılmış, nihai yapı Olta Atlası editörlük ilkelerine göre düzenlenmiştir.</p></section><FeedbackButtons title={rehber.title} contentKey={`rehber:${rehber.slug}`} path={pagePath} /></article></section></BaseLayout>
