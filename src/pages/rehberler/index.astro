---
import BaseLayout from "../../layouts/BaseLayout.astro";import Breadcrumbs from "../../components/Breadcrumbs.astro";import { rehberler, rehberKategorileri } from "../../data/rehberler";
---
<BaseLayout title="Balıkçılık Rehberleri" description="Takım, yem, güvenlik, kamp, hava ve mera doğrulama için açıklamalı ve uygulanabilir balıkçılık yazıları."><section class="page-hero"><div class="container"><Breadcrumbs items={[{label:"Ana sayfa",href:"/"},{label:"Rehberler"}]}/><span class="kicker">{rehberler.length} uygulamalı yazı</span><h1>Balıkçılık rehberleri</h1><p class="lead">Kıyıda iş gören kontrol listelerini, yalnızca madde madde değil; nedenleri ve uygulama notlarıyla birlikte oku.</p></div></section><section class="container section"><div class="category-filter"><label><span>Kategori</span><select id="guide-category"><option value="">Tüm kategoriler</option>{rehberKategorileri.map((c)=><option value={c}>{c}</option>)}</select></label><p id="guide-count">{rehberler.length} rehber gösteriliyor</p></div><div class="guide-grid" id="guide-grid">{rehberler.map((r)=><article class="guide-step" data-guide data-category={r.category}><span>{r.icon}</span><div class="eyebrow-row"><span class="pill">{r.category}</span><span class="microcopy">{r.readingTime} dk</span></div><h2><a href={`/rehberler/${r.slug}/`}>{r.title}</a></h2><p>{r.summary}</p><a class="text-link" href={`/rehberler/${r.slug}/`}>Rehberi aç →</a></article>)}</div></section><script is:inline>const select=document.querySelector("#guide-category"),cards=[...document.querySelectorAll("[data-guide]")],count=document.querySelector("#guide-count");select.addEventListener("change",()=>{let n=0;cards.forEach(card=>{const show=!select.value||card.dataset.category===select.value;card.hidden=!show;if(show)n++;});count.textContent=`${n} rehber gösteriliyor`;});</script></BaseLayout>
