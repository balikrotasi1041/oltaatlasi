---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { rehberler, rehberKategorileri } from "../../data/rehber-katalogu";
const ordered=[...rehberler].sort((a,b)=>b.publishedAt.localeCompare(a.publishedAt));
---
<BaseLayout title="Balıkçılık Rehberleri" description="Düğüm, takım, yem, güvenlik, kamp, hava ve mera doğrulama için görselli, uygulanabilir balıkçılık yazıları.">
<section class="page-hero"><div class="container"><Breadcrumbs items={[{label:"Ana sayfa",href:"/"},{label:"Rehberler"}]}/><span class="kicker">{rehberler.length} uygulamalı yazı</span><h1>Balıkçılık rehberleri</h1><p class="lead">Temel düğümlerden yem sunumuna kadar her konuyu nedenleri, saha notları ve mümkün olduğunda özgün adım çizimleriyle öğren.</p></div></section>
<section class="container section"><div class="category-filter"><label><span>Kategori</span><select id="guide-category"><option value="">Tüm kategoriler</option>{rehberKategorileri.map((c)=><option value={c}>{c}</option>)}</select></label><p id="guide-count">{rehberler.length} rehber gösteriliyor</p></div><div class="guide-grid guide-card-grid" id="guide-grid">{ordered.map((r)=><article class:list={["guide-step","guide-card",{ "guide-card-visual":Boolean(r.cover) }]} data-guide data-category={r.category}>{r.cover ? <a class="guide-cover" href={`/rehberler/${r.slug}/`}><img src={r.cover} alt={`${r.title} için özgün Olta Atlası çizimi`} loading="lazy" width="1200" height="675"/></a> : <div class="guide-icon" aria-hidden="true">{r.icon}</div>}<div class="guide-card-content"><div class="eyebrow-row"><span class="pill">{r.category}</span><span class="pill pill-muted">{r.difficulty}</span><span class="microcopy">{r.readingTime} dk</span></div><h2><a href={`/rehberler/${r.slug}/`}>{r.title}</a></h2><p>{r.summary}</p><div class="guide-card-footer"><span>Güncelleme: {new Date(r.updatedAt).toLocaleDateString("tr-TR")}</span><a class="text-link" href={`/rehberler/${r.slug}/`}>Rehberi aç →</a></div></div></article>)}</div></section>
<script is:inline>const select=document.querySelector("#guide-category"),cards=[...document.querySelectorAll("[data-guide]")],count=document.querySelector("#guide-count");select?.addEventListener("change",()=>{let n=0;cards.forEach(card=>{const show=!select.value||card.dataset.category===select.value;card.hidden=!show;if(show)n++;});count.textContent=`${n} rehber gösteriliyor`;});</script>
</BaseLayout>
