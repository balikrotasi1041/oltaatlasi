---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { meralar, provinces, fishOptions, districtsByProvince } from "../../data/meralar-tumu";

const weakSources = meralar.filter((m) => !m.sources || m.sources.length < 2);
const weakTransport = meralar.filter((m) => !m.transport || m.transport.length < 90 || /güncel harita uygulaması|genel erişim bölgesine gider/i.test(m.transport));
const weakAccommodation = meralar.filter((m) => !m.accommodationOptions?.length && !/konaklama|otel|pansiyon|ilçe merkezi|yerleşim/i.test(`${m.transport} ${m.planningNotes.join(" ")} ${m.amenities.join(" ")}`));
const weakLocality = meralar.filter((m) => !m.shoreProfile || m.shoreProfile.length < 100 || /şehir içi ve düzenlenmiş bölümler|yerel engellerin bir arada/i.test(m.shoreProfile));
const weakResearch = meralar.filter((m) => /pilot veri/i.test(m.verification));
const totalDistricts = Object.values(districtsByProvince).reduce((sum, districts) => sum + districts.length, 0);
const byConfidence = ["A", "B", "C", "D"].map((level) => {
  const count = meralar.filter((m) => m.confidence === level).length;
  return { level, count, ratio: meralar.length ? Math.round((count / meralar.length) * 100) : 0 };
});
const provinceCounts = provinces
  .map((province) => ({ province, count: meralar.filter((m) => m.province === province).length }))
  .sort((a, b) => b.count - a.count)
  .slice(0, 12);
const latest = [...meralar]
  .sort((a, b) => (b.updatedAt || b.publishedAt).localeCompare(a.updatedAt || a.publishedAt))
  .slice(0, 12);
const issues = [
  { label: "Kaynağı yetersiz", count: weakSources.length },
  { label: "Ulaşımı yüzeysel", count: weakTransport.length },
  { label: "Konaklama bağlamı eksik", count: weakAccommodation.length },
  { label: "Kıyı profili şablon", count: weakLocality.length },
  { label: "Pilot doğrulama", count: weakResearch.length },
].sort((a, b) => b.count - a.count);
const qualityScore = Math.max(0, Math.round(100 - (issues.reduce((sum, item) => sum + item.count, 0) / Math.max(1, meralar.length * issues.length)) * 100));
const queue = meralar
  .map((m) => ({
    m,
    issues: [
      weakSources.includes(m) ? "Kaynak" : "",
      weakTransport.includes(m) ? "Ulaşım" : "",
      weakAccommodation.includes(m) ? "Konaklama" : "",
      weakLocality.includes(m) ? "Kıyı profili" : "",
      weakResearch.includes(m) ? "Pilot veri" : "",
    ].filter(Boolean),
  }))
  .filter((row) => row.issues.length)
  .sort((a, b) => b.issues.length - a.issues.length)
  .slice(0, 24);
---
<BaseLayout title="Yönetim Paneli" description="Olta Atlası içerik, SEO, gerçek kullanıcı ve altyapı trafiği kontrol merkezi." noindex={true}>
  <section class="dash">
    <div class="container wrap">
      <header class="hero">
        <div>
          <p class="eyebrow">Olta Atlası · Dashboard v4</p>
          <h1>SEO, kullanıcı, altyapı ve içerik merkezi</h1>
          <p>Search Console, GA4, Cloudflare ve aktif avlak veri katmanını tek ekranda birleştirir.</p>
        </div>
        <div class="score"><span>İçerik kalite puanı</span><strong>{qualityScore}</strong><small>100 üzerinden</small></div>
      </header>

      <section class="panel" aria-labelledby="ga4-title">
        <div class="panel-head">
          <div><p class="eyebrow dark">Google Analytics 4</p><h2 id="ga4-title">Gerçek kullanıcı trafiği</h2><p id="ga4-status">Veriler yükleniyor…</p></div>
          <div class="actions"><label for="ga4-period">Dönem</label><select id="ga4-period"><option value="7">Son 7 gün</option><option value="28" selected>Son 28 gün</option><option value="90">Son 90 gün</option></select><button id="ga4-refresh" type="button">Yenile</button></div>
        </div>
        <div class="metric-cards six" aria-live="polite">
          <article><span>Aktif kullanıcı</span><strong id="ga4-users">—</strong></article>
          <article><span>Oturum</span><strong id="ga4-sessions">—</strong></article>
          <article><span>Sayfa görüntüleme</span><strong id="ga4-views">—</strong></article>
          <article><span>Etkileşim oranı</span><strong id="ga4-engagement">—</strong></article>
          <article><span>Organik oturum</span><strong id="ga4-organic">—</strong><small id="ga4-organic-share">—</small></article>
          <article class="realtime"><span>Şu an aktif</span><strong id="ga4-realtime">—</strong><small>son 30 dakika</small></article>
        </div>
        <div id="ga4-error" class="notice error" hidden></div>
        <div class="analytics-grid">
          <section class="subpanel"><h3>Trafik kanalları</h3><div id="ga4-channels" class="data-list"><p class="muted">Yükleniyor…</p></div></section>
          <section class="subpanel"><h3>Cihazlar</h3><div id="ga4-devices" class="data-list"><p class="muted">Yükleniyor…</p></div></section>
          <section class="subpanel"><h3>Şehirler</h3><div id="ga4-cities" class="data-list"><p class="muted">Yükleniyor…</p></div></section>
          <section class="subpanel"><h3>En çok görüntülenen sayfalar</h3><div id="ga4-pages" class="data-list"><p class="muted">Yükleniyor…</p></div></section>
        </div>
      </section>

      <section class="panel" aria-labelledby="cf-title">
        <div class="panel-head">
          <div><p class="eyebrow dark">Cloudflare Analytics</p><h2 id="cf-title">Altyapı ve istek trafiği</h2><p id="cf-status">Veriler yükleniyor…</p></div>
          <div class="actions"><label for="cf-period">Dönem</label><select id="cf-period"><option value="1">Son 24 saat</option><option value="7" selected>Son 7 gün</option><option value="28">Son 28 gün</option></select><button id="cf-refresh" type="button">Yenile</button></div>
        </div>
        <div class="metric-cards six" aria-live="polite">
          <article><span>HTTP isteği</span><strong id="cf-requests">—</strong></article>
          <article><span>Ziyaret</span><strong id="cf-visits">—</strong></article>
          <article><span>Veri aktarımı</span><strong id="cf-bytes">—</strong></article>
          <article><span>Cache hit</span><strong id="cf-cache-rate">—</strong><small id="cf-cache-count">—</small></article>
          <article class="warning"><span>4xx</span><strong id="cf-4xx">—</strong></article>
          <article class="danger"><span>5xx</span><strong id="cf-5xx">—</strong></article>
        </div>
        <div id="cf-error" class="notice error" hidden></div>
        <div class="analytics-grid">
          <section class="subpanel"><h3>Cache durumları</h3><div id="cf-cache" class="data-list"><p class="muted">Yükleniyor…</p></div></section>
          <section class="subpanel"><h3>HTTP durum kodları</h3><div id="cf-statuses" class="data-list"><p class="muted">Yükleniyor…</p></div></section>
          <section class="subpanel"><h3>En yoğun ülkeler</h3><div id="cf-countries" class="data-list"><p class="muted">Yükleniyor…</p></div></section>
          <section class="subpanel"><h3>En çok istek alan yollar</h3><div id="cf-paths" class="data-list"><p class="muted">Yükleniyor…</p></div></section>
        </div>
      </section>

      <section class="panel" aria-labelledby="gsc-title">
        <div class="panel-head">
          <div><p class="eyebrow dark">Google Search Console</p><h2 id="gsc-title">Organik arama performansı</h2><p id="gsc-status">Veriler yükleniyor…</p></div>
          <div class="actions"><label for="gsc-period">Dönem</label><select id="gsc-period"><option value="7">Son 7 gün</option><option value="28" selected>Son 28 gün</option><option value="90">Son 90 gün</option></select><button id="gsc-refresh" type="button">Yenile</button></div>
        </div>
        <div class="metric-cards" aria-live="polite">
          <article><span>Tıklama</span><strong id="gsc-clicks">—</strong></article>
          <article><span>Gösterim</span><strong id="gsc-impressions">—</strong></article>
          <article><span>CTR</span><strong id="gsc-ctr">—</strong></article>
          <article><span>Ort. konum</span><strong id="gsc-position">—</strong></article>
        </div>
        <div id="gsc-error" class="notice error" hidden></div>
        <div class="grid data-grid">
          <section class="subpanel"><h3>En çok gösterilen sorgular</h3><div id="gsc-queries" class="data-list"><p class="muted">Yükleniyor…</p></div></section>
          <section class="subpanel"><h3>En çok gösterilen sayfalar</h3><div id="gsc-pages" class="data-list"><p class="muted">Yükleniyor…</p></div></section>
        </div>
      </section>

      <div class="cards">
        <article><span>Toplam avlak</span><strong>{meralar.length}</strong></article>
        <article><span>İl</span><strong>{provinces.length}</strong></article>
        <article><span>İlçe</span><strong>{totalDistricts}</strong></article>
        <article><span>Balık türü</span><strong>{fishOptions.length}</strong></article>
      </div>

      <div class="grid">
        <section class="panel"><h2>Öncelikli eksikler</h2>{issues.map((item) => (<div class="row"><span>{item.label}</span><b>{item.count}</b></div>))}</section>
        <section class="panel"><h2>Güven seviyesi</h2>{byConfidence.map((item) => (<div class="confidence"><span><b>{item.level}</b> · {item.count} kayıt</span><i><em style={`width: ${item.ratio}%`}></em></i><strong>{item.ratio}%</strong></div>))}</section>
      </div>

      <div class="grid">
        <section class="panel"><h2>En yoğun iller</h2>{provinceCounts.map((item, index) => (<div class="row"><span>{index + 1}. {item.province}</span><b>{item.count}</b></div>))}</section>
        <section class="panel"><h2>Son güncellenenler</h2>{latest.map((m) => (<a class="latest" href={`/meralar/${m.slug}/`}><span><b>{m.name}</b><small>{m.province} · {m.district} · Güven {m.confidence}</small></span><time>{m.updatedAt}</time></a>))}</section>
      </div>

      <section class="panel table-panel">
        <div class="heading"><h2>İyileştirme kuyruğu</h2><span>İlk 24 kayıt</span></div>
        <div class="scroll"><table><thead><tr><th>Avlak</th><th>İl / İlçe</th><th>Güven</th><th>Eksikler</th><th></th></tr></thead><tbody>{queue.map(({ m, issues: rowIssues }) => (<tr><td><b>{m.name}</b><small>{m.slug}</small></td><td>{m.province} / {m.district}</td><td><span class={`badge b-${m.confidence.toLowerCase()}`}>{m.confidence}</span></td><td><div class="tags">{rowIssues.map((issue) => <span>{issue}</span>)}</div></td><td><a href={`/meralar/${m.slug}/`}>Aç</a></td></tr>))}</tbody></table></div>
      </section>
    </div>
  </section>

  <script is:inline>
    const numberFormatter = new Intl.NumberFormat("tr-TR", { maximumFractionDigits: 0 });
    const decimalFormatter = new Intl.NumberFormat("tr-TR", { minimumFractionDigits: 1, maximumFractionDigits: 1 });
    const setText = (selector, value) => { const node = document.querySelector(selector); if (node) node.textContent = value; };
    const clearError = (node) => { if (!node) return; node.hidden = true; node.textContent = ""; };
    const showError = (node, error) => { if (!node) return; node.hidden = false; node.textContent = error instanceof Error ? error.message : "Bilinmeyen bağlantı hatası."; };
    const shortPage = (value) => { try { const url = new URL(value); return url.pathname || "/"; } catch { return value || "/"; } };
    const formatBytes = (value) => {
      const bytes = Number(value || 0);
      if (bytes < 1024) return `${numberFormatter.format(bytes)} B`;
      const units = ["KB", "MB", "GB", "TB"];
      let amount = bytes / 1024;
      let unit = units[0];
      for (let index = 1; index < units.length && amount >= 1024; index += 1) { amount /= 1024; unit = units[index]; }
      return `${decimalFormatter.format(amount)} ${unit}`;
    };
    const renderRows = (selector, rows, labelBuilder, detailBuilder, valueBuilder) => {
      const container = document.querySelector(selector);
      if (!container) return;
      container.replaceChildren();
      if (!rows.length) { const empty = document.createElement("p"); empty.className = "muted"; empty.textContent = "Bu dönem için veri bulunamadı."; container.appendChild(empty); return; }
      rows.forEach((row) => {
        const item = document.createElement("div"); item.className = "data-row";
        const label = document.createElement("span"); const title = document.createElement("b"); title.textContent = labelBuilder(row);
        const detail = document.createElement("small"); detail.textContent = detailBuilder(row); label.append(title, detail);
        const value = document.createElement("strong"); value.textContent = valueBuilder(row); item.append(label, value); container.appendChild(item);
      });
    };

    const ga4Period = document.querySelector("#ga4-period");
    const ga4Refresh = document.querySelector("#ga4-refresh");
    const ga4Status = document.querySelector("#ga4-status");
    const ga4Error = document.querySelector("#ga4-error");
    const loadGa4 = async () => {
      const days = ga4Period?.value || "28"; if (ga4Refresh) ga4Refresh.disabled = true; if (ga4Status) ga4Status.textContent = "Google Analytics verileri yükleniyor…"; clearError(ga4Error);
      try {
        const response = await fetch(`/admin/api/ga4?days=${encodeURIComponent(days)}`, { credentials: "same-origin", headers: { Accept: "application/json" } });
        const payload = await response.json(); if (!response.ok || !payload.connected) throw new Error(payload.error || "Google Analytics bağlantısı kurulamadı.");
        setText("#ga4-users", numberFormatter.format(payload.totals.activeUsers)); setText("#ga4-sessions", numberFormatter.format(payload.totals.sessions)); setText("#ga4-views", numberFormatter.format(payload.totals.views)); setText("#ga4-engagement", `${decimalFormatter.format(payload.totals.engagementRate * 100)}%`); setText("#ga4-organic", numberFormatter.format(payload.totals.organicSessions)); setText("#ga4-organic-share", `${decimalFormatter.format(payload.totals.organicShare * 100)}% toplam oturum`); setText("#ga4-realtime", numberFormatter.format(payload.totals.realtimeActiveUsers));
        renderRows("#ga4-channels", payload.channels || [], (row) => row.channel || "Tanımsız", (row) => `${numberFormatter.format(row.activeUsers)} kullanıcı · ${numberFormatter.format(row.views)} görüntüleme`, (row) => numberFormatter.format(row.sessions));
        renderRows("#ga4-devices", payload.devices || [], (row) => row.device || "Tanımsız", (row) => `${numberFormatter.format(row.sessions)} oturum`, (row) => numberFormatter.format(row.activeUsers));
        renderRows("#ga4-cities", payload.cities || [], (row) => `${row.city || "Tanımsız"}${row.country ? ` · ${row.country}` : ""}`, (row) => `${numberFormatter.format(row.sessions)} oturum`, (row) => numberFormatter.format(row.activeUsers));
        renderRows("#ga4-pages", payload.pages || [], (row) => shortPage(row.page), (row) => `${numberFormatter.format(row.activeUsers)} kullanıcı · ${decimalFormatter.format(row.engagementRate * 100)}% etkileşim`, (row) => numberFormatter.format(row.views));
        if (ga4Status) ga4Status.textContent = `Son ${payload.range.days} gün · GA4 mülkü ${payload.propertyId}`;
      } catch (error) {
        ["#ga4-users", "#ga4-sessions", "#ga4-views", "#ga4-engagement", "#ga4-organic", "#ga4-organic-share", "#ga4-realtime"].forEach((selector) => setText(selector, "—"));
        ["#ga4-channels", "#ga4-devices", "#ga4-cities", "#ga4-pages"].forEach((selector) => renderRows(selector, [], () => "", () => "", () => "")); if (ga4Status) ga4Status.textContent = "Google Analytics bağlantısı bekleniyor."; showError(ga4Error, error);
      } finally { if (ga4Refresh) ga4Refresh.disabled = false; }
    };

    const cfPeriod = document.querySelector("#cf-period");
    const cfRefresh = document.querySelector("#cf-refresh");
    const cfStatus = document.querySelector("#cf-status");
    const cfError = document.querySelector("#cf-error");
    const loadCloudflare = async () => {
      const days = cfPeriod?.value || "7"; if (cfRefresh) cfRefresh.disabled = true; if (cfStatus) cfStatus.textContent = "Cloudflare verileri yükleniyor…"; clearError(cfError);
      try {
        const response = await fetch(`/admin/api/cloudflare?days=${encodeURIComponent(days)}`, { credentials: "same-origin", headers: { Accept: "application/json" } });
        const payload = await response.json(); if (!response.ok || !payload.connected) throw new Error(payload.error || "Cloudflare bağlantısı kurulamadı.");
        setText("#cf-requests", numberFormatter.format(payload.totals.requests)); setText("#cf-visits", numberFormatter.format(payload.totals.visits)); setText("#cf-bytes", formatBytes(payload.totals.bytes)); setText("#cf-cache-rate", `${decimalFormatter.format(payload.totals.cacheHitRate * 100)}%`); setText("#cf-cache-count", `${numberFormatter.format(payload.totals.cachedRequests)} istek`); setText("#cf-4xx", numberFormatter.format(payload.totals.status4xx)); setText("#cf-5xx", numberFormatter.format(payload.totals.status5xx));
        renderRows("#cf-cache", payload.cache || [], (row) => row.status || "unknown", () => "Cache sonucu", (row) => numberFormatter.format(row.requests));
        renderRows("#cf-statuses", (payload.statuses || []).slice(0, 12), (row) => String(row.status || "Tanımsız"), (row) => `${Math.floor(Number(row.status || 0) / 100)}xx sınıfı`, (row) => numberFormatter.format(row.requests));
        renderRows("#cf-countries", payload.countries || [], (row) => row.country || "Unknown", () => "HTTP isteği", (row) => numberFormatter.format(row.requests));
        renderRows("#cf-paths", payload.paths || [], (row) => row.path || "/", () => "HTTP isteği", (row) => numberFormatter.format(row.requests));
        if (cfStatus) cfStatus.textContent = `Son ${payload.range.days === 1 ? "24 saat" : `${payload.range.days} gün`} · ${payload.sampled ? "örneklenmiş tahmin" : "tam veri"}`;
      } catch (error) {
        ["#cf-requests", "#cf-visits", "#cf-bytes", "#cf-cache-rate", "#cf-cache-count", "#cf-4xx", "#cf-5xx"].forEach((selector) => setText(selector, "—"));
        ["#cf-cache", "#cf-statuses", "#cf-countries", "#cf-paths"].forEach((selector) => renderRows(selector, [], () => "", () => "", () => "")); if (cfStatus) cfStatus.textContent = "Cloudflare bağlantısı bekleniyor."; showError(cfError, error);
      } finally { if (cfRefresh) cfRefresh.disabled = false; }
    };

    const gscPeriod = document.querySelector("#gsc-period");
    const gscRefresh = document.querySelector("#gsc-refresh");
    const gscStatus = document.querySelector("#gsc-status");
    const gscError = document.querySelector("#gsc-error");
    const loadSearchConsole = async () => {
      const days = gscPeriod?.value || "28"; if (gscRefresh) gscRefresh.disabled = true; if (gscStatus) gscStatus.textContent = "Search Console verileri yükleniyor…"; clearError(gscError);
      try {
        const response = await fetch(`/admin/api/search-console?days=${encodeURIComponent(days)}`, { credentials: "same-origin", headers: { Accept: "application/json" } });
        const payload = await response.json(); if (!response.ok || !payload.connected) throw new Error(payload.error || "Search Console bağlantısı kurulamadı.");
        setText("#gsc-clicks", numberFormatter.format(payload.totals.clicks)); setText("#gsc-impressions", numberFormatter.format(payload.totals.impressions)); setText("#gsc-ctr", `${decimalFormatter.format(payload.totals.ctr * 100)}%`); setText("#gsc-position", decimalFormatter.format(payload.totals.position));
        renderRows("#gsc-queries", payload.queries || [], (row) => row.query, (row) => `${numberFormatter.format(row.clicks)} tıklama · ${decimalFormatter.format(row.position)} sıra`, (row) => numberFormatter.format(row.impressions));
        renderRows("#gsc-pages", payload.pages || [], (row) => shortPage(row.page), (row) => `${numberFormatter.format(row.clicks)} tıklama · ${decimalFormatter.format(row.position)} sıra`, (row) => numberFormatter.format(row.impressions));
        if (gscStatus) gscStatus.textContent = `${payload.range.startDate} – ${payload.range.endDate} · ${payload.siteUrl}`;
      } catch (error) {
        ["#gsc-clicks", "#gsc-impressions", "#gsc-ctr", "#gsc-position"].forEach((selector) => setText(selector, "—")); ["#gsc-queries", "#gsc-pages"].forEach((selector) => renderRows(selector, [], () => "", () => "", () => "")); if (gscStatus) gscStatus.textContent = "Search Console bağlantısı bekleniyor."; showError(gscError, error);
      } finally { if (gscRefresh) gscRefresh.disabled = false; }
    };

    ga4Period?.addEventListener("change", loadGa4); ga4Refresh?.addEventListener("click", loadGa4);
    cfPeriod?.addEventListener("change", loadCloudflare); cfRefresh?.addEventListener("click", loadCloudflare);
    gscPeriod?.addEventListener("change", loadSearchConsole); gscRefresh?.addEventListener("click", loadSearchConsole);
    loadGa4(); loadCloudflare(); loadSearchConsole();
  </script>

  <style>
    .dash{background:#f3f7f7;min-height:70vh;padding:42px 0 72px}.wrap{display:grid;gap:22px}.hero{display:flex;justify-content:space-between;gap:28px;background:linear-gradient(135deg,#0a3340,#0b5967);color:#fff;padding:32px;border-radius:24px}.hero h1{font-size:clamp(2rem,5vw,3.3rem);line-height:1;margin:.2rem 0 .7rem}.hero p{max-width:800px;color:#d8ecef;margin:0}.eyebrow{text-transform:uppercase;letter-spacing:.12em;font-weight:800;font-size:.75rem;color:#8edbe4}.eyebrow.dark{color:#287685;margin:0 0 5px}.score{min-width:190px;border:1px solid #ffffff38;background:#ffffff12;border-radius:18px;padding:18px;display:flex;flex-direction:column;justify-content:center}.score strong{font-size:4rem;line-height:1}.score span,.score small{color:#d8ecef}.cards,.metric-cards{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.metric-cards.six{grid-template-columns:repeat(6,1fr)}.cards article,.metric-cards article,.panel{background:#fff;border:1px solid #dce8e8;border-radius:18px;box-shadow:0 10px 24px #1439410f}.cards article,.metric-cards article{padding:20px}.cards span,.metric-cards span{color:#637a7e}.cards strong,.metric-cards strong{display:block;font-size:2.25rem;color:#0a3340;margin-top:4px}.metric-cards small{display:block;color:#74888b;margin-top:4px}.metric-cards .realtime{border-color:#a9d5c0;background:#f2fbf6}.metric-cards .realtime strong{color:#24734a}.metric-cards .warning{border-color:#eed7a0;background:#fffaf0}.metric-cards .warning strong{color:#956900}.metric-cards .danger{border-color:#efc7bb;background:#fff5f1}.metric-cards .danger strong{color:#a33f22}.grid{display:grid;grid-template-columns:1fr 1fr;gap:22px}.analytics-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-top:18px}.panel{padding:22px}.panel h2{margin:0 0 14px;color:#143d46}.panel-head{display:flex;justify-content:space-between;gap:20px;align-items:flex-start;margin-bottom:18px}.panel-head h2{margin:0 0 4px}.panel-head p{margin:0;color:#6c8084}.actions{display: