---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { meralar, provinces, fishOptions, districtsByProvince } from "../../data/meralar-tumu";

const weakSources = meralar.filter((m) => !m.sources || m.sources.length < 2);
const weakTransport = meralar.filter((m) => !m.transport || m.transport.length < 90 || /güncel harita uygulaması|genel erişim bölgesine gider/i.test(m.transport));
const weakAccommodation = meralar.filter((m) => !m.accommodationOptions?.length && !/konaklama|otel|pansiyon|ilçe merkezi|yerleşim/i.test(`${m.transport} ${m.planningNotes.join(" ")} ${m.amenities.join(" ")}`));
const weakLocality = meralar.filter((m) => !m.shoreProfile || m.shoreProfile.length < 100 || /şehir içi ve düzenlenmiş bölümler|yerel engellerin bir arada/i.test(m.shoreProfile));
const weakResearch = meralar.filter((m) => /pilot veri/i.test(m.verification));
const totalDistricts = Object.values(districtsByProvince).reduce((sum, districts) => sum + districts.length, 0);
const byConfidence = ["A", "B", "C", "D"].map((level) => {
  const count = meralar.filter((m) => m.confidence === level).length;
  return { level, count, ratio: meralar.length ? Math.round((count / meralar.length) * 100) : 0 };
});
const provinceCounts = provinces
  .map((province) => ({ province, count: meralar.filter((m) => m.province === province).length }))
  .sort((a, b) => b.count - a.count)
  .slice(0, 12);
const latest = [...meralar]
  .sort((a, b) => (b.updatedAt || b.publishedAt).localeCompare(a.updatedAt || a.publishedAt))
  .slice(0, 12);
const issues = [
  { label: "Kaynağı yetersiz", count: weakSources.length },
  { label: "Ulaşımı yüzeysel", count: weakTransport.length },
  { label: "Konaklama bağlamı eksik", count: weakAccommodation.length },
  { label: "Kıyı profili şablon", count: weakLocality.length },
  { label: "Pilot doğrulama", count: weakResearch.length },
].sort((a, b) => b.count - a.count);
const qualityScore = Math.max(0, Math.round(100 - (issues.reduce((sum, item) => sum + item.count, 0) / Math.max(1, meralar.length * issues.length)) * 100));
const queue = meralar
  .map((m) => ({
    m,
    issues: [
      weakSources.includes(m) ? "Kaynak" : "",
      weakTransport.includes(m) ? "Ulaşım" : "",
      weakAccommodation.includes(m) ? "Konaklama" : "",
      weakLocality.includes(m) ? "Kıyı profili" : "",
      weakResearch.includes(m) ? "Pilot veri" : "",
    ].filter(Boolean),
  }))
  .filter((row) => row.issues.length)
  .sort((a, b) => b.issues.length - a.issues.length)
  .slice(0, 24);
---
<BaseLayout title="Yönetim Paneli" description="Olta Atlası içerik ve veri kalitesi kontrol merkezi." noindex={true}>
  <section class="dash">
    <div class="container wrap">
      <header class="hero">
        <div>
          <p class="eyebrow">Olta Atlası · Dashboard v1</p>
          <h1>İçerik ve veri kalite merkezi</h1>
          <p>Panel, aktif avlak veri katmanını analiz eder. Search Console, GA4 ve Cloudflare bağlantıları sonraki aşamada eklenecek.</p>
        </div>
        <div class="score"><span>Kalite puanı</span><strong>{qualityScore}</strong><small>100 üzerinden</small></div>
      </header>

      <div class="cards">
        <article><span>Toplam avlak</span><strong>{meralar.length}</strong></article>
        <article><span>İl</span><strong>{provinces.length}</strong></article>
        <article><span>İlçe</span><strong>{totalDistricts}</strong></article>
        <article><span>Balık türü</span><strong>{fishOptions.length}</strong></article>
      </div>

      <div class="grid">
        <section class="panel">
          <h2>Öncelikli eksikler</h2>
          {issues.map((item) => (
            <div class="row"><span>{item.label}</span><b>{item.count}</b></div>
          ))}
        </section>
        <section class="panel">
          <h2>Güven seviyesi</h2>
          {byConfidence.map((item) => (
            <div class="confidence">
              <span><b>{item.level}</b> · {item.count} kayıt</span>
              <i><em style={`width: ${item.ratio}%`}></em></i>
              <strong>{item.ratio}%</strong>
            </div>
          ))}
        </section>
      </div>

      <div class="grid">
        <section class="panel">
          <h2>En yoğun iller</h2>
          {provinceCounts.map((item, index) => (
            <div class="row"><span>{index + 1}. {item.province}</span><b>{item.count}</b></div>
          ))}
        </section>
        <section class="panel">
          <h2>Son güncellenenler</h2>
          {latest.map((m) => (
            <a class="latest" href={`/meralar/${m.slug}/`}>
              <span><b>{m.name}</b><small>{m.province} · {m.district} · Güven {m.confidence}</small></span>
              <time>{m.updatedAt}</time>
            </a>
          ))}
        </section>
      </div>

      <section class="panel table-panel">
        <div class="heading"><h2>İyileştirme kuyruğu</h2><span>İlk 24 kayıt</span></div>
        <div class="scroll">
          <table>
            <thead><tr><th>Avlak</th><th>İl / İlçe</th><th>Güven</th><th>Eksikler</th><th></th></tr></thead>
            <tbody>
              {queue.map(({ m, issues: rowIssues }) => (
                <tr>
                  <td><b>{m.name}</b><small>{m.slug}</small></td>
                  <td>{m.province} / {m.district}</td>
                  <td><span class={`badge b-${m.confidence.toLowerCase()}`}>{m.confidence}</span></td>
                  <td><div class="tags">{rowIssues.map((issue) => <span>{issue}</span>)}</div></td>
                  <td><a href={`/meralar/${m.slug}/`}>Aç</a></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </section>

  <style>
    .dash{background:#f3f7f7;min-height:70vh;padding:42px 0 72px}.wrap{display:grid;gap:22px}.hero{display:flex;justify-content:space-between;gap:28px;background:linear-gradient(135deg,#0a3340,#0b5967);color:#fff;padding:32px;border-radius:24px}.hero h1{font-size:clamp(2rem,5vw,3.3rem);line-height:1;margin:.2rem 0 .7rem}.hero p{max-width:760px;color:#d8ecef;margin:0}.eyebrow{text-transform:uppercase;letter-spacing:.12em;font-weight:800;font-size:.75rem;color:#8edbe4}.score{min-width:190px;border:1px solid #ffffff38;background:#ffffff12;border-radius:18px;padding:18px;display:flex;flex-direction:column;justify-content:center}.score strong{font-size:4rem;line-height:1}.score span,.score small{color:#d8ecef}.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.cards article,.panel{background:#fff;border:1px solid #dce8e8;border-radius:18px;box-shadow:0 10px 24px #1439410f}.cards article{padding:20px}.cards span{color:#637a7e}.cards strong{display:block;font-size:2.25rem;color:#0a3340;margin-top:4px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:22px}.panel{padding:22px}.panel h2{margin:0 0 14px;color:#143d46}.row{display:flex;justify-content:space-between;border-bottom:1px solid #edf2f2;padding:11px 0}.row:last-child{border-bottom:0}.row b{color:#a44923}.confidence{display:grid;grid-template-columns:135px 1fr 45px;gap:12px;align-items:center;padding:9px 0}.confidence i{height:10px;background:#edf2f2;border-radius:999px;overflow:hidden}.confidence em{display:block;height:100%;background:#198096}.latest{display:flex;justify-content:space-between;gap:12px;text-decoration:none;color:#163d46;border-bottom:1px solid #edf2f2;padding:9px 0}.latest span,.latest small{display:block}.latest small,.latest time{color:#718387;font-size:.8rem}.table-panel{padding:0;overflow:hidden}.heading{display:flex;justify-content:space-between;align-items:center;padding:22px 22px 8px}.heading span{background:#e9f5f6;color:#176774;padding:6px 10px;border-radius:999px;font-weight:800;font-size:.8rem}.scroll{overflow:auto}table{width:100%;border-collapse:collapse;min-width:760px}th,td{text-align:left;padding:13px 16px;border-top:1px solid #edf2f2}th{background:#f8fbfb;color:#6b7f82;font-size:.77rem;text-transform:uppercase}td small{display:block;color:#7a8c8f}.badge,.tags span{display:inline-flex;border-radius:999px;padding:5px 9px;font-weight:800;font-size:.74rem}.b-a,.b-b{background:#e3f5e9;color:#236d3a}.b-c{background:#fff2cf;color:#8a6300}.b-d{background:#fde7df;color:#9b3c20}.tags{display:flex;flex-wrap:wrap;gap:5px}.tags span{background:#eef4f4;color:#4d666a}td>a{font-weight:800;color:#126b7a}@media(max-width:900px){.hero{flex-direction:column}.score{min-width:0}.cards{grid-template-columns:repeat(2,1fr)}.grid{grid-template-columns:1fr}}@media(max-width:560px){.cards{grid-template-columns:1fr}.hero{padding:23px}.panel{padding:17px}}
  </style>
</BaseLayout>
