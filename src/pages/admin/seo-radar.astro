---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="SEO Fırsat Radarı" description="Search Console verilerinden hızlı kazanım ve CTR fırsatlarını çıkaran yönetim ekranı." noindex={true}>
  <section class="radar">
    <div class="container wrap">
      <header class="hero">
        <div>
          <p class="eyebrow">Olta Atlası · SEO Fırsat Radarı</p>
          <h1>Google sinyallerini iş listesine çevir</h1>
          <p>Search Console verisini kullanarak hangi sorgu ve sayfalara önce müdahale edilmesi gerektiğini otomatik sıralar.</p>
        </div>
        <a class="back" href="/admin/dashboard/">Dashboard’a dön</a>
      </header>

      <section class="panel">
        <div class="panel-head">
          <div><h2>Arama fırsatları</h2><p id="radar-status">Veriler yükleniyor…</p></div>
          <div class="actions"><label for="radar-period">Dönem</label><select id="radar-period"><option value="7">Son 7 gün</option><option value="28" selected>Son 28 gün</option><option value="90">Son 90 gün</option></select><button id="radar-refresh" type="button">Yenile</button></div>
        </div>
        <div id="radar-error" class="notice error" hidden></div>
        <div class="summary" aria-live="polite">
          <article><span>Hızlı kazanım</span><strong id="quick-count">—</strong><small>4–15. sıra</small></article>
          <article><span>CTR fırsatı</span><strong id="ctr-count">—</strong><small>gösterim var, tıklama zayıf</small></article>
          <article><span>İlk sayfa adayı</span><strong id="page-count">—</strong><small>sayfa bazında</small></article>
        </div>
      </section>

      <div class="grid">
        <section class="panel"><div class="heading"><div><p class="eyebrow dark">Öncelik 1</p><h2>Hızlı kazanım sorguları</h2></div><span>4–15. sıra</span></div><p class="intro">Google’ın zaten ilk sayfa çevresinde denediği sorgular. Başlık, giriş metni ve iç bağlantı iyileştirmeleri için ilk adaylar.</p><div id="quick-wins" class="list"><p class="muted">Yükleniyor…</p></div></section>
        <section class="panel"><div class="heading"><div><p class="eyebrow dark">Öncelik 2</p><h2>CTR fırsatları</h2></div><span>yüksek gösterim</span></div><p class="intro">Google gösteriyor fakat tıklama oranı zayıf. Title, meta açıklaması ve arama niyeti uyumu kontrol edilmeli.</p><div id="ctr-opportunities" class="list"><p class="muted">Yükleniyor…</p></div></section>
      </div>

      <section class="panel"><div class="heading"><div><p class="eyebrow dark">Öncelik 3</p><h2>Güçlenen sayfalar</h2></div><span>ilk 15 sıra</span></div><p class="intro">Gösterim alan ve ilk 15 sıra içinde bulunan sayfalar. İçerik genişletme ve ilgili rota/rehber bağlantıları için adaydır.</p><div id="rising-pages" class="list wide"><p class="muted">Yükleniyor…</p></div></section>
    </div>
  </section>

  <script is:inline>
    const nf=new Intl.NumberFormat("tr-TR",{maximumFractionDigits:0});
    const df=new Intl.NumberFormat("tr-TR",{minimumFractionDigits:1,maximumFractionDigits:1});
    const period=document.querySelector("#radar-period");
    const refresh=document.querySelector("#radar-refresh");
    const status=document.querySelector("#radar-status");
    const errorBox=document.querySelector("#radar-error");
    const shortPage=(value)=>{try{return new URL(value).pathname||"/";}catch{return value||"/";}};
    const setText=(selector,value)=>{const node=document.querySelector(selector);if(node)node.textContent=value;};
    const scoreQuery=(row)=>Number(row.impressions||0)*Math.max(1,16-Number(row.position||99));
    const scorePage=(row)=>Number(row.impressions||0)*Math.max(1,16-Number(row.position||99));
    const empty=(container,text)=>{container.replaceChildren();const p=document.createElement("p");p.className="muted";p.textContent=text;container.appendChild(p);};
    const render=(selector,rows,type)=>{
      const container=document.querySelector(selector);if(!container)return;container.replaceChildren();
      if(!rows.length){empty(container,"Bu dönem için eşleşen fırsat bulunamadı.");return;}
      rows.forEach((row,index)=>{
        const item=document.createElement("article");item.className="item";
        const rank=document.createElement("span");rank.className="rank";rank.textContent=String(index+1);
        const body=document.createElement("div");
        const title=document.createElement("strong");title.textContent=type==="query"?(row.query||"Tanımsız sorgu"):shortPage(row.page);
        const meta=document.createElement("small");meta.textContent=`${nf.format(row.impressions||0)} gösterim · ${nf.format(row.clicks||0)} tıklama · %${df.format(Number(row.ctr||0)*100)} CTR · ${df.format(row.position||0)} sıra`;
        body.append(title,meta);
        const action=document.createElement("span");action.className="action";
        if(type==="query") action.textContent=Number(row.position)<=10?"Başlık + snippet":"İç bağlantı + içerik";
        else action.textContent=Number(row.ctr||0)<0.03?"CTR iyileştir":"İçeriği güçlendir";
        item.append(rank,body,action);container.appendChild(item);
      });
    };
    const load=async()=>{
      const days=period?.value||"28";if(refresh)refresh.disabled=true;if(status)status.textContent="Search Console verileri analiz ediliyor…";if(errorBox){errorBox.hidden=true;errorBox.textContent="";}
      try{
        const response=await fetch(`/admin/api/search-console?days=${encodeURIComponent(days)}`,{credentials:"same-origin",headers:{Accept:"application/json"}});
        const payload=await response.json();if(!response.ok||!payload.connected)throw new Error(payload.error||"Search Console bağlantısı kurulamadı.");
        const queries=(payload.queries||[]).map((row)=>({...row,position:Number(row.position||0),impressions:Number(row.impressions||0),clicks:Number(row.clicks||0),ctr:Number(row.ctr||0)}));
        const pages=(payload.pages||[]).map((row)=>({...row,position:Number(row.position||0),impressions:Number(row.impressions||0),clicks:Number(row.clicks||0),ctr:Number(row.ctr||0)}));
        const quick=queries.filter((row)=>row.impressions>=2&&row.position>=4&&row.position<=15).sort((a,b)=>scoreQuery(b)-scoreQuery(a)).slice(0,15);
        const ctr=pages.filter((row)=>row.impressions>=3&&row.position<=15&&row.ctr<0.05).sort((a,b)=>b.impressions-a.impressions||a.ctr-b.ctr).slice(0,15);
        const rising=pages.filter((row)=>row.impressions>=2&&row.position<=15).sort((a,b)=>scorePage(b)-scorePage(a)).slice(0,20);
        setText("#quick-count",nf.format(quick.length));setText("#ctr-count",nf.format(ctr.length));setText("#page-count",nf.format(rising.length));
        render("#quick-wins",quick,"query");render("#ctr-opportunities",ctr,"page");render("#rising-pages",rising,"page");
        if(status)status.textContent=`${payload.range.startDate} – ${payload.range.endDate} · ${payload.siteUrl}`;
      }catch(error){["#quick-count","#ctr-count","#page-count"].forEach((selector)=>setText(selector,"—"));["#quick-wins","#ctr-opportunities","#rising-pages"].forEach((selector)=>{const node=document.querySelector(selector);if(node)empty(node,"Veri yüklenemedi.");});if(status)status.textContent="Search Console bağlantısı bekleniyor.";if(errorBox){errorBox.hidden=false;errorBox.textContent=error instanceof Error?error.message:"Bilinmeyen hata.";}}
      finally{if(refresh)refresh.disabled=false;}
    };
    period?.addEventListener("change",load);refresh?.addEventListener("click",load);load();
  </script>

  <style>
    .radar{background:#f3f7f7;min-height:75vh;padding:42px 0 72px}.wrap{display:grid;gap:22px}.hero{display:flex;justify-content:space-between;gap:24px;align-items:flex-start;background:linear-gradient(135deg,#0a3340,#0b5967);color:#fff;padding:30px;border-radius:24px}.hero h1{font-size:clamp(2rem,5vw,3.2rem);line-height:1.02;margin:.2rem 0 .7rem}.hero p{max-width:760px;color:#d8ecef;margin:0}.eyebrow{text-transform:uppercase;letter-spacing:.12em;font-weight:800;font-size:.75rem;color:#8edbe4}.eyebrow.dark{color:#287685;margin:0 0 5px}.back{background:#fff;color:#0b5967;padding:11px 14px;border-radius:12px;text-decoration:none;font-weight:800;white-space:nowrap}.panel{background:#fff;border:1px solid #dce8e8;border-radius:18px;box-shadow:0 10px 24px #1439410f;padding:22px}.panel-head,.heading{display:flex;justify-content:space-between;gap:18px;align-items:flex-start}.panel h2{margin:0;color:#143d46}.panel-head p,.intro{color:#6c8084}.actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.actions label{font-size:.82rem;font-weight:800;color:#526a6e}.actions select,.actions button{border:1px solid #cadada;border-radius:10px;background:#fff;padding:9px 11px;font:inherit}.actions button{background:#0b5967;color:#fff;border-color:#0b5967;font-weight:800;cursor:pointer}.actions button:disabled{opacity:.55}.summary{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:18px}.summary article{border:1px solid #e1ecec;border-radius:14px;padding:18px}.summary span,.summary small{color:#718589}.summary strong{display:block;font-size:2.2rem;color:#0a3340}.grid{display:grid;grid-template-columns:1fr 1fr;gap:22px}.heading>span{background:#e9f5f6;color:#176774;padding:6px 10px;border-radius:999px;font-weight:800;font-size:.8rem}.list{display:grid}.item{display:grid;grid-template-columns:34px 1fr auto;gap:12px;align-items:center;padding:13px 0;border-top:1px solid #edf2f2}.rank{width:30px;height:30px;border-radius:50%;display:grid;place-items:center;background:#edf6f7;color:#176774;font-weight:900}.item strong,.item small{display:block;overflow-wrap:anywhere}.item small{color:#74888b;margin-top:4px}.action{font-size:.76rem;font-weight:800;color:#7b5a00;background:#fff5d8;border-radius:999px;padding:6px 9px;white-space:nowrap}.notice{padding:12px 14px;border-radius:12px;margin-top:14px}.notice.error{background:#fff0ea;color:#8b351d;border:1px solid #f0c8ba}.muted{color:#7a8b8e}@media(max-width:900px){.hero,.panel-head,.heading{flex-direction:column}.grid{grid-template-columns:1fr}.summary{grid-template-columns:1fr}.item{grid-template-columns:34px 1fr}.action{grid-column:2;justify-self:start}}@media(max-width:560px){.hero,.panel{padding:18px}}
  </style>
</BaseLayout>
