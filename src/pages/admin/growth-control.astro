---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { meralar, provinces, contentQualityStats } from "../../data/meralar-tumu";

const coverage = { indexed: 59, excluded: 693, date: "2026-08-07" };
const coverageTotal = coverage.indexed + coverage.excluded;
const coverageRatio = coverageTotal > 0 ? Math.round((coverage.indexed / coverageTotal) * 1000) / 10 : 0;
const qualityScore = contentQualityStats.score;
const routeCount = meralar.length;
const provinceCount = provinces.length;
---

<BaseLayout title="Büyüme Kontrolü" description="Olta Atlası büyüme, indeksleme ve trafik karar merkezi." noindex={true}>
  <section class="growth-control">
    <div class="container wrap">
      <header class="hero">
        <div>
          <p class="eyebrow">Olta Atlası · Yönetim</p>
          <h1>Büyüme Kontrolü</h1>
          <p>İçerik kalitesi, indeksleme ve büyüme sinyallerini tek ekranda izlemek için güvenli kontrol noktası.</p>
        </div>
        <nav class="hero-actions" aria-label="Yönetim bağlantıları">
          <a href="/admin/dashboard/">Dashboard</a>
          <a href="/admin/seo-radar/">SEO Fırsat Radarı</a>
          <a href="/admin/traffic-diagnostics/">Trafik Teşhisi</a>
        </nav>
      </header>

      <section class="panel" aria-labelledby="snapshot-title">
        <div class="panel-head">
          <div><p class="eyebrow dark">Durum özeti</p><h2 id="snapshot-title">Büyüme için çekirdek göstergeler</h2></div>
          <span class="snapshot-date">İndeks snapshotu: {coverage.date}</span>
        </div>
        <div class="metrics">
          <article><span>İçerik kalite puanı</span><strong>{qualityScore}/100</strong><small>Yapısal kalite kapısı</small></article>
          <article><span>Toplam avlak</span><strong>{routeCount}</strong><small>{provinceCount} il kapsanıyor</small></article>
          <article><span>İndeksli URL</span><strong>{coverage.indexed}</strong><small>%{coverageRatio} snapshot oranı</small></article>
          <article><span>İndeks dışı URL</span><strong>{coverage.excluded}</strong><small>Search Console verisiyle izlenmeli</small></article>
        </div>
      </section>

      <div class="decision-grid">
        <section class="panel decision do-now"><p class="eyebrow dark">Şimdi yap</p><h2>Keşfedilebilirliği büyüt</h2><p>Yeni avlak sayfalarını kalite kapısından geçir, güçlü il ve mera sayfaları arasında iç bağlantıları artır ve gerçek arama sorgularına göre içerik boşluklarını kapat.</p><a href="/admin/seo-radar/">SEO fırsatlarını aç →</a></section>
        <section class="panel decision measure"><p class="eyebrow dark">Ölç ve doğrula</p><h2>İnsan trafiğini botlardan ayır</h2><p>GA4 gerçek kullanıcı davranışını, Cloudflare ise altyapı isteklerini gösterir. Ham istek artışını ziyaretçi artışı kabul etmeden iki veri setini birlikte oku.</p><a href="/admin/traffic-diagnostics/">Trafik teşhisini aç →</a></section>
        <section class="panel decision keep"><p class="eyebrow dark">Şimdilik dokunma</p><h2>Core Web Vitals mikro optimizasyonu</h2><p>Mevcut saha ölçümleri iyi seviyedeyken büyüme zamanını küçük performans kazançlarına harcama. Öncelik indeksleme, arama görünürlüğü ve nitelikli içerik.</p><a href="/admin/dashboard/">Ana metriklere dön →</a></section>
      </div>

      <section class="panel note"><p><strong>Not:</strong> İndeks sayıları burada {coverage.date} tarihli sabit snapshot olarak tutulur. Güncel karar verirken Dashboard ve Search Console canlı verileri esas alınmalıdır.</p></section>
    </div>
  </section>
</BaseLayout>

<style>
  .growth-control{background:#f4f8f8;min-height:70vh;padding:34px 0 64px}.wrap{display:grid;gap:20px}.hero{display:flex;justify-content:space-between;gap:24px;align-items:flex-end;padding:28px;border-radius:20px;background:#0a3340;color:#fff}.hero h1{margin:4px 0 8px;font-size:clamp(2rem,5vw,3.5rem)}.hero p{margin:0;max-width:760px;color:#d9ebee}.eyebrow{margin:0;text-transform:uppercase;letter-spacing:.08em;font-size:.78rem;font-weight:800}.eyebrow.dark{color:#42656c}.hero-actions{display:flex;flex-wrap:wrap;gap:8px;justify-content:flex-end}.hero-actions a{color:#fff;text-decoration:none;border:1px solid #69919a;border-radius:10px;padding:9px 12px;font-weight:800;white-space:nowrap}.panel{background:#fff;border:1px solid #d9e5e7;border-radius:18px;padding:22px;box-shadow:0 10px 28px rgba(10,51,64,.05)}.panel-head{display:flex;align-items:end;justify-content:space-between;gap:16px;margin-bottom:18px}.panel h2{margin:4px 0 0;color:#153e47}.snapshot-date{color:#60777c;font-size:.9rem}.metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.metrics article{background:#f7fafb;border:1px solid #e1eaec;border-radius:14px;padding:18px;display:grid;gap:5px}.metrics span,.metrics small{color:#60777c}.metrics strong{color:#0a3340;font-size:2rem}.decision-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.decision p{color:#4e686e;line-height:1.65}.decision a{display:inline-flex;margin-top:8px;color:#0b5967;font-weight:900;text-decoration:none}.do-now{border-top:4px solid #27765e}.measure{border-top:4px solid #aa7a2f}.keep{border-top:4px solid #58748d}.note p{margin:0;color:#4e686e}@media(max-width:900px){.hero{align-items:flex-start;flex-direction:column}.hero-actions{justify-content:flex-start}.metrics,.decision-grid{grid-template-columns:1fr 1fr}}@media(max-width:620px){.growth-control{padding-top:20px}.hero,.panel{padding:18px;border-radius:14px}.metrics,.decision-grid{grid-template-columns:1fr}.panel-head{align-items:flex-start;flex-direction:column}}
</style>
