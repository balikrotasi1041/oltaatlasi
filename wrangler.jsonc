{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "oltaatlasi",
  "main": "./worker/security-gate.js",
  "compatibility_date": "2026-07-23",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "ratelimits": [
    {
      "name": "WEATHER_RATE_LIMITER",
      "namespace_id": "2026082401",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "SUSPICIOUS_RATE_LIMITER",
      "namespace_id": "2026082402",
      "simple": {
        "limit": 15,
        "period": 60
      }
    }
  ],
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
