{
  "name": "olta-atlasi",
  "version": "6.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "validate:data": "node scripts/validate-route-data.mjs",
    "geocode:national": "node scripts/geocode-national-routes.mjs",
    "research:national": "node scripts/enrich-national-routes.mjs",
    "build": "npm run validate:data && npm run generate:robots && astro check && astro build && npm run generate:image-sitemap",
    "preview": "astro preview",
    "check": "astro check",
    "generate:robots": "node scripts/generate-robots.mjs",
    "generate:image-sitemap": "node scripts/generate-image-sitemap.mjs",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.1",
    "typescript": "^5.7.2"
  },
  "description": "Olta Atlası: avlak haritası, balık türleri, görselli yöntem rehberleri ve kaynaklı dünya balıkçılık günlüğü.",
  "devDependencies": {
    "wrangler": "^4.112.0"
  },
  "engines": {
    "node": ">=22.16.0",
    "npm": ">=10.9.2"
  }
}
